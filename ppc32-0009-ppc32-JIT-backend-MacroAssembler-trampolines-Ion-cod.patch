+void MacroAssembler::mul64(Imm64 imm, const Register64& dest) {
+  // high = high * lo(imm) + low * hi(imm) + mulhwu(low, lo(imm))
+  // low  = low * lo(imm)
+  UseScratchRegisterScope temps(*this);
+  Register klo = temps.Acquire();
+  Register t = temps.Acquire();
+  int32_t lo = imm.low().value;
+  int32_t hi = imm.hi().value;
+  PPC32LoadImm(*this, klo, lo);
+  as_mullw(dest.high, dest.high, klo);
+  as_mulhwu(t, dest.low, klo);
+  as_add(dest.high, dest.high, t);
+  if (hi != 0) {
+    if (PPC32IsInt16(hi)) {
+      as_mulli(t, dest.low, int16_t(hi));
+    } else {
+      PPC32LoadImm(*this, t, hi);
+      as_mullw(t, dest.low, t);
+    }
+    as_add(dest.high, dest.high, t);
+  }
+  as_mullw(dest.low, dest.low, klo);
+}
+
+void MacroAssembler::mul64(Imm64 imm, const Register64& dest,
+                           const Register temp) {
+  MOZ_ASSERT(temp != dest.high && temp != dest.low);
+  mul64(imm, dest);
+}
+
+void MacroAssembler::mul64(const Register64& src, const Register64& dest,
+                           const Register temp) {
+  MOZ_ASSERT(dest.low != src.high && dest.high != src.low);
+  UseScratchRegisterScope temps(*this);
+  Register t = temps.Acquire();
+  // high = high * src.low + low * src.high + mulhwu(low, src.low)
+  as_mullw(t, dest.high, src.low);
+  as_mullw(r0, dest.low, src.high);
+  as_add(t, t, r0);
+  as_mulhwu(r0, dest.low, src.low);
+  as_add(dest.high, t, r0);
+  as_mullw(dest.low, dest.low, src.low);
+}
