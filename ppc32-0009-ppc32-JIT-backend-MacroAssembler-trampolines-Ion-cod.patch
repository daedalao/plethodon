+// Conditional moves: branch over the move when the condition fails.
+
+void MacroAssembler::cmp32Move32(Condition cond, Register lhs, Imm32 rhs,
+                                 Register src, Register dest) {
+  Condition c = PPC32Cmp(*this, cond, lhs, rhs);
+  if (src != dest) {
+    PPC32SkipIf skip(*this, PPC32Invert(c), 1);
+    xs_mr(dest, src);
+  }
+}
