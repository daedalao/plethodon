+void MacroAssembler::and32(Imm32 imm, Register src, Register dest) {
+  uint32_t m = uint32_t(imm.value);
+  uint32_t mb, me;
+  if (m == 0xffffffffu) {
+    movePtr(src, dest);
+  } else if (PPC32IsUint16(int32_t(m))) {
+    as_andi_rc(dest, src, uint16_t(m));
+  } else if ((m & 0xffff) == 0) {
+    as_andis_rc(dest, src, uint16_t(m >> 16));
+  } else if (PPC32ContigMask(m, &mb, &me)) {
+    as_rlwinm(dest, src, 0, mb, me);
+  } else {
+    PPC32LoadImm(*this, r0, int32_t(m));
+    as_and_(dest, src, r0);
+  }
+}
