+// ===============================================================
+// Swap instructions
+
+void MacroAssembler::byteSwap16SignExtend(Register reg) {
+  // r0 = (reg << 8) & 0xff00; reg = ((reg >> 8) & 0xff) | r0.
+  as_rlwinm(r0, reg, 8, 16, 23);
+  as_rlwinm(reg, reg, 24, 24, 31);
+  as_or_(reg, reg, r0);
+  as_extsh(reg, reg);
+}
+
+void MacroAssembler::byteSwap16ZeroExtend(Register reg) {
+  as_rlwinm(r0, reg, 8, 16, 23);
+  as_rlwinm(reg, reg, 24, 24, 31);
+  as_or_(reg, reg, r0);
+}
+
+void MacroAssembler::byteSwap32(Register reg) {
+  // ABCD -> rotl 8 = BCDA, insert D at byte 0 and B at byte 2 -> DCBA.
+  as_rlwinm(r0, reg, 8, 0, 31);
+  as_rlwimi(r0, reg, 24, 0, 7);
+  as_rlwimi(r0, reg, 24, 16, 23);
+  xs_mr(reg, r0);
+}
+
+void MacroAssembler::byteSwap64(Register64 reg) {
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  // s = bswap32(high); r0 = bswap32(low); then exchange the halves.
+  as_rlwinm(s, reg.high, 8, 0, 31);
+  as_rlwimi(s, reg.high, 24, 0, 7);
+  as_rlwimi(s, reg.high, 24, 16, 23);
+  as_rlwinm(r0, reg.low, 8, 0, 31);
+  as_rlwimi(r0, reg.low, 24, 0, 7);
+  as_rlwimi(r0, reg.low, 24, 16, 23);
+  xs_mr(reg.high, r0);
+  xs_mr(reg.low, s);
+}
