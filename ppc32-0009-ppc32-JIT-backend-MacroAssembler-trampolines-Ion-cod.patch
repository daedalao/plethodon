+
+void MacroAssembler::clampDoubleToUint8(FloatRegister input, Register output) {
+  MOZ_ASSERT(input.encoding() != ScratchDoubleReg.encoding());
+  Label positive, below255, done;
+
+  // NaN and values <= 0 clamp to 0.
+  loadConstantDouble(0.0, ScratchDoubleReg);
+  as_fcmpu(input, ScratchDoubleReg);
+  ma_b(DoubleGreaterThan, &positive);
+  move32(Imm32(0), output);
+  jump(&done);
+
+  bind(&positive);
+  loadConstantDouble(255.0, ScratchDoubleReg);
+  as_fcmpu(input, ScratchDoubleReg);
+  ma_b(DoubleLessThan, &below255);
+  move32(Imm32(255), output);
+  jump(&done);
+
+  // fctiw with the default rounding mode: round-half-to-even, as required.
+  bind(&below255);
+  roundDoubleToInt32Raw(input, output);
+
+  bind(&done);
+}
