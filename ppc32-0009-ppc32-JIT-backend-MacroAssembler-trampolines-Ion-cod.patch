+void CodeGenerator::visitMathD(LMathD* math) {
+  FloatRegister src1 = ToFloatRegister(math->lhs());
+  FloatRegister src2 = ToFloatRegister(math->rhs());
+  FloatRegister output = ToFloatRegister(math->output());
+
+  switch (math->jsop()) {
+    case JSOp::Add:
+      masm.as_fadd(output, src1, src2);
+      break;
+    case JSOp::Sub:
+      masm.as_fsub(output, src1, src2);
+      break;
+    case JSOp::Mul:
+      masm.as_fmul(output, src1, src2);
+      break;
+    case JSOp::Div:
+      masm.as_fdiv(output, src1, src2);
+      break;
+    default:
+      MOZ_CRASH("unexpected opcode");
+  }
+}
