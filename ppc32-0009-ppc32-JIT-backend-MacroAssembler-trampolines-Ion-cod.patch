+// ===============================================================
+// Local emission helpers (plain 32-bit PowerPC, see PPC32-JIT.md).
+
+// Branch to |label| if |cond| holds in CR0.
+static void PpcBranchCR0(MacroAssembler& masm, Assembler::Condition cond,
+                         Label* label) {
+  masm.condBranchToLabel(cond, label, cr0);
+}
+
+static void PpcBranchCR0(MacroAssembler& masm, Assembler::DoubleCondition cond,
+                         Label* label) {
+  masm.condBranchToLabel(cond, label, cr0);
+}
+
+static bool PpcIsInt16(int32_t imm) {
+  return imm >= INT16_MIN && imm <= INT16_MAX;
+}
+
+// dest = imm (li, or lis[+ori]).
+static void PpcLoadImm32(MacroAssembler& masm, Register dest, int32_t imm) {
+  if (PpcIsInt16(imm)) {
+    masm.xs_li(dest, int16_t(imm));
+    return;
+  }
+  masm.xs_lis(dest, int16_t(uint32_t(imm) >> 16));
+  if (uint32_t(imm) & 0xffff) {
+    masm.as_ori(dest, dest, uint16_t(uint32_t(imm) & 0xffff));
+  }
+}
+
+// dest = src + imm, wrapping. |src| is never r0 (not allocatable).
+static void PpcAddImm32(MacroAssembler& masm, Register dest, Register src,
+                        int32_t imm) {
+  MOZ_ASSERT(src != r0 && dest != r0);
+  if (PpcIsInt16(imm)) {
+    if (imm != 0 || dest != src) {
+      masm.as_addi(dest, src, int16_t(imm));
+    }
+    return;
+  }
+  // addis with the high half adjusted for the sign of the low half.
+  uint32_t u = uint32_t(imm);
+  int16_t lo = int16_t(u & 0xffff);
+  int16_t ha = int16_t((u - uint32_t(int32_t(lo))) >> 16);
+  masm.as_addis(dest, src, ha);
+  if (lo != 0) {
+    masm.as_addi(dest, dest, lo);
+  }
+}
+
+// Branch to |label| if the preceding addo/subfo/mullwo/nego overflowed.
+// mcrxr copies XER[SO,OV,CA] to CR0[LT,GT,EQ] and clears them, so OV is GT.
+static void PpcBranchOnOverflow(MacroAssembler& masm, Label* label) {
+  masm.as_mcrxr(cr0);
+  PpcBranchCR0(masm, Assembler::GreaterThan, label);
+}
+
+static void PpcMoveReg(MacroAssembler& masm, Register src, Register dest) {
+  if (src != dest) {
+    masm.xs_mr(dest, src);
+  }
+}
