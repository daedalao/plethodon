+// output = |lhs| with the sign of rhs (no fcpsgn: read rhs's sign word).
+void MacroAssembler::copySignDouble(FloatRegister lhs, FloatRegister rhs,
+                                    FloatRegister output) {
+  moveDoubleHighWordToGPR(rhs, r0);
+  as_cmpwi(r0, 0);
+  as_fabs(output, lhs);
+  as_bc(int16_t(2 * sizeof(uint32_t)), GreaterThanOrEqual);
+  as_fneg(output, output);
+}
+
+void MacroAssembler::copySignFloat32(FloatRegister lhs, FloatRegister rhs,
+                                     FloatRegister output) {
+  // Singles are held in double format; the sign bit is the same bit.
+  copySignDouble(lhs.asDouble(), rhs.asDouble(), output.asDouble());
+}
