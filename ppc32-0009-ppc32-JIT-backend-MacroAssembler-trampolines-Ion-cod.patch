+// ========================================================================
+// Primitive atomic operations (lwarx/stwcx.).
+//
+// 8/16-bit operations work on the containing aligned word: r12 holds the
+// word address, r11 the lane's left shift (big-endian: byte k of the word is
+// bits 24-8k..31-8k counted from the LSB, i.e. shift = (3-k)*8), r0 the
+// loaded word. The loops need two more registers than the API provides;
+// they are borrowed from the allocatable set and saved on the stack around
+// the operation.
+
+static void ComputeAtomicAddress(MacroAssembler& masm, const Address& mem,
+                                 Register dest) {
+  masm.computeEffectiveAddress(mem, dest);
+}
+
+static void ComputeAtomicAddress(MacroAssembler& masm, const BaseIndex& mem,
+                                 Register dest) {
+  masm.computeEffectiveAddress(mem, dest);
+}
+
+// Registers borrowed (and saved/restored) for the sub-word loops.
+class BorrowedRegs {
+  MacroAssembler& masm_;
+  Register regs_[2];
+  size_t count_;
+
+ public:
+  BorrowedRegs(MacroAssembler& masm, size_t count,
+               std::initializer_list<Register> avoid)
+      : masm_(masm), count_(count) {
+    MOZ_ASSERT(count <= 2);
+    static const Register candidates[] = {r3,  r4,  r5,  r6,  r7,  r8,
+                                          r9,  r10, r14, r15, r17, r18,
+                                          r19, r20, r21, r22, r23, r24,
+                                          r25, r26, r27, r28, r29, r30};
+    size_t n = 0;
+    for (Register c : candidates) {
+      if (n == count) {
+        break;
+      }
+      bool used = false;
+      for (Register a : avoid) {
+        if (a == c) {
+          used = true;
+        }
+      }
+      if (!used) {
+        regs_[n++] = c;
+      }
+    }
+    MOZ_RELEASE_ASSERT(n == count);
+    // Keep sp 16-byte aligned; nothing below sp is ever relied upon.
+    masm_.as_stwu(regs_[0], StackPointer, -16);
+    if (count_ > 1) {
+      masm_.as_stw(regs_[1], StackPointer, 4);
+    }
+  }
+  ~BorrowedRegs() {
+    masm_.as_lwz(regs_[0], StackPointer, 0);
+    if (count_ > 1) {
+      masm_.as_lwz(regs_[1], StackPointer, 4);
+    }
+    masm_.as_addi(StackPointer, StackPointer, 16);
+  }
+  Register operator[](size_t i) const {
+    MOZ_ASSERT(i < count_);
+    return regs_[i];
+  }
+};
+
+// Given the byte address in |addr|, set |shift| to the lane shift and align
+// |addr| down to its word.
+static void SetupSubword(MacroAssembler& masm, unsigned nbytes, Register addr,
+                         Register shift) {
+  if (nbytes == 1) {
+    masm.as_rlwinm(shift, addr, 3, 27, 28);  // (addr & 3) * 8
+    masm.as_xori(shift, shift, 24);          // (3 - (addr & 3)) * 8
+  } else {
+    MOZ_ASSERT(nbytes == 2);
+    masm.as_rlwinm(shift, addr, 3, 27, 27);  // (addr & 2) * 8
+    masm.as_xori(shift, shift, 16);          // (2 - (addr & 2)) * 8
+  }
+  masm.as_rlwinm(addr, addr, 0, 0, 29);
+}
+
+// mask = lane-width ones << shift.
+static void SetupSubwordMask(MacroAssembler& masm, unsigned nbytes,
+                             Register mask, Register shift) {
+  masm.xs_li(mask, 0);
+  masm.as_ori(mask, mask, nbytes == 1 ? 0xff : 0xffff);
+  masm.as_slw(mask, mask, shift);
+}
+
+// dest = extend(lane of |word| at |shift|).
+static void ExtractSubword(MacroAssembler& masm, unsigned nbytes, bool isSigned,
+                           Register word, Register shift, Register dest) {
+  masm.as_srw(dest, word, shift);
+  if (nbytes == 1) {
+    if (isSigned) {
+      masm.as_extsb(dest, dest);
+    } else {
+      masm.as_rlwinm(dest, dest, 0, 24, 31);
+    }
+  } else {
+    if (isSigned) {
+      masm.as_extsh(dest, dest);
+    } else {
+      masm.as_rlwinm(dest, dest, 0, 16, 31);
+    }
+  }
+}
+
+// t = word ^ ((t ^ word) & mask): insert the lane bits of t into word.
+static void MergeSubword(MacroAssembler& masm, Register t, Register word,
+                         Register mask) {
+  masm.as_xor_(t, t, word);
+  masm.as_and_(t, t, mask);
+  masm.as_xor_(t, t, word);
+}
+
+// Emit `stwcx. value, 0, addr; bne- again`.
+static void StoreConditional(MacroAssembler& masm, Register value,
+                             Register addr, Label* again) {
+  masm.as_stwcx(value, r0, addr);
+  masm.ma_b(Assembler::NotEqual, again);
+}
+
+static void EmitAtomicOp(MacroAssembler& masm, AtomicOp op, Register dest,
+                         Register old, Register value) {
+  switch (op) {
+    case AtomicOp::Add:
+      masm.as_add(dest, old, value);
+      break;
+    case AtomicOp::Sub:
+      masm.as_subf(dest, value, old);
+      break;
+    case AtomicOp::And:
+      masm.as_and_(dest, old, value);
+      break;
+    case AtomicOp::Or:
+      masm.as_or_(dest, old, value);
+      break;
+    case AtomicOp::Xor:
+      masm.as_xor_(dest, old, value);
+      break;
+    default:
+      MOZ_CRASH();
+  }
+}
+
+template <typename T>
+static void CompareExchange(MacroAssembler& masm, Scalar::Type type,
+                            Synchronization sync, const T& mem,
+                            Register oldval, Register newval, Register output) {
+  unsigned nbytes = Scalar::byteSize(type);
+  bool isSigned = Scalar::isSignedIntType(type);
+  MOZ_ASSERT(nbytes <= 4);
+
+  UseScratchRegisterScope temps(masm);
+  Register addr = temps.Acquire();
+  Register shift = temps.Acquire();
+  MOZ_ASSERT(addr == r11 || addr == r12);
+  ComputeAtomicAddress(masm, mem, addr);
+
+  Label again, end;
+
+  if (nbytes == 4) {
+    masm.memoryBarrierBefore(sync);
+    masm.bind(&again);
+    masm.as_lwarx(r0, r0, addr);
+    masm.as_cmpw(r0, oldval);
+    masm.ma_b(Assembler::NotEqual, &end);
+    StoreConditional(masm, newval, addr, &again);
+    masm.memoryBarrierAfter(sync);
+    masm.bind(&end);
+    masm.xs_mr(output, r0);
+    return;
+  }
+
+  SetupSubword(masm, nbytes, addr, shift);
+  {
+    BorrowedRegs borrowed(masm, 2, {oldval, newval, output});
+    Register mask = borrowed[0];
+    Register t = borrowed[1];
+    SetupSubwordMask(masm, nbytes, mask, shift);
+
+    masm.memoryBarrierBefore(sync);
+    masm.bind(&again);
+    masm.as_lwarx(r0, r0, addr);
+    // Compare the lane with oldval (only the lane-width bits matter).
+    masm.as_srw(t, r0, shift);
+    masm.as_xor_(t, t, oldval);
+    masm.as_rlwinm_rc(t, t, 0, nbytes == 1 ? 24 : 16, 31);
+    masm.ma_b(Assembler::NotEqual, &end);
+    masm.as_slw(t, newval, shift);
+    MergeSubword(masm, t, r0, mask);
+    StoreConditional(masm, t, addr, &again);
+    masm.memoryBarrierAfter(sync);
+    masm.bind(&end);
+    ExtractSubword(masm, nbytes, isSigned, r0, shift, output);
+  }
+}
+
+template <typename T>
+static void AtomicExchange(MacroAssembler& masm, Scalar::Type type,
+                           Synchronization sync, const T& mem, Register value,
+                           Register output) {
+  unsigned nbytes = Scalar::byteSize(type);
+  bool isSigned = Scalar::isSignedIntType(type);
+  MOZ_ASSERT(nbytes <= 4);
+
+  UseScratchRegisterScope temps(masm);
+  Register addr = temps.Acquire();
+  Register shift = temps.Acquire();
+  ComputeAtomicAddress(masm, mem, addr);
+
+  Label again;
+
+  if (nbytes == 4) {
+    masm.memoryBarrierBefore(sync);
+    masm.bind(&again);
+    masm.as_lwarx(r0, r0, addr);
+    StoreConditional(masm, value, addr, &again);
+    masm.memoryBarrierAfter(sync);
+    masm.xs_mr(output, r0);
+    return;
+  }
+
+  SetupSubword(masm, nbytes, addr, shift);
+  {
+    BorrowedRegs borrowed(masm, 2, {value, output});
+    Register mask = borrowed[0];
+    Register t = borrowed[1];
+    SetupSubwordMask(masm, nbytes, mask, shift);
+
+    masm.memoryBarrierBefore(sync);
+    masm.bind(&again);
+    masm.as_lwarx(r0, r0, addr);
+    masm.as_slw(t, value, shift);
+    MergeSubword(masm, t, r0, mask);
+    StoreConditional(masm, t, addr, &again);
+    masm.memoryBarrierAfter(sync);
+    ExtractSubword(masm, nbytes, isSigned, r0, shift, output);
+  }
+}
+
+// |output| may be InvalidReg (effect-only).
+template <typename T>
+static void AtomicFetchOp(MacroAssembler& masm, Scalar::Type type,
+                          Synchronization sync, AtomicOp op, const T& mem,
+                          Register value, Register temp, Register output) {
+  unsigned nbytes = Scalar::byteSize(type);
+  bool isSigned = Scalar::isSignedIntType(type);
+  MOZ_ASSERT(nbytes <= 4);
+  MOZ_ASSERT(temp != InvalidReg);
+
+  UseScratchRegisterScope temps(masm);
+  Register addr = temps.Acquire();
+  Register shift = temps.Acquire();
+  ComputeAtomicAddress(masm, mem, addr);
+
+  Label again;
+
+  if (nbytes == 4) {
+    masm.memoryBarrierBefore(sync);
+    masm.bind(&again);
+    masm.as_lwarx(r0, r0, addr);
+    EmitAtomicOp(masm, op, temp, r0, value);
+    StoreConditional(masm, temp, addr, &again);
+    masm.memoryBarrierAfter(sync);
+    if (output != InvalidReg) {
+      masm.xs_mr(output, r0);
+    }
+    return;
+  }
+
+  SetupSubword(masm, nbytes, addr, shift);
+  {
+    std::initializer_list<Register> avoid = {value, temp, output};
+    BorrowedRegs borrowed(masm, 1, avoid);
+    Register mask = borrowed[0];
+    SetupSubwordMask(masm, nbytes, mask, shift);
+
+    masm.memoryBarrierBefore(sync);
+    masm.bind(&again);
+    masm.as_lwarx(r0, r0, addr);
+    masm.as_srw(temp, r0, shift);
+    EmitAtomicOp(masm, op, temp, temp, value);
+    masm.as_slw(temp, temp, shift);
+    MergeSubword(masm, temp, r0, mask);
+    StoreConditional(masm, temp, addr, &again);
+    masm.memoryBarrierAfter(sync);
+    if (output != InvalidReg) {
+      ExtractSubword(masm, nbytes, isSigned, r0, shift, output);
+    }
+  }
+}
