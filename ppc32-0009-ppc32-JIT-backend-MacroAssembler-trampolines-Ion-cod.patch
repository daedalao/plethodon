+void MacroAssembler::cmp8Set(Condition cond, Address lhs, Imm32 rhs,
+                             Register dest) {
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  Imm32 imm = PPC32LoadNarrow(*this, cond, lhs, rhs, s, 1);
+  PPC32SetFromCR0(*this, PPC32CmpReg(*this, cond, s, imm), dest);
+}
