+// ===============================================================
+// Table switch.
+
+class js::jit::OutOfLineTableSwitch
+    : public OutOfLineCodeBase<CodeGeneratorPPC> {
+  MTableSwitch* mir_;
+  CodeLabel jumpLabel_;
+
+  void accept(CodeGeneratorPPC* codegen) override {
+    codegen->visitOutOfLineTableSwitch(this);
+  }
+
+ public:
+  explicit OutOfLineTableSwitch(MTableSwitch* mir) : mir_(mir) {}
+
+  MTableSwitch* mir() const { return mir_; }
+  CodeLabel* jumpLabel() { return &jumpLabel_; }
+};
+
+void CodeGeneratorPPC::visitOutOfLineTableSwitch(OutOfLineTableSwitch* ool) {
+  MTableSwitch* mir = ool->mir();
+
+  // The table: one absolute 32-bit code address per case (RawPointer
+  // CodeLabels, patched when the code is linked).
+  masm.haltingAlign(sizeof(void*));
+  masm.bind(ool->jumpLabel());
+  masm.addCodeLabel(*ool->jumpLabel());
+
+  for (size_t i = 0; i < mir->numCases(); i++) {
+    LBlock* caseblock = skipTrivialBlocks(mir->getCase(i))->lir();
+    Label* caseheader = caseblock->label();
+    uint32_t caseoffset = caseheader->offset();
+
+    CodeLabel cl;
+    BufferOffset entry = masm.writeInst(uint32_t(-1));
+    cl.patchAt()->bind(entry.getOffset());
+    cl.target()->bind(caseoffset);
+    masm.addCodeLabel(cl);
+  }
+}
+
+void CodeGeneratorPPC::emitTableSwitchDispatch(MTableSwitch* mir,
+                                               Register index, Register base) {
+  Label* defaultcase = skipTrivialBlocks(mir->getDefault())->lir()->label();
+
+  // Rebase the index; an unsigned compare catches both out-of-range ends.
+  if (mir->low() != 0) {
+    PpcAddImm32(masm, index, index, int32_t(-uint32_t(mir->low())));
+  }
+
+  int32_t cases = mir->numCases();
+  masm.branch32(Assembler::AboveOrEqual, index, Imm32(cases), defaultcase);
+
+  OutOfLineTableSwitch* ool = new (alloc()) OutOfLineTableSwitch(mir);
+  addOutOfLineCode(ool, mir);
+
+  // base = address of the table (lis/ori patched at link time).
+  BufferOffset load = masm.as_load32Patchable(base, 0);
+  ool->jumpLabel()->patchAt()->bind(load.getOffset());
+  ool->jumpLabel()->setLinkMode(CodeLabel::MoveImmediate);
+
+  // ctr = table[index]; bctr.
+  masm.x_slwi(index, index, 2);
+  masm.as_lwzx(base, base, index);
+  masm.xs_mtctr(base);
+  masm.as_bctr();
+}
+
+void CodeGeneratorPPC::generateInvalidateEpilogue() {
+  // Ensure that there is enough space in the buffer for the OsiPoint patching
+  // to occur. Otherwise, we could overwrite the invalidation epilogue.
+  for (size_t i = 0; i < Assembler::PatchWrite_NearCallSize();
+       i += Assembler::NopSize()) {
+    masm.nop();
+  }
+
+  masm.bind(&invalidate_);
+
+  // Push the return address of the point that we bailed out at onto the stack.
+  masm.pushReturnAddress();
+
+  // Push the Ion script onto the stack (when we determine what that pointer
+  // is).
+  invalidateEpilogueData_ = masm.pushWithPatch(ImmWord(uintptr_t(-1)));
+
+  // Jump to the invalidator which will replace the current frame.
+  TrampolinePtr thunk = gen->jitRuntime()->getInvalidationThunk();
+  masm.jump(thunk);
+}
