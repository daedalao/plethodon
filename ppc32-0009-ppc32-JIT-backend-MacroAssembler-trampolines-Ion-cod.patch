+void CodeGenerator::visitNegD(LNegD* ins) {
+  masm.as_fneg(ToFloatRegister(ins->output()), ToFloatRegister(ins->input()));
+}
+
+void CodeGenerator::visitNegF(LNegF* ins) {
+  masm.as_fneg(ToFloatRegister(ins->output()), ToFloatRegister(ins->input()));
+}
+
+void CodeGenerator::visitPowHalfD(LPowHalfD* ins) {
+  FloatRegister input = ToFloatRegister(ins->input());
+  FloatRegister output = ToFloatRegister(ins->output());
+
+  Label done, notNegInf;
+
+  {
+    ScratchDoubleScope scratch(masm);
+
+    // Math.pow(-Infinity, 0.5) == Infinity.
+    masm.loadConstantDouble(NegativeInfinity<double>(), scratch);
+    masm.as_fcmpu(cr0, input, scratch);
+    PpcBranchCR0(masm, Assembler::DoubleNotEqualOrUnordered, &notNegInf);
+    masm.as_fneg(output, scratch);
+    masm.jump(&done);
+
+    // Math.pow(-0, 0.5) == 0 == Math.pow(0, 0.5).
+    // Adding 0 converts any -0 to 0.
+    masm.bind(&notNegInf);
+    masm.loadConstantDouble(0.0, scratch);
+    masm.as_fadd(output, input, scratch);
+  }
+
+  // No fsqrt on the G4: sqrtDouble is provided by the MacroAssembler.
+  masm.sqrtDouble(output, output);
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitNotD(LNotD* ins) {
+  // dest = (input == 0.0 || isNaN(input)).
+  FloatRegister opd = ToFloatRegister(ins->input());
+  Register dest = ToRegister(ins->output());
+
+  Label done;
+  {
+    ScratchDoubleScope scratch(masm);
+    masm.loadConstantDouble(0.0, scratch);
+    masm.as_fcmpu(cr0, opd, scratch);
+  }
+  masm.xs_li(dest, 1);
+  PpcBranchCR0(masm, Assembler::DoubleEqualOrUnordered, &done);
+  masm.xs_li(dest, 0);
+  masm.bind(&done);
+}
