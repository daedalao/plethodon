+// ===============================================================
+// Simple call functions.
+//
+// Calls through CTR: `mtctr reg; bctrl`. The returned offset is the return
+// address (the instruction after the bctrl/bl).
+
+CodeOffset MacroAssembler::call(Register reg) {
+  xs_mtctr(reg);
+  as_bctr(LinkB);
+  return CodeOffset(currentOffset());
+}
+
+CodeOffset MacroAssembler::call(Label* label) {
+  branchToLabel(label, LinkB);
+  return CodeOffset(currentOffset());
+}
+
+CodeOffset MacroAssembler::call(const Address& addr) {
+  loadPtr(addr, CallReg);
+  return call(CallReg);
+}
+
+void MacroAssembler::call(ImmWord imm) { call(ImmPtr((void*)imm.value)); }
+
+void MacroAssembler::call(ImmPtr imm) {
+  BufferOffset bo = emitLoad32Stanza(CallReg, uint32_t(uintptr_t(imm.value)));
+  addPendingJump(bo, imm, RelocationKind::HARDCODED);
+  call(CallReg);
+}
+
+CodeOffset MacroAssembler::call(wasm::SymbolicAddress imm) {
+  movePtr(imm, CallReg);
+  return call(CallReg);
+}
+
+void MacroAssembler::call(JitCode* c) {
+  BufferOffset bo = emitLoad32Stanza(CallReg, uint32_t(uintptr_t(c->raw())));
+  addPendingJump(bo, ImmPtr(c->raw()), RelocationKind::JITCODE);
+  callJitNoProfiler(CallReg);
+}
+
+// A near call patched in place: a single `bl`.
+CodeOffset MacroAssembler::callWithPatch() {
+  as_b(0, RelativeBranch, LinkB);
+  return CodeOffset(currentOffset());
+}
+
+void MacroAssembler::patchCall(uint32_t callerOffset, uint32_t calleeOffset) {
+  BufferOffset bl(callerOffset - sizeof(uint32_t));
+  Instruction* inst = editSrc(bl);
+  int32_t offset = int32_t(calleeOffset) - int32_t(bl.getOffset());
+  MOZ_RELEASE_ASSERT(JOffImm26::IsInRange(offset));
+  inst->setData(PPC_b | JOffImm26(offset).encode() | LinkB);
+}
+
+// Return address operations. LR is an SPR; move it through r0.
+void MacroAssembler::pushReturnAddress() {
+  xs_mflr(r0);
+  push(r0);
+}
+
+void MacroAssembler::popReturnAddress() {
+  pop(r0);
+  xs_mtlr(r0);
+}
+
+// `lis/ori r12, target; mtctr r12; bctr`, patched through a JumpImmediate
+// code label (UpdateLoad32Value).
+CodeOffset MacroAssembler::farJumpWithPatch() {
+  BufferOffset bo = emitLoad32Stanza(SecondScratchReg, 0);
+  xs_mtctr(SecondScratchReg);
+  as_bctr();
+  return CodeOffset(bo.getOffset());
+}
+
+void MacroAssembler::patchFarJump(CodeOffset farJump, uint32_t targetOffset) {
+  addLongJump(BufferOffset(farJump.offset()), BufferOffset(targetOffset));
+}
+
+// static
+void MacroAssembler::patchFarJump(uint8_t* farJump, uint8_t* target) {
+  UpdateLoad32Value((Instruction*)farJump, uint32_t(uintptr_t(target)));
+  FlushICache(farJump, Assembler::Load32Size);
+}
+
+// Four nops that patchNopToCall turns into lis/ori r12 + mtctr + bctrl.
+CodeOffset MacroAssembler::nopPatchableToCall() {
+  m_buffer.enterNoPool(kPatchableCallInsns);
+  for (size_t i = 0; i < kPatchableCallInsns; i++) {
+    writeInst(NopInst);
+  }
+  m_buffer.leaveNoPool();
+  return CodeOffset(currentOffset());
+}
+
+// static
+void MacroAssembler::patchNopToCall(uint8_t* callsite, uint8_t* target) {
+  Instruction* inst = (Instruction*)callsite - kPatchableCallInsns;
+  WriteLoad32Instructions(inst, SecondScratchReg, uint32_t(uintptr_t(target)));
+  inst[2].makeOp_mtctr(SecondScratchReg);
+  inst[3].makeOp_bctr(LinkB);
+  FlushICache(inst, kPatchableCallInsns * sizeof(Instruction));
+}
+
+// static
+void MacroAssembler::patchCallToNop(uint8_t* callsite) {
+  Instruction* inst = (Instruction*)callsite - kPatchableCallInsns;
+  for (size_t i = 0; i < kPatchableCallInsns; i++) {
+    inst[i].makeNop();
+  }
+  FlushICache(inst, kPatchableCallInsns * sizeof(Instruction));
+}
+
+CodeOffset MacroAssembler::moveNearAddressWithPatch(Register dest) {
+  BufferOffset bo = emitLoad32Stanza(dest, 0);
+  return CodeOffset(bo.getOffset());
+}
+
+// static
+void MacroAssembler::patchNearAddressMove(CodeLocationLabel loc,
+                                          CodeLocationLabel target) {
+  UpdateLoad32Value((Instruction*)loc.raw(), uint32_t(uintptr_t(target.raw())));
+  FlushICache(loc.raw(), Assembler::Load32Size);
+}
+
+CodeOffset MacroAssembler::move32WithPatch(Register dest) {
+  BufferOffset bo = emitLoad32Stanza(dest, 0);
+  return CodeOffset(bo.getOffset());
+}
+
+void MacroAssembler::patchMove32(CodeOffset offset, Imm32 n) {
+  Instruction* inst = editSrc(BufferOffset(offset.offset()));
+  UpdateLoad32Value(inst, uint32_t(n.value));
+}
+
+uint32_t MacroAssembler::pushFakeReturnAddress(Register scratch) {
+  CodeLabel cl;
+
+  // Always the 2-instruction lis/ori form, patched by Bind().
+  mov(&cl, scratch);
+  Push(scratch);
+  bind(&cl);
+  uint32_t retAddr = currentOffset();
+
+  addCodeLabel(cl);
+  return retAddr;
+}
+
+// ===============================================================
+// ABI function calls (SysV PPC32).
+//
+// At the call, sp is 16-byte aligned and the bottom 8 bytes of the outgoing
+// area are the linkage area: 0(sp) back chain (written by stwu here),
+// 4(sp) where the callee saves our LR. Stack arguments start at 8(sp)
+// (ShadowStackSpace; the ABIArgGenerator already counts it). We also save
+// LR in the top word of the area because some callers (trampolines, IC
+// stubs) still have their return address in LR.
+
+void MacroAssembler::setupUnalignedABICall(Register scratch) {
+  MOZ_ASSERT(!IsCompilingWasm(), "wasm should only use aligned ABI calls");
+  setupNativeABICall();
+  dynamicAlignment_ = true;
+
+  xs_mr(scratch, StackPointer);
+  // Make room for the saved sp and align down to 16; the saved sp ends up
+  // at 0(sp) (it doubles as a back chain word).
+  as_addi(StackPointer, StackPointer, -int16_t(sizeof(uintptr_t)));
+  as_rlwinm(StackPointer, StackPointer, 0, 0, 27);
+  as_stw(scratch, StackPointer, 0);
+}
+
+void MacroAssembler::callWithABIPre(uint32_t* stackAdjust, bool callFromWasm) {
+  MOZ_ASSERT(inCall_);
+  uint32_t stackForCall = abiArgs_.stackBytesConsumedSoFar();
+  // The callee always owns 4(sp) (LR save) and 0(sp) is our back chain.
+  if (stackForCall < ShadowStackSpace) {
+    stackForCall = ShadowStackSpace;
+  }
+
+  // LR save slot at the top.
+  stackForCall += sizeof(intptr_t);
+
+  if (dynamicAlignment_) {
+    stackForCall += ComputeByteAlignment(stackForCall, ABIStackAlignment);
+  } else {
+    uint32_t alignmentAtPrologue = callFromWasm ? sizeof(wasm::Frame) : 0;
+    stackForCall += ComputeByteAlignment(
+        stackForCall + framePushed() + alignmentAtPrologue, ABIStackAlignment);
+  }
+
+  *stackAdjust = stackForCall;
+  // stwu writes the back chain and moves sp in one instruction.
+  if (is_intN(-int32_t(stackForCall), 16)) {
+    as_stwu(StackPointer, StackPointer, -int16_t(stackForCall));
+  } else {
+    move32(Imm32(-int32_t(stackForCall)), r0);
+    as_stwux(StackPointer, StackPointer, r0);
+  }
+  adjustFrame(stackForCall);
+
+  // Save LR. Restored in callWithABIPost.
+  xs_mflr(r0);
+  storePtr(r0, Address(StackPointer, stackForCall - sizeof(intptr_t)));
+
+  // Position all arguments.
+  {
+    enoughMemory_ &= moveResolver_.resolve();
+    if (!enoughMemory_) {
+      return;
+    }
+
+    MoveEmitter emitter(*this);
+    emitter.emit(moveResolver_);
+    emitter.finish();
+  }
+
+  assertStackAlignment(ABIStackAlignment);
+}
+
+void MacroAssembler::callWithABIPost(uint32_t stackAdjust, ABIType result) {
+  loadPtr(Address(StackPointer, stackAdjust - sizeof(intptr_t)), r0);
+  xs_mtlr(r0);
+
+  if (dynamicAlignment_) {
+    // Restore sp from the word stored by setupUnalignedABICall.
+    loadPtr(Address(StackPointer, stackAdjust), StackPointer);
+    adjustFrame(-int32_t(stackAdjust));
+  } else {
+    freeStack(stackAdjust);
+  }
+
+#ifdef DEBUG
+  MOZ_ASSERT(inCall_);
+  inCall_ = false;
+#endif
+}
+
+void MacroAssembler::callWithABINoProfiler(Register fun, ABIType result) {
+  // Keep the target out of the argument registers the move resolver writes.
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  movePtr(fun, scratch);
+
+  uint32_t stackAdjust;
+  callWithABIPre(&stackAdjust);
+  call(scratch);
+  callWithABIPost(stackAdjust, result);
+}
+
+void MacroAssembler::callWithABINoProfiler(const Address& fun, ABIType result) {
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  loadPtr(fun, scratch);
+
+  uint32_t stackAdjust;
+  callWithABIPre(&stackAdjust);
+  call(scratch);
+  callWithABIPost(stackAdjust, result);
+}
+
+// ===============================================================
+// Move instructions
+
+void MacroAssembler::moveValue(const ValueOperand& src,
+                               const ValueOperand& dest) {
+  Register s0 = src.typeReg();
+  Register s1 = src.payloadReg();
+  Register d0 = dest.typeReg();
+  Register d1 = dest.payloadReg();
+
+  // Either one or both of the source registers could be the same as a
+  // destination register.
+  if (s1 == d0) {
+    if (s0 == d1) {
+      // A swap.
+      xs_mr(r0, d1);
+      xs_mr(d1, d0);
+      xs_mr(d0, r0);
+      return;
+    }
+    // If only one is, copy that source first.
+    std::swap(s0, s1);
+    std::swap(d0, d1);
+  }
+
+  if (s0 != d0) {
+    xs_mr(d0, s0);
+  }
+  if (s1 != d1) {
+    xs_mr(d1, s1);
+  }
+}
+
+void MacroAssembler::moveValue(const Value& src, const ValueOperand& dest) {
+  move32(Imm32(src.toNunboxTag()), dest.typeReg());
+  if (src.isGCThing()) {
+    movePtr(ImmGCPtr(src.toGCThing()), dest.payloadReg());
+  } else {
+    move32(Imm32(src.toNunboxPayload()), dest.payloadReg());
+  }
+}
+
+// ===============================================================
+// Branch functions
+
+void MacroAssembler::loadStoreBuffer(Register ptr, Register buffer) {
+  static_assert(gc::ChunkShift == 20);
+  as_rlwinm(buffer, ptr, 0, 0, 31 - gc::ChunkShift);
+  load32(Address(buffer, gc::ChunkStoreBufferOffset), buffer);
+}
+
+void MacroAssembler::branchPtrInNurseryChunk(Condition cond, Register ptr,
+                                             Register temp, Label* label) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  UseScratchRegisterScope temps(*this);
+  if (temp == Register::Invalid()) {
+    temp = temps.Acquire();
+  }
+  MOZ_ASSERT(ptr != temp);
+
+  static_assert(gc::ChunkShift == 20);
+  as_rlwinm(temp, ptr, 0, 0, 31 - gc::ChunkShift);
+  load32(Address(temp, gc::ChunkStoreBufferOffset), temp);
+  as_cmpwi(temp, 0);
+  ma_b(InvertCondition(cond), label);
+}
+
+void MacroAssembler::branchValueIsNurseryCell(Condition cond,
+                                              const Address& address,
+                                              Register temp, Label* label) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  Label done;
+
+  branchTestGCThing(Assembler::NotEqual, address,
+                    cond == Assembler::Equal ? &done : label);
+
+  loadPtr(ToPayload(address), temp);
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  branchPtrInNurseryChunk(cond, temp, scratch, label);
+
+  bind(&done);
+}
+
+void MacroAssembler::branchValueIsNurseryCell(Condition cond,
+                                              ValueOperand value, Register temp,
+                                              Label* label) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  Label done;
+
+  branchTestGCThing(Assembler::NotEqual, value,
+                    cond == Assembler::Equal ? &done : label);
+  branchPtrInNurseryChunk(cond, value.payloadReg(), temp, label);
+
+  bind(&done);
+}
+
+void MacroAssembler::branchTestValue(Condition cond, const ValueOperand& lhs,
+                                     const Value& rhs, Label* label) {
+  MOZ_ASSERT(cond == Equal || cond == NotEqual);
+  MOZ_ASSERT(!rhs.isNaN());
+
+  // Equal: payloads equal && tags equal. NotEqual: either differs.
+  Label done;
+  Label* payloadDiffers = (cond == Equal) ? &done : label;
+  if (rhs.isGCThing()) {
+    ma_b(ma_cmp(lhs.payloadReg(), ImmGCPtr(rhs.toGCThing()), NotEqual),
+         payloadDiffers);
+  } else {
+    ma_b(ma_cmp(lhs.payloadReg(), Imm32(rhs.toNunboxPayload()), NotEqual),
+         payloadDiffers);
+  }
+  ma_b(ma_cmp(lhs.typeReg(), Imm32(rhs.toNunboxTag()), cond), label);
+  bind(&done);
+}
+
+void MacroAssembler::branchTestNaNValue(Condition cond, const ValueOperand& val,
+                                        Register temp, Label* label) {
+  MOZ_ASSERT(cond == Equal || cond == NotEqual);
+
+  // When testing for NaN, ignore the sign bit (bit 0 of the tag word).
+  static_assert(JS::detail::CanonicalizedNaNSignBit == 0);
+  as_rlwinm(temp, val.typeReg(), 0, 1, 31);
+
+  Value expected = DoubleValue(JS::GenericNaN());
+  Label done;
+  Label* payloadDiffers = (cond == Equal) ? &done : label;
+  ma_b(ma_cmp(val.payloadReg(), Imm32(expected.toNunboxPayload()), NotEqual),
+       payloadDiffers);
+  ma_b(ma_cmp(temp, Imm32(expected.toNunboxTag()), cond), label);
+  bind(&done);
+}
