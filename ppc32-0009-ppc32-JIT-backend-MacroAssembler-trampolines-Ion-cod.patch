+// ===============================================================
+// Box / Unbox (NUNBOX32).
+
+void CodeGenerator::visitBox(LBox* box) {
+  const LDefinition* type = box->getDef(TYPE_INDEX);
+
+  MOZ_ASSERT(!box->payload()->isConstant());
+
+  // The input and the output payload share a virtual register; only the type
+  // tag has to be materialized.
+  masm.move32(Imm32(MIRTypeToTag(box->type())), ToRegister(type));
+}
+
+void CodeGenerator::visitBoxFloatingPoint(LBoxFloatingPoint* box) {
+  const AnyRegister in = ToAnyRegister(box->input());
+  const ValueOperand out = ToOutValue(box);
+
+  masm.moveValue(TypedOrValueRegister(box->type(), in), out);
+}
+
+void CodeGenerator::visitUnbox(LUnbox* unbox) {
+  // Note that for unbox, the type and payload indexes are switched on the
+  // inputs.
+  MUnbox* mir = unbox->mir();
+  Register type = ToRegister(unbox->type());
+  Register payload = ToRegister(unbox->payload());
+  Register output = ToRegister(unbox->output());
+
+  JSValueTag tag = MIRTypeToTag(mir->type());
+  if (mir->fallible()) {
+    bailoutCmp32(Assembler::NotEqual, type, Imm32(tag), unbox->snapshot());
+  } else {
+#ifdef DEBUG
+    Label ok;
+    masm.branch32(Assembler::Equal, type, Imm32(tag), &ok);
+    masm.assumeUnreachable("Infallible unbox type mismatch");
+    masm.bind(&ok);
+#endif
+  }
+
+  // On NUNBOX32 the payload is the unboxed value.
+  PpcMoveReg(masm, payload, output);
+}
+
+// ===============================================================
+// Integer arithmetic.
+
+void CodeGenerator::visitAddI(LAddI* ins) {
+  const LAllocation* lhs = ins->lhs();
+  const LAllocation* rhs = ins->rhs();
+  Register lhsReg = ToRegister(lhs);
+  Register dest = ToRegister(ins->output());
+
+  if (!ins->snapshot()) {
+    if (rhs->isConstant()) {
+      PpcAddImm32(masm, dest, lhsReg, ToInt32(rhs));
+    } else {
+      masm.as_add(dest, lhsReg, ToRegister(rhs));
+    }
+    return;
+  }
+
+  // addo sets XER[OV] on signed 32-bit overflow.
+  if (rhs->isConstant()) {
+    UseScratchRegisterScope temps(masm);
+    Register scratch = temps.Acquire();
+    PpcLoadImm32(masm, scratch, ToInt32(rhs));
+    masm.as_addo(dest, lhsReg, scratch);
+  } else {
+    masm.as_addo(dest, lhsReg, ToRegister(rhs));
+  }
+  Label overflow;
+  PpcBranchOnOverflow(masm, &overflow);
+  bailoutFrom(&overflow, ins->snapshot());
+}
+
+void CodeGenerator::visitAddIntPtr(LAddIntPtr* ins) {
+  const LAllocation* rhs = ins->rhs();
+  Register lhs = ToRegister(ins->lhs());
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    PpcAddImm32(masm, dest, lhs, int32_t(ToIntPtr(rhs)));
+  } else {
+    masm.as_add(dest, lhs, ToRegister(rhs));
+  }
+}
+
+void CodeGenerator::visitAddI64(LAddI64* lir) {
+  LInt64Allocation lhs = lir->lhs();
+  LInt64Allocation rhs = lir->rhs();
+
+  MOZ_ASSERT(ToOutRegister64(lir) == ToRegister64(lhs));
+
+  if (IsConstant(rhs)) {
+    masm.add64(Imm64(ToInt64(rhs)), ToRegister64(lhs));
+    return;
+  }
+
+  masm.add64(ToRegister64(rhs), ToRegister64(lhs));
+}
+
+void CodeGenerator::visitSubI(LSubI* ins) {
+  const LAllocation* lhs = ins->lhs();
+  const LAllocation* rhs = ins->rhs();
+  Register lhsReg = ToRegister(lhs);
+  Register dest = ToRegister(ins->output());
+
+  if (!ins->snapshot()) {
+    if (rhs->isConstant()) {
+      PpcAddImm32(masm, dest, lhsReg, int32_t(-uint32_t(ToInt32(rhs))));
+    } else {
+      // subf d, a, b computes b - a.
+      masm.as_subf(dest, ToRegister(rhs), lhsReg);
+    }
+    return;
+  }
+
+  if (rhs->isConstant()) {
+    UseScratchRegisterScope temps(masm);
+    Register scratch = temps.Acquire();
+    PpcLoadImm32(masm, scratch, ToInt32(rhs));
+    masm.as_subfo(dest, scratch, lhsReg);
+  } else {
+    masm.as_subfo(dest, ToRegister(rhs), lhsReg);
+  }
+  Label overflow;
+  PpcBranchOnOverflow(masm, &overflow);
+  bailoutFrom(&overflow, ins->snapshot());
+}
+
+void CodeGenerator::visitSubIntPtr(LSubIntPtr* ins) {
+  const LAllocation* rhs = ins->rhs();
+  Register lhs = ToRegister(ins->lhs());
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    PpcAddImm32(masm, dest, lhs, int32_t(-uint32_t(int32_t(ToIntPtr(rhs)))));
+  } else {
+    masm.as_subf(dest, ToRegister(rhs), lhs);
+  }
+}
+
+void CodeGenerator::visitSubI64(LSubI64* lir) {
+  LInt64Allocation lhs = lir->lhs();
+  LInt64Allocation rhs = lir->rhs();
+
+  MOZ_ASSERT(ToOutRegister64(lir) == ToRegister64(lhs));
+
+  if (IsConstant(rhs)) {
+    masm.sub64(Imm64(ToInt64(rhs)), ToRegister64(lhs));
+    return;
+  }
+
+  masm.sub64(ToRegister64(rhs), ToRegister64(lhs));
+}
+
+void CodeGenerator::visitMulI(LMulI* ins) {
+  const LAllocation* lhs = ins->lhs();
+  const LAllocation* rhs = ins->rhs();
+  Register lhsReg = ToRegister(lhs);
+  Register dest = ToRegister(ins->output());
+  MMul* mul = ins->mir();
+  MOZ_ASSERT_IF(mul->mode() == MMul::Integer,
+                !mul->canBeNegativeZero() && !mul->canOverflow());
+
+  if (rhs->isConstant()) {
+    int32_t constant = ToInt32(rhs);
+
+    // Bail out on -0.0 (checked first: dest may alias lhs).
+    if (mul->canBeNegativeZero() && constant <= 0) {
+      Assembler::Condition bailoutCond =
+          (constant == 0) ? Assembler::LessThan : Assembler::Equal;
+      bailoutCmp32(bailoutCond, lhsReg, Imm32(0), ins->snapshot());
+    }
+
+    switch (constant) {
+      case -1:
+        if (mul->canOverflow()) {
+          bailoutCmp32(Assembler::Equal, lhsReg, Imm32(INT32_MIN),
+                       ins->snapshot());
+        }
+        masm.as_neg(dest, lhsReg);
+        return;
+      case 0:
+        masm.xs_li(dest, 0);
+        return;
+      case 1:
+        PpcMoveReg(masm, lhsReg, dest);
+        return;
+      case 2:
+        if (mul->canOverflow()) {
+          masm.as_addo(dest, lhsReg, lhsReg);
+          Label overflow;
+          PpcBranchOnOverflow(masm, &overflow);
+          bailoutFrom(&overflow, ins->snapshot());
+        } else {
+          masm.as_add(dest, lhsReg, lhsReg);
+        }
+        return;
+      default:
+        break;
+    }
+
+    if (!mul->canOverflow()) {
+      if (constant > 0 && std::has_single_bit(uint32_t(constant))) {
+        masm.x_slwi(dest, lhsReg, FloorLog2(uint32_t(constant)));
+      } else if (PpcIsInt16(constant)) {
+        masm.as_mulli(dest, lhsReg, int16_t(constant));
+      } else {
+        UseScratchRegisterScope temps(masm);
+        Register scratch = temps.Acquire();
+        PpcLoadImm32(masm, scratch, constant);
+        masm.as_mullw(dest, lhsReg, scratch);
+      }
+      return;
+    }
+
+    {
+      UseScratchRegisterScope temps(masm);
+      Register scratch = temps.Acquire();
+      PpcLoadImm32(masm, scratch, constant);
+      masm.as_mullwo(dest, lhsReg, scratch);
+    }
+    Label overflow;
+    PpcBranchOnOverflow(masm, &overflow);
+    bailoutFrom(&overflow, ins->snapshot());
+    return;
+  }
+
+  Register rhsReg = ToRegister(rhs);
+
+  if (mul->canOverflow()) {
+    // mullwo sets XER[OV] if the product does not fit in 32 signed bits.
+    masm.as_mullwo(dest, lhsReg, rhsReg);
+    Label overflow;
+    PpcBranchOnOverflow(masm, &overflow);
+    bailoutFrom(&overflow, ins->snapshot());
+  } else {
+    masm.as_mullw(dest, lhsReg, rhsReg);
+  }
+
+  if (mul->canBeNegativeZero()) {
+    // The result is -0 if it is 0 and lhs or rhs is negative. (Lowering does
+    // not use at-start allocations here, so lhs and rhs are intact.)
+    MOZ_ASSERT(dest != lhsReg && dest != rhsReg);
+    Label done;
+    masm.branch32(Assembler::NotEqual, dest, Imm32(0), &done);
+    {
+      UseScratchRegisterScope temps(masm);
+      Register scratch = temps.Acquire();
+      masm.as_or_(scratch, lhsReg, rhsReg);
+      masm.as_cmpwi(cr0, scratch, 0);
+    }
+    bailoutIfCR0(Assembler::LessThan, ins->snapshot());
+    masm.bind(&done);
+  }
+}
+
+void CodeGenerator::visitMulIntPtr(LMulIntPtr* ins) {
+  const LAllocation* rhs = ins->rhs();
+  Register lhs = ToRegister(ins->lhs());
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    int32_t constant = int32_t(ToIntPtr(rhs));
+
+    switch (constant) {
+      case -1:
+        masm.as_neg(dest, lhs);
+        return;
+      case 0:
+        masm.xs_li(dest, 0);
+        return;
+      case 1:
+        PpcMoveReg(masm, lhs, dest);
+        return;
+      case 2:
+        masm.as_add(dest, lhs, lhs);
+        return;
+    }
+
+    if (constant > 0 && std::has_single_bit(uint32_t(constant))) {
+      masm.x_slwi(dest, lhs, FloorLog2(uint32_t(constant)));
+      return;
+    }
+    if (PpcIsInt16(constant)) {
+      masm.as_mulli(dest, lhs, int16_t(constant));
+      return;
+    }
+
+    UseScratchRegisterScope temps(masm);
+    Register scratch = temps.Acquire();
+    PpcLoadImm32(masm, scratch, constant);
+    masm.as_mullw(dest, lhs, scratch);
+    return;
+  }
+
+  masm.as_mullw(dest, lhs, ToRegister(rhs));
+}
+
+void CodeGenerator::visitMulI64(LMulI64* lir) {
+  LInt64Allocation lhs = lir->lhs();
+  LInt64Allocation rhs = lir->rhs();
+
+  MOZ_ASSERT(ToRegister64(lhs) == ToOutRegister64(lir));
+
+  if (IsConstant(rhs)) {
+    int64_t constant = ToInt64(rhs);
+    switch (constant) {
+      case -1:
+        masm.neg64(ToRegister64(lhs));
+        return;
+      case 0:
+        masm.move64(Imm64(0), ToRegister64(lhs));
+        return;
+      case 1:
+        // nop
+        return;
+      case 2:
+        masm.add64(ToRegister64(lhs), ToRegister64(lhs));
+        return;
+      default:
+        if (constant > 0) {
+          // Use shift if constant is power of 2.
+          int32_t shift = mozilla::FloorLog2(uint64_t(constant));
+          if (int64_t(1) << shift == constant) {
+            masm.lshift64(Imm32(shift), ToRegister64(lhs));
+            return;
+          }
+        }
+        Register temp = ToTempRegisterOrInvalid(lir->temp0());
+        masm.mul64(Imm64(constant), ToRegister64(lhs), temp);
+    }
+  } else {
+    Register temp = ToTempRegisterOrInvalid(lir->temp0());
+    masm.mul64(ToRegister64(rhs), ToRegister64(lhs), temp);
+  }
+}
+
+// divw is undefined for INT32_MIN / -1 and for x / 0, so both are excluded
+// before dividing.
+void CodeGeneratorPPC::divICommon(MDiv* mir, Register lhs, Register rhs,
+                                  Register output, LSnapshot* snapshot,
+                                  Label& done) {
+  MOZ_ASSERT(!mir->trapOnError());
+
+  if (mir->canBeNegativeOverflow()) {
+    // INT32_MIN / -1: the result is -(double)INT32_MIN.
+    Label notOverflow;
+    masm.branch32(Assembler::NotEqual, lhs, Imm32(INT32_MIN), &notOverflow);
+    masm.branch32(Assembler::NotEqual, rhs, Imm32(-1), &notOverflow);
+    if (mir->canTruncateOverflow()) {
+      // (-INT32_MIN)|0 == INT32_MIN
+      masm.move32(Imm32(INT32_MIN), output);
+      masm.jump(&done);
+    } else {
+      MOZ_ASSERT(mir->fallible());
+      bailout(snapshot);
+    }
+    masm.bind(&notOverflow);
+  }
+
+  if (mir->canBeDivideByZero()) {
+    if (mir->canTruncateInfinities()) {
+      // Infinity|0 == 0
+      Label nonZero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &nonZero);
+      masm.move32(Imm32(0), output);
+      masm.jump(&done);
+      masm.bind(&nonZero);
+    } else {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), snapshot);
+    }
+  }
+
+  // 0 / negative is -0.
+  if (!mir->canTruncateNegativeZero() && mir->canBeNegativeZero()) {
+    Label nonzero;
+    masm.branch32(Assembler::NotEqual, lhs, Imm32(0), &nonzero);
+    MOZ_ASSERT(mir->fallible());
+    bailoutCmp32(Assembler::LessThan, rhs, Imm32(0), snapshot);
+    masm.bind(&nonzero);
+  }
+}
+
+void CodeGenerator::visitDivI(LDivI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register temp = ToRegister(ins->temp0());
+  Register output = ToRegister(ins->output());
+  MDiv* mir = ins->mir();
+
+  Label done;
+  divICommon(mir, lhs, rhs, output, ins->snapshot(), done);
+
+  if (mir->canTruncateRemainder()) {
+    masm.as_divw(output, lhs, rhs);
+  } else {
+    // Bail out if the division is inexact: quotient * rhs != lhs.
+    masm.as_divw(temp, lhs, rhs);
+    masm.as_mullw(output, temp, rhs);
+    masm.as_cmpw(cr0, lhs, output);
+    bailoutIfCR0(Assembler::NotEqual, ins->snapshot());
+    masm.xs_mr(output, temp);
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitDivPowTwoI(LDivPowTwoI* ins) {
+  MDiv* mir = ins->mir();
+  Register lhs = ToRegister(ins->numerator());
+  Register output = ToRegister(ins->output());
+  int32_t shift = ins->shift();
+
+  if (shift == 0) {
+    PpcMoveReg(masm, lhs, output);
+    return;
+  }
+
+  if (!mir->isTruncated()) {
+    // If the remainder is != 0, bail out since this must be a double.
+    {
+      UseScratchRegisterScope temps(masm);
+      Register scratch = temps.Acquire();
+      masm.as_rlwinm_rc(scratch, lhs, 0, 32 - shift, 31);
+    }
+    bailoutIfCR0(Assembler::NotEqual, ins->snapshot());
+  }
+
+  if (!mir->canBeNegativeDividend()) {
+    // Numerator is unsigned, so needs no adjusting. Do the shift.
+    masm.as_srawi(output, lhs, shift);
+    return;
+  }
+
+  // Adjust the value so that shifting produces a correctly rounded result
+  // when the numerator is negative: add (2^shift - 1) if lhs < 0. See 10-1
+  // "Signed Division by a Known Power of 2" in Hacker's Delight.
+  UseScratchRegisterScope temps(masm);
+  Register scratch = temps.Acquire();
+  if (shift > 1) {
+    masm.as_srawi(scratch, lhs, 31);
+    masm.x_srwi(scratch, scratch, 32 - shift);
+  } else {
+    masm.x_srwi(scratch, lhs, 31);
+  }
+  masm.as_add(scratch, scratch, lhs);
+  masm.as_srawi(output, scratch, shift);
+}
+
+void CodeGeneratorPPC::modICommon(MMod* mir, Register lhs, Register rhs,
+                                  Register output, LSnapshot* snapshot,
+                                  Label& done) {
+  MOZ_ASSERT(!mir->trapOnError());
+
+  // X % 0 would give garbage; JS wants NaN.
+  if (mir->canBeDivideByZero()) {
+    if (mir->isTruncated()) {
+      // NaN|0 == 0
+      Label nonZero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &nonZero);
+      masm.move32(Imm32(0), output);
+      masm.jump(&done);
+      masm.bind(&nonZero);
+    } else {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), snapshot);
+    }
+  }
+}
+
+void CodeGenerator::visitModI(LModI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+  MMod* mir = ins->mir();
+
+  MOZ_ASSERT(output != lhs && output != rhs);
+
+  Label done;
+  modICommon(mir, lhs, rhs, output, ins->snapshot(), done);
+
+  // divw is undefined for INT32_MIN / -1. x % -1 is +0 for x >= 0 and -0 for
+  // x < 0, so handle rhs == -1 separately whenever lhs may be negative.
+  if (mir->canBeNegativeDividend()) {
+    Label notMinusOne;
+    masm.branch32(Assembler::NotEqual, rhs, Imm32(-1), &notMinusOne);
+    if (!mir->isTruncated()) {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::LessThan, lhs, Imm32(0), ins->snapshot());
+    }
+    masm.move32(Imm32(0), output);
+    masm.jump(&done);
+    masm.bind(&notMinusOne);
+  }
+
+  // output = lhs - (lhs / rhs) * rhs; the remainder has the sign of lhs.
+  masm.as_divw(output, lhs, rhs);
+  masm.as_mullw(output, output, rhs);
+  masm.as_subf(output, output, lhs);
+
+  // If X%Y == 0 and X < 0, then we *actually* wanted to return -0.0.
+  if (mir->canBeNegativeDividend() && !mir->isTruncated()) {
+    MOZ_ASSERT(mir->fallible());
+    masm.branch32(Assembler::NotEqual, output, Imm32(0), &done);
+    bailoutCmp32(Assembler::LessThan, lhs, Imm32(0), ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitModPowTwoI(LModPowTwoI* ins) {
+  Register in = ToRegister(ins->input());
+  Register out = ToRegister(ins->output());
+  MMod* mir = ins->mir();
+  int32_t shift = ins->shift();
+
+  bool negZeroBails = mir->canBeNegativeDividend() && !mir->isTruncated();
+
+  if (shift == 0) {
+    // x % 1 is +0 or -0.
+    if (negZeroBails) {
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::LessThan, in, Imm32(0), ins->snapshot());
+    }
+    masm.xs_li(out, 0);
+    return;
+  }
+
+  // out = sign(in) * (|in| & mask). For INT32_MIN, |in| wraps to INT32_MIN,
+  // whose masked value is 0 for any mask < 2^31, which is correct.
+  Label negative, done;
+  masm.branch32(Assembler::LessThan, in, Imm32(0), &negative);
+  masm.as_rlwinm(out, in, 0, 32 - shift, 31);
+  masm.jump(&done);
+
+  masm.bind(&negative);
+  masm.as_neg(out, in);
+  masm.as_rlwinm(out, out, 0, 32 - shift, 31);
+  masm.as_neg(out, out);
+  if (negZeroBails) {
+    MOZ_ASSERT(mir->fallible());
+    bailoutCmp32(Assembler::Equal, out, Imm32(0), ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+// x % (2^shift - 1): sum the base-2^shift digits of |x| modulo the mask (as
+// ARM's ma_mod_mask), then restore the sign.
+void CodeGenerator::visitModMaskI(LModMaskI* ins) {
+  Register src = ToRegister(ins->input());
+  Register dest = ToRegister(ins->output());
+  Register hold = ToRegister(ins->temp0());
+  Register remain = ToRegister(ins->temp1());
+  MMod* mir = ins->mir();
+  int32_t shift = ins->shift();
+  MOZ_ASSERT(shift >= 1 && shift <= 31);
+  int32_t mask = int32_t((uint32_t(1) << shift) - 1);
+
+  MOZ_ASSERT(dest != src && dest != hold && dest != remain);
+
+  {
+    UseScratchRegisterScope temps(masm);
+    Register digit = temps.Acquire();
+    Register maskReg = temps.Acquire();
+
+    PpcLoadImm32(masm, maskReg, mask);
+
+    // hold = src < 0 ? -1 : 0; remain = |src| (as unsigned).
+    masm.as_srawi(hold, src, 31);
+    masm.as_xor_(remain, src, hold);
+    masm.as_subf(remain, hold, remain);
+    masm.xs_li(dest, 0);
+
+    Label head, noReduce;
+    masm.bind(&head);
+    {
+      // dest += remain & mask; if (dest >= mask) dest -= mask (unsigned).
+      masm.as_rlwinm(digit, remain, 0, 32 - shift, 31);
+      masm.as_add(dest, dest, digit);
+      masm.as_cmplw(cr0, dest, maskReg);
+      PpcBranchCR0(masm, Assembler::LessThan, &noReduce);
+      masm.as_subf(dest, maskReg, dest);
+      masm.bind(&noReduce);
+
+      // remain >>>= shift; loop while non-zero.
+      masm.as_rlwinm_rc(remain, remain, 32 - shift, shift, 31);
+      PpcBranchCR0(masm, Assembler::NotEqual, &head);
+    }
+
+    // Negate the result if src was negative: (dest ^ hold) - hold.
+    masm.as_xor_(dest, dest, hold);
+    masm.as_subf(dest, hold, dest);
+  }
+
+  if (mir->canBeNegativeDividend() && !mir->isTruncated()) {
+    // A zero result for a negative dividend is -0.
+    MOZ_ASSERT(mir->fallible());
+    Label ok;
+    masm.branch32(Assembler::NotEqual, dest, Imm32(0), &ok);
+    bailoutCmp32(Assembler::NotEqual, hold, Imm32(0), ins->snapshot());
+    masm.bind(&ok);
+  }
+}
+
+template <class T>
+void CodeGeneratorPPC::generateUDivModZeroCheck(Register rhs, Register output,
+                                                Label* done,
+                                                LSnapshot* snapshot, T* mir) {
+  if (!mir) {
+    return;
+  }
+  MOZ_ASSERT(!mir->trapOnError());
+  if (mir->canBeDivideByZero()) {
+    if (mir->isTruncated()) {
+      // Infinity|0 == 0 and NaN|0 == 0.
+      Label nonZero;
+      masm.branch32(Assembler::NotEqual, rhs, Imm32(0), &nonZero);
+      masm.move32(Imm32(0), output);
+      masm.jump(done);
+      masm.bind(&nonZero);
+    } else {
+      // Bailout for divide by zero
+      MOZ_ASSERT(mir->fallible());
+      bailoutCmp32(Assembler::Equal, rhs, Imm32(0), snapshot);
+    }
+  }
+}
+
+void CodeGenerator::visitUDiv(LUDiv* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+  MDiv* mir = ins->mir();
+
+  Label done;
+  generateUDivModZeroCheck(rhs, output, &done, ins->snapshot(), mir);
+
+  masm.as_divwu(output, lhs, rhs);
+
+  // Check for large unsigned result - represent as double.
+  if (!mir->isTruncated()) {
+    MOZ_ASSERT(mir->fallible());
+    bailoutCmp32(Assembler::LessThan, output, Imm32(0), ins->snapshot());
+  }
+
+  // Check for non-zero remainder if not truncating to int.
+  if (!mir->canTruncateRemainder()) {
+    MOZ_ASSERT(mir->fallible());
+    {
+      UseScratchRegisterScope temps(masm);
+      Register scratch = temps.Acquire();
+      masm.as_mullw(scratch, output, rhs);
+      masm.as_cmpw(cr0, scratch, lhs);
+    }
+    bailoutIfCR0(Assembler::NotEqual, ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGenerator::visitUMod(LUMod* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register rhs = ToRegister(ins->rhs());
+  Register output = ToRegister(ins->output());
+  MMod* mir = ins->mir();
+
+  MOZ_ASSERT(output != lhs && output != rhs);
+
+  Label done;
+  generateUDivModZeroCheck(rhs, output, &done, ins->snapshot(), mir);
+
+  masm.as_divwu(output, lhs, rhs);
+  masm.as_mullw(output, output, rhs);
+  masm.as_subf(output, output, lhs);
+
+  // Check for large unsigned result - represent as double.
+  if (!mir->isTruncated()) {
+    MOZ_ASSERT(mir->fallible());
+    bailoutCmp32(Assembler::LessThan, output, Imm32(0), ins->snapshot());
+  }
+
+  masm.bind(&done);
+}
+
+void CodeGeneratorPPC::emitBigIntPtrDiv(LBigIntPtrDiv* ins, Register dividend,
+                                        Register divisor, Register output) {
+  // Callers handle division by zero and integer overflow.
+  masm.as_divw(output, dividend, divisor);
+}
+
+void CodeGeneratorPPC::emitBigIntPtrMod(LBigIntPtrMod* ins, Register dividend,
+                                        Register divisor, Register output) {
+  // Callers handle division by zero and integer overflow.
+  MOZ_ASSERT(output != dividend && output != divisor);
+  masm.as_divw(output, dividend, divisor);
+  masm.as_mullw(output, output, divisor);
+  masm.as_subf(output, output, dividend);
+}
+
+void CodeGenerator::visitNegI(LNegI* ins) {
+  Register input = ToRegister(ins->input());
+  masm.as_neg(ToRegister(ins->output()), input);
+}
+
+void CodeGenerator::visitNegI64(LNegI64* ins) {
+  Register64 input = ToRegister64(ins->input());
+  MOZ_ASSERT(input == ToOutRegister64(ins));
+  masm.neg64(input);
+}
+
+// ===============================================================
+// Bitwise operations.
+
+void CodeGenerator::visitBitNotI(LBitNotI* ins) {
+  const LAllocation* input = ins->input();
+  const LDefinition* dest = ins->output();
+  MOZ_ASSERT(!input->isConstant());
+
+  masm.as_nor(ToRegister(dest), ToRegister(input), ToRegister(input));
+}
+
+void CodeGenerator::visitBitNotI64(LBitNotI64* lir) {
+  Register64 input = ToRegister64(lir->input());
+  MOZ_ASSERT(input == ToOutRegister64(lir));
+  masm.as_nor(input.high, input.high, input.high);
+  masm.as_nor(input.low, input.low, input.low);
+}
+
+void CodeGenerator::visitBitOpI(LBitOpI* ins) {
+  const LAllocation* rhs = ins->rhs();
+  Register lhs = ToRegister(ins->lhs());
+  Register dest = ToRegister(ins->output());
+
+  if (!rhs->isConstant()) {
+    Register rhsReg = ToRegister(rhs);
+    switch (ins->bitop()) {
+      case JSOp::BitOr:
+        masm.as_or_(dest, lhs, rhsReg);
+        break;
+      case JSOp::BitXor:
+        masm.as_xor_(dest, lhs, rhsReg);
+        break;
+      case JSOp::BitAnd:
+        masm.as_and_(dest, lhs, rhsReg);
+        break;
+      default:
+        MOZ_CRASH("unexpected binary opcode");
+    }
+    return;
+  }
+
+  uint32_t imm = uint32_t(ToInt32(rhs));
+  uint16_t lo = uint16_t(imm & 0xffff);
+  uint16_t hi = uint16_t(imm >> 16);
+
+  switch (ins->bitop()) {
+    case JSOp::BitOr:
+      if (hi == 0) {
+        masm.as_ori(dest, lhs, lo);
+      } else if (lo == 0) {
+        masm.as_oris(dest, lhs, hi);
+      } else {
+        masm.as_ori(dest, lhs, lo);
+        masm.as_oris(dest, dest, hi);
+      }
+      break;
+    case JSOp::BitXor:
+      if (hi == 0) {
+        masm.as_xori(dest, lhs, lo);
+      } else if (lo == 0) {
+        masm.as_xoris(dest, lhs, hi);
+      } else {
+        masm.as_xori(dest, lhs, lo);
+        masm.as_xoris(dest, dest, hi);
+      }
+      break;
+    case JSOp::BitAnd:
+      if (hi == 0) {
+        masm.as_andi_rc(dest, lhs, lo);
+      } else if (lo == 0) {
+        masm.as_andis_rc(dest, lhs, hi);
+      } else {
+        UseScratchRegisterScope temps(masm);
+        Register scratch = temps.Acquire();
+        PpcLoadImm32(masm, scratch, int32_t(imm));
+        masm.as_and_(dest, lhs, scratch);
+      }
+      break;
+    default:
+      MOZ_CRASH("unexpected binary opcode");
+  }
+}
+
+void CodeGenerator::visitBitOpI64(LBitOpI64* lir) {
+  LInt64Allocation lhs = lir->lhs();
+  LInt64Allocation rhs = lir->rhs();
+
+  MOZ_ASSERT(ToOutRegister64(lir) == ToRegister64(lhs));
+
+  switch (lir->bitop()) {
+    case JSOp::BitOr:
+      if (IsConstant(rhs)) {
+        masm.or64(Imm64(ToInt64(rhs)), ToRegister64(lhs));
+      } else {
+        masm.or64(ToRegister64(rhs), ToRegister64(lhs));
+      }
+      break;
+    case JSOp::BitXor:
+      if (IsConstant(rhs)) {
+        masm.xor64(Imm64(ToInt64(rhs)), ToRegister64(lhs));
+      } else {
+        masm.xor64(ToRegister64(rhs), ToRegister64(lhs));
+      }
+      break;
+    case JSOp::BitAnd:
+      if (IsConstant(rhs)) {
+        masm.and64(Imm64(ToInt64(rhs)), ToRegister64(lhs));
+      } else {
+        masm.and64(ToRegister64(rhs), ToRegister64(lhs));
+      }
+      break;
+    default:
+      MOZ_CRASH("unexpected binary opcode");
+  }
+}
+
+// Emits dest = lhs <op> (count & 31). slw/srw/sraw use six bits of the count,
+// so JS's mod-32 semantics need an explicit mask.
+static void PpcEmitShift32(MacroAssembler& masm, JSOp op, Register lhs,
+                           Register count, Register dest) {
+  UseScratchRegisterScope temps(masm);
+  Register masked = temps.Acquire();
+  masm.as_rlwinm(masked, count, 0, 27, 31);
+  switch (op) {
+    case JSOp::Lsh:
+      masm.as_slw(dest, lhs, masked);
+      break;
+    case JSOp::Rsh:
+      masm.as_sraw(dest, lhs, masked);
+      break;
+    case JSOp::Ursh:
+      masm.as_srw(dest, lhs, masked);
+      break;
+    default:
+      MOZ_CRASH("Unexpected shift op");
+  }
+}
+
+static void PpcEmitShift32(MacroAssembler& masm, JSOp op, Register lhs,
+                           int32_t shift, Register dest) {
+  MOZ_ASSERT(shift >= 0 && shift <= 31);
+  if (shift == 0) {
+    PpcMoveReg(masm, lhs, dest);
+    return;
+  }
+  switch (op) {
+    case JSOp::Lsh:
+      masm.x_slwi(dest, lhs, shift);
+      break;
+    case JSOp::Rsh:
+      masm.as_srawi(dest, lhs, shift);
+      break;
+    case JSOp::Ursh:
+      masm.x_srwi(dest, lhs, shift);
+      break;
+    default:
+      MOZ_CRASH("Unexpected shift op");
+  }
+}
+
+void CodeGenerator::visitShiftI(LShiftI* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    int32_t shift = ToInt32(rhs) & 0x1F;
+    PpcEmitShift32(masm, ins->bitop(), lhs, shift, dest);
+    // x >>> 0 can overflow.
+    if (ins->bitop() == JSOp::Ursh && shift == 0 &&
+        ins->mir()->toUrsh()->fallible()) {
+      bailoutCmp32(Assembler::LessThan, dest, Imm32(0), ins->snapshot());
+    }
+    return;
+  }
+
+  PpcEmitShift32(masm, ins->bitop(), lhs, ToRegister(rhs), dest);
+  if (ins->bitop() == JSOp::Ursh && ins->mir()->toUrsh()->fallible()) {
+    // x >>> 0 can overflow.
+    bailoutCmp32(Assembler::LessThan, dest, Imm32(0), ins->snapshot());
+  }
+}
+
+void CodeGenerator::visitShiftIntPtr(LShiftIntPtr* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  const LAllocation* rhs = ins->rhs();
+  Register dest = ToRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    int32_t shift = int32_t(ToIntPtr(rhs)) & 0x1F;
+    PpcEmitShift32(masm, ins->bitop(), lhs, shift, dest);
+    return;
+  }
+
+  PpcEmitShift32(masm, ins->bitop(), lhs, ToRegister(rhs), dest);
+}
+
+void CodeGenerator::visitShiftI64(LShiftI64* lir) {
+  LInt64Allocation lhs = lir->lhs();
+  const LAllocation* rhs = lir->rhs();
+
+  MOZ_ASSERT(ToOutRegister64(lir) == ToRegister64(lhs));
+
+  if (rhs->isConstant()) {
+    int32_t shift = int32_t(rhs->toConstant()->toInt64() & 0x3F);
+    switch (lir->bitop()) {
+      case JSOp::Lsh:
+        if (shift) {
+          masm.lshift64(Imm32(shift), ToRegister64(lhs));
+        }
+        break;
+      case JSOp::Rsh:
+        if (shift) {
+          masm.rshift64Arithmetic(Imm32(shift), ToRegister64(lhs));
+        }
+        break;
+      case JSOp::Ursh:
+        if (shift) {
+          masm.rshift64(Imm32(shift), ToRegister64(lhs));
+        }
+        break;
+      default:
+        MOZ_CRASH("Unexpected shift op");
+    }
+    return;
+  }
+
+  switch (lir->bitop()) {
+    case JSOp::Lsh:
+      masm.lshift64(ToRegister(rhs), ToRegister64(lhs));
+      break;
+    case JSOp::Rsh:
+      masm.rshift64Arithmetic(ToRegister(rhs), ToRegister64(lhs));
+      break;
+    case JSOp::Ursh:
+      masm.rshift64(ToRegister(rhs), ToRegister64(lhs));
+      break;
+    default:
+      MOZ_CRASH("Unexpected shift op");
+  }
+}
+
+void CodeGenerator::visitUrshD(LUrshD* ins) {
+  Register lhs = ToRegister(ins->lhs());
+  Register temp = ToRegister(ins->temp0());
+
+  const LAllocation* rhs = ins->rhs();
+  FloatRegister out = ToFloatRegister(ins->output());
+
+  if (rhs->isConstant()) {
+    PpcEmitShift32(masm, JSOp::Ursh, lhs, ToInt32(rhs) & 0x1F, temp);
+  } else {
+    PpcEmitShift32(masm, JSOp::Ursh, lhs, ToRegister(rhs), temp);
+  }
+
+  masm.convertUInt32ToDouble(temp, out);
+}
+
+void CodeGenerator::visitEffectiveAddress3(LEffectiveAddress3* ins) {
+  const MEffectiveAddress3* mir = ins->mir();
+  Register base = ToRegister(ins->base());
+  Register index = ToRegister(ins->index());
+  Register output = ToRegister(ins->output());
+
+  uint32_t shift = ScaleToShift(mir->scale());
+  if (shift == 0) {
+    masm.as_add(output, base, index);
+  } else {
+    UseScratchRegisterScope temps(masm);
+    Register scratch = temps.Acquire();
+    masm.x_slwi(scratch, index, shift);
+    masm.as_add(output, base, scratch);
+  }
+  if (mir->displacement() != 0) {
+    PpcAddImm32(masm, output, output, mir->displacement());
+  }
+}
+
+void CodeGenerator::visitEffectiveAddress2(LEffectiveAddress2* ins) {
+  const MEffectiveAddress2* mir = ins->mir();
+  Register index = ToRegister(ins->index());
+  Register output = ToRegister(ins->output());
+
+  uint32_t shift = ScaleToShift(mir->scale());
+  if (shift == 0) {
+    PpcMoveReg(masm, index, output);
+  } else {
+    masm.x_slwi(output, index, shift);
+  }
+  if (mir->displacement() != 0) {
+    PpcAddImm32(masm, output, output, mir->displacement());
+  }
+}
