+// Truncate to int32 and fail unless the conversion is exact (this also
+// rejects NaN and out-of-range values, which do not round-trip).
+void MacroAssemblerPPCCompat::convertDoubleToInt32(FloatRegister src,
+                                                   Register dest, Label* fail,
+                                                   bool negativeZeroCheck) {
+  MOZ_ASSERT(src.encoding() != ScratchDoubleReg.encoding());
+  truncDoubleToInt32Raw(src, dest);
+  convertInt32ToDouble(dest, ScratchDoubleReg);
+  as_fcmpu(ScratchDoubleReg, src.asDouble());
+  ma_b(DoubleNotEqualOrUnordered, fail);
+
+  if (negativeZeroCheck) {
+    // Only +-0 truncates to 0 exactly; -0 has its sign bit set.
+    Label notZero;
+    as_cmpwi(dest, 0);
+    ma_b(NotEqual, &notZero);
+    moveDoubleHighWordToGPR(src, r0);
+    as_cmpwi(r0, 0);
+    ma_b(LessThan, fail);
+    bind(&notZero);
+  }
+}
+
+void MacroAssemblerPPCCompat::unboxValue(const ValueOperand& src,
+                                         AnyRegister dest, JSValueType type) {
+  if (dest.isFloat()) {
+    Label notInt32, end;
+    as_cmpwi(src.typeReg(), int16_t(JSVAL_TAG_INT32));
+    ma_b(NotEqual, &notInt32);
+    convertInt32ToDouble(src.payloadReg(), dest.fpu());
+    jump(&end);
+    bind(&notInt32);
+    unboxDouble(src, dest.fpu());
+    bind(&end);
+  } else if (src.payloadReg() != dest.gpr()) {
+    xs_mr(dest.gpr(), src.payloadReg());
+  }
+}
+
+void MacroAssemblerPPCCompat::loadInt32OrDouble(const Address& src,
+                                                FloatRegister dest) {
+  Label notInt32, end;
+  load32(ToType(src), r0);
+  as_cmpwi(r0, int16_t(JSVAL_TAG_INT32));
+  ma_b(NotEqual, &notInt32);
+  load32(ToPayload(src), r0);
+  convertInt32ToDouble(r0, dest);
+  jump(&end);
+  bind(&notInt32);
+  loadDouble(src, dest);
+  bind(&end);
+}
+
+void MacroAssemblerPPCCompat::loadInt32OrDouble(const BaseIndex& addr,
+                                                FloatRegister dest) {
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  computeEffectiveAddress(addr, scratch);
+  loadInt32OrDouble(Address(scratch, 0), dest);
+}
