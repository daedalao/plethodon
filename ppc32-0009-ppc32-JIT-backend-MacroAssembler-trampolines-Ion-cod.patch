+// JS Math.min/max on FPRs (float32 values are held in double format).
+static inline void PPC32MinMaxFP(MacroAssembler& masm, FloatRegister srcDest,
+                                 FloatRegister other, bool handleNaN,
+                                 bool isMax, bool isFloat32) {
+  MOZ_ASSERT(srcDest.encoding() != ScratchDoubleReg.encoding());
+  MOZ_ASSERT(other.encoding() != ScratchDoubleReg.encoding());
+  Label done, nan, equal;
+
+  masm.as_fcmpu(srcDest, other);
+  if (handleNaN) {
+    masm.condBranchToLabel(Assembler::DoubleUnordered, &nan);
+  }
+  masm.condBranchToLabel(Assembler::DoubleEqual, &equal);
+  {
+    // Ordered and distinct: keep srcDest when it wins, else take other.
+    PPC32SkipIf skip(masm, isMax ? Assembler::GreaterThan : Assembler::LessThan,
+                     1);
+    masm.as_fmr(srcDest, other);
+  }
+  masm.branchToLabel(&done);
+
+  // Equal: only +0/-0 need care. f0 = x - x is +0 for finite x (Inf gives
+  // NaN, so the compare below is unordered and leaves srcDest alone).
+  masm.bind(&equal);
+  masm.as_fsub(ScratchDoubleReg, srcDest, srcDest);
+  masm.as_fcmpu(srcDest, ScratchDoubleReg);
+  if (isMax) {
+    // -0 + -0 = -0, -0 + +0 = +0.
+    PPC32SkipIf skip(masm, Assembler::NotEqual, 1);
+    masm.as_fadd(srcDest, srcDest, other);
+  } else {
+    // -((-a) - b) is -0 when either operand is -0.
+    PPC32SkipIf skip(masm, Assembler::NotEqual, 3);
+    masm.as_fneg(ScratchDoubleReg, srcDest);
+    masm.as_fsub(ScratchDoubleReg, ScratchDoubleReg, other);
+    masm.as_fneg(srcDest, ScratchDoubleReg);
+  }
+
+  if (handleNaN) {
+    masm.branchToLabel(&done);
+    masm.bind(&nan);
+    // Propagate the NaN operand.
+    if (isFloat32) {
+      masm.as_fadds(srcDest, srcDest, other);
+    } else {
+      masm.as_fadd(srcDest, srcDest, other);
+    }
+  }
+  masm.bind(&done);
+}
+
