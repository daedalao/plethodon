+
+void MacroAssembler::add64(Imm32 imm, Register64 dest) {
+  // The immediate is zero-extended (as on ARM/x86): carry into high only.
+  if (PPC32IsInt16(imm.value)) {
+    as_addic(dest.low, dest.low, int16_t(imm.value));
+  } else {
+    PPC32LoadImm(*this, r0, imm.value);
+    as_addc(dest.low, dest.low, r0);
+  }
+  as_addze(dest.high, dest.high);
+}
+
+void MacroAssembler::add64(Imm64 imm, Register64 dest) {
+  int32_t lo = imm.low().value;
+  int32_t hi = imm.hi().value;
+  if (PPC32IsInt16(lo)) {
+    as_addic(dest.low, dest.low, int16_t(lo));
+  } else {
+    PPC32LoadImm(*this, r0, lo);
+    as_addc(dest.low, dest.low, r0);
+  }
+  if (hi == 0) {
+    as_addze(dest.high, dest.high);
+  } else if (hi == -1) {
+    as_addme(dest.high, dest.high);
+  } else {
+    // li/lis/ori leave XER[CA] alone.
+    PPC32LoadImm(*this, r0, hi);
+    as_adde(dest.high, dest.high, r0);
+  }
+}
