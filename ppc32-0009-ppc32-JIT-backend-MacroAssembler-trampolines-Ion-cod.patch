+    as_ori(r0, type, 0xff80);
+    as_oris(r0, r0, 0xffff);
+    if (src != dest.payloadReg()) {
+      xs_mr(dest.payloadReg(), src);
+    }
+    xs_mr(dest.typeReg(), r0);
