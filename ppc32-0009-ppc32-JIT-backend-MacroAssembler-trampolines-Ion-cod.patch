+// ===============================================================
+
+CodeGeneratorPPC::CodeGeneratorPPC(MIRGenerator* gen, LIRGraph* graph,
+                                   MacroAssembler* masm,
+                                   const wasm::CodeMetadata* wasmCodeMeta)
+    : CodeGeneratorShared(gen, graph, masm, wasmCodeMeta) {}
+
+MoveOperand CodeGeneratorPPC::toMoveOperand(LAllocation a) const {
+  if (a.isGeneralReg()) {
+    return MoveOperand(ToRegister(a));
+  }
+  if (a.isFloatReg()) {
+    return MoveOperand(ToFloatRegister(a));
+  }
+  MoveOperand::Kind kind = a.isStackArea() ? MoveOperand::Kind::EffectiveAddress
+                                           : MoveOperand::Kind::Memory;
+  Address addr = ToAddress(a);
+  MOZ_ASSERT((addr.offset & 3) == 0);
+  return MoveOperand(addr, kind);
+}
+
+bool CodeGeneratorPPC::generateOutOfLineCode() {
+  if (!CodeGeneratorShared::generateOutOfLineCode()) {
+    return false;
+  }
+
+  if (deoptLabel_.used()) {
+    // All non-table-based bailouts come here with the snapshot offset pushed.
+    masm.bind(&deoptLabel_);
+
+    // Push the frame size below the snapshot offset: the bailout thunk
+    // expects [frameSize][snapshotOffset] (see PushBailoutFrame in
+    // Trampoline-ppc.cpp and BailoutStack).
+    masm.push(Imm32(frameSize()));
+
+    TrampolinePtr handler = gen->jitRuntime()->getGenericBailoutHandler();
+    masm.jump(handler);
+  }
+
+  return !masm.oom();
+}
+
+void CodeGeneratorPPC::bailoutFrom(Label* label, LSnapshot* snapshot) {
+  MOZ_ASSERT_IF(!masm.oom(), label->used());
+  MOZ_ASSERT_IF(!masm.oom(), !label->bound());
+
+  encode(snapshot);
+
+  InlineScriptTree* tree = snapshot->mir()->block()->trackedTree();
+  auto* ool = new (alloc()) LambdaOutOfLineCode([=, this](OutOfLineCode& ool) {
+    // One 32-bit word: BailoutStack::snapshotOffset_ must be immediately
+    // followed by the Ion frame (parentStackPointer()).
+    masm.push(Imm32(snapshot->snapshotOffset()));
+    masm.jump(&deoptLabel_);
+  });
+
+  // All bailout code is associated with the bytecodeSite of the block we are
+  // bailing out from.
+  addOutOfLineCode(ool,
+                   new (alloc()) BytecodeSite(tree, tree->script()->code()));
+
+  masm.retarget(label, ool->entry());
+}
+
+void CodeGeneratorPPC::bailout(LSnapshot* snapshot) {
+  Label label;
+  masm.jump(&label);
+  bailoutFrom(&label, snapshot);
+}
+
+void CodeGeneratorPPC::bailoutIfCR0(Assembler::Condition cond,
+                                    LSnapshot* snapshot) {
+  Label bail;
+  PpcBranchCR0(masm, cond, &bail);
+  bailoutFrom(&bail, snapshot);
+}
+
+void CodeGeneratorPPC::emitBranchDouble(Assembler::DoubleCondition cond,
+                                        FloatRegister lhs, FloatRegister rhs,
+                                        MBasicBlock* mirTrue,
+                                        MBasicBlock* mirFalse) {
+  // fcmpu compares singles and doubles alike (an FPR always holds a double).
+  // Unordered sets CR0[SO]; the DoubleConditions account for it.
+  masm.as_fcmpu(cr0, lhs, rhs);
+  if (isNextBlock(mirFalse->lir())) {
+    PpcBranchCR0(masm, cond, getJumpLabelForBranch(mirTrue));
+  } else {
+    PpcBranchCR0(masm, Assembler::InvertCondition(cond),
+                 getJumpLabelForBranch(mirFalse));
+    jumpToBlock(mirTrue);
+  }
+}
