+void MacroAssembler::cmp16Set(Condition cond, Address lhs, Imm32 rhs,
+                              Register dest) {
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  Imm32 imm = PPC32LoadNarrow(*this, cond, lhs, rhs, s, 2);
+  PPC32SetFromCR0(*this, PPC32CmpReg(*this, cond, s, imm), dest);
+}
