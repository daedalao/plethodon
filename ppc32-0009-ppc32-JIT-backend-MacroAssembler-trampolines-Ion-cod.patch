+// Move instructions
+
+void MacroAssembler::move64(Register64 src, Register64 dest) {
+  if (dest.low == src.high) {
+    if (dest.high == src.low) {
+      // Full swap.
+      xs_mr(r0, src.low);
+      xs_mr(dest.low, src.high);
+      xs_mr(dest.high, r0);
+      return;
+    }
+    // Write high first so src.high is read before dest.low overwrites it.
+    movePtr(src.high, dest.high);
+    movePtr(src.low, dest.low);
+    return;
+  }
+  movePtr(src.low, dest.low);
+  movePtr(src.high, dest.high);
+}
+
+void MacroAssembler::move64(Imm64 imm, Register64 dest) {
+  PPC32LoadImm(*this, dest.low, imm.low().value);
+  PPC32LoadImm(*this, dest.high, imm.hi().value);
+}
