+
+void MacroAssemblerPPCCompat::storePayload(const Value& val,
+                                           const Address& dest) {
+  if (val.isGCThing()) {
+    UseScratchRegisterScope temps(*this);
+    Register scratch = temps.Acquire();
+    movePtr(ImmGCPtr(val.toGCThing()), scratch);
+    store32(scratch, ToPayload(dest));
+  } else {
+    move32(Imm32(val.toNunboxPayload()), r0);
+    store32(r0, ToPayload(dest));
+  }
+}
+
+void MacroAssemblerPPCCompat::storePayload(Register src, const Address& dest) {
+  store32(src, ToPayload(dest));
+}
+
+void MacroAssemblerPPCCompat::storePayload(const Value& val,
+                                           const BaseIndex& dest) {
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  computeEffectiveAddress(dest, scratch);
+  storePayload(val, Address(scratch, 0));
+}
+
+void MacroAssemblerPPCCompat::storePayload(Register src,
+                                           const BaseIndex& dest) {
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  computeEffectiveAddress(dest, scratch);
+  store32(src, ToPayload(Address(scratch, 0)));
+}
