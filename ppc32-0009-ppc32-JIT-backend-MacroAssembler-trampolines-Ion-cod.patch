+// ===============================================================
+// GPR <-> FPR transfers through a stack temp.
+//
+// ppc32 SysV has no red zone, so the temp is always below a decremented sp.
+// The update forms (stwu/stfdu) decrement sp and store in one instruction.
+
+void MacroAssemblerPPCCompat::moveDoubleToGPRPair(FloatRegister src,
+                                                  Register hi, Register lo) {
+  MOZ_ASSERT(hi != lo);
+  as_stfdu(src, StackPointer, -PPCStackTempSize);
+  as_lwz(hi, StackPointer, 0);
+  as_lwz(lo, StackPointer, 4);
+  releaseStackTemp();
+}
+
+void MacroAssemblerPPCCompat::moveGPRPairToDouble(Register hi, Register lo,
+                                                  FloatRegister dest) {
+  as_stwu(hi, StackPointer, -PPCStackTempSize);
+  as_stw(lo, StackPointer, 4);
+  as_lfd(dest, StackPointer, 0);
+  releaseStackTemp();
+}
+
+void MacroAssemblerPPCCompat::moveFloat32ToGPRBits(FloatRegister src,
+                                                   Register dest) {
+  as_stfsu(src, StackPointer, -PPCStackTempSize);
+  as_lwz(dest, StackPointer, 0);
+  releaseStackTemp();
+}
+
+void MacroAssemblerPPCCompat::moveGPRBitsToFloat32(Register src,
+                                                   FloatRegister dest) {
+  as_stwu(src, StackPointer, -PPCStackTempSize);
+  as_lfs(dest, StackPointer, 0);
+  releaseStackTemp();
+}
+
+void MacroAssemblerPPCCompat::moveDoubleHighWordToGPR(FloatRegister src,
+                                                      Register dest) {
+  as_stfdu(src, StackPointer, -PPCStackTempSize);
+  as_lwz(dest, StackPointer, 0);
+  releaseStackTemp();
+}
+
+// Clobbers ScratchDoubleReg (f0).
+void MacroAssemblerPPCCompat::truncDoubleToInt32Raw(FloatRegister src,
+                                                    Register dest) {
+  as_fctiwz(ScratchDoubleReg, src);
+  as_stfdu(ScratchDoubleReg, StackPointer, -PPCStackTempSize);
+  // Big-endian: the int32 result is the low word, at +4.
+  as_lwz(dest, StackPointer, 4);
+  releaseStackTemp();
+}
+
+// Clobbers ScratchDoubleReg (f0).
+void MacroAssemblerPPCCompat::roundDoubleToInt32Raw(FloatRegister src,
+                                                    Register dest) {
+  as_fctiw(ScratchDoubleReg, src);
+  as_stfdu(ScratchDoubleReg, StackPointer, -PPCStackTempSize);
+  as_lwz(dest, StackPointer, 4);
+  releaseStackTemp();
+}
