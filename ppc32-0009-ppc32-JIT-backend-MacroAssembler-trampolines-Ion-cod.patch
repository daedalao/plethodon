+
+void MacroAssembler::branchTestDoubleTruthy(bool truthy, FloatRegister reg,
+                                            Label* label) {
+  MOZ_ASSERT(reg.encoding() != ScratchDoubleReg.encoding());
+  // Falsy iff reg is +-0 or NaN. f0 = reg - reg is +0 for finite reg and NaN
+  // for Inf/NaN, so cr0.eq is "reg is +-0"; cr1.un is "reg is NaN".
+  as_fsub(ScratchDoubleReg, reg, reg);
+  as_fcmpu(cr0, reg, ScratchDoubleReg);
+  as_fcmpu(cr1, reg, reg);
+  as_cror(Assembler::crBit(cr0, Assembler::Equal),
+          Assembler::crBit(cr0, Assembler::Equal),
+          Assembler::crBit(cr1, Assembler::DoubleUnordered));
+  condBranchToLabel(truthy ? Assembler::NotEqual : Assembler::Equal, label);
+}
