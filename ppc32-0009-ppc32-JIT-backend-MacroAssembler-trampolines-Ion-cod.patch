+// Misc compat helpers
+
+CodeOffset MacroAssemblerPPCCompat::toggledCall(JitCode* target,
+                                                bool enabled) {
+  // lis/ori r12 + (mtctr r12; bctrl | nop; nop). ToggleCall flips the tail.
+  BufferOffset bo =
+      emitLoad32Stanza(SecondScratchReg, uint32_t(uintptr_t(target->raw())));
+  CodeOffset offset(bo.getOffset());
+  addPendingJump(bo, ImmPtr(target->raw()), RelocationKind::JITCODE);
+  m_buffer.enterNoPool(2);
+  if (enabled) {
+    xs_mtctr(SecondScratchReg);
+    as_bctr(LinkB);
+  } else {
+    writeInst(NopInst);
+    writeInst(NopInst);
+  }
+  m_buffer.leaveNoPool();
+  MOZ_ASSERT_IF(!oom(), nextOffset().getOffset() - offset.offset() ==
+                            ToggledCallSize(nullptr));
+  return offset;
+}
+
+void MacroAssemblerPPCCompat::ma_add32TestCarry(Condition cond, Register rd,
+                                                Register rs, Imm32 imm,
+                                                Label* overflow) {
+  MOZ_ASSERT(cond == CarrySet || cond == CarryClear);
+  if (is_intN(imm.value, 16)) {
+    as_addic(rd, rs, int16_t(imm.value));
+  } else {
+    MOZ_ASSERT(rs != r0);
+    move32(imm, r0);
+    as_addc(rd, rs, r0);
+  }
+  // XER[CA] -> CR0[EQ].
+  as_mcrxr(cr0);
+  ma_b(cond == CarrySet ? Equal : NotEqual, overflow);
+}
+
+void MacroAssemblerPPCCompat::ma_mod_mask(Register src, Register dest,
+                                          Register hold, Register remain,
+                                          int32_t shift, Label* negZero) {
+  // Compute x % ((1<<shift) - 1) by digit-summing in base b = 1<<shift.
+  // Since b % (b-1) == 1, x % (b-1) == sum of base-b digits of x, mod (b-1).
+  int32_t mask = (1 << shift) - 1;
+  Label head, negative, sumSigned, done;
+
+  xs_mr(remain, src);
+  xs_li(dest, 0);
+
+  as_cmpwi(remain, 0);
+  ma_b(Assembler::LessThan, &negative);
+  xs_li(hold, 1);
+  jump(&head);
+
+  bind(&negative);
+  xs_li(hold, -1);
+  as_neg(remain, remain);
+
+  bind(&head);
+  {
+    // r0 = remain & mask
+    move32(Imm32(mask), r0);
+    as_and_(r0, remain, r0);
+    as_add(dest, dest, r0);
+
+    // Trial subtraction: r0 = dest - mask; keep it if non-negative.
+    move32(Imm32(mask), r0);
+    as_subf(r0, r0, dest);
+    as_cmpwi(r0, 0);
+    ma_b(Assembler::LessThan, &sumSigned);
+    xs_mr(dest, r0);
+    bind(&sumSigned);
+
+    x_srwi(remain, remain, shift);
+    as_cmpwi(remain, 0);
+    ma_b(Assembler::NotEqual, &head);
+  }
+
+  as_cmpwi(hold, 0);
+  ma_b(Assembler::GreaterThanOrEqual, &done);
+
+  if (negZero != nullptr) {
+    as_cmpwi(dest, 0);
+    ma_b(Assembler::Equal, negZero);
+  }
+
+  as_neg(dest, dest);
+
+  bind(&done);
+}
