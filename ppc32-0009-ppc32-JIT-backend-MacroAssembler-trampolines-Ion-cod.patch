+void MacroAssembler::remainder32(Register lhs, Register rhs, Register dest,
+                                 bool isUnsigned) {
+  // dest = lhs - (lhs / rhs) * rhs. r0 is safe: divw/mullw/subf have no
+  // zero-register operand forms.
+  if (isUnsigned) {
+    as_divwu(r0, lhs, rhs);
+  } else {
+    as_divw(r0, lhs, rhs);
+  }
+  as_mullw(r0, r0, rhs);
+  as_subf(dest, r0, lhs);
+}
