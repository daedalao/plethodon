+using js::wasm::FaultingCodeOffsetPair;
+
+static const int defaultShift = 3;
+static_assert(1 << defaultShift == sizeof(JS::Value));
+
+// 32-bit PowerPC (G4), NUNBOX32, big-endian.
+//
+// A Value lives in a (type, payload) register pair (ValueOperand::typeReg()
+// / payloadReg()). In memory the tag word is at +0 and the payload word at
+// +4 (NUNBOX32_TYPE_OFFSET / NUNBOX32_PAYLOAD_OFFSET). An int64 lives in a
+// (high, low) register pair; in memory the high word is at +0.
+//
+// Register conventions of the helpers in this file:
+// - r11/r12 are the UseScratchRegisterScope pool.
+// - r0 is used freely as an extra computational temp (it is never a base
+//   register). Never keep a live value in r0 across a masm helper call.
+// - There is no red zone: helpers that need memory (GPR<->FPR moves, FP
+//   constants, int<->double conversions) first move sp down by
+//   PPCStackTempSize bytes and restore it afterwards. framePushed() is not
+//   affected, but such helpers must not be given sp-relative operands.
+
+inline bool is_intN(int64_t x, unsigned n) {
+  MOZ_ASSERT((0 < n) && (n < 64));
+  int64_t limit = static_cast<int64_t>(1) << (n - 1);
+  return (-limit <= x) && (x < limit);
+}
+
+inline bool is_uintN(uint64_t x, unsigned n) {
+  MOZ_ASSERT((0 < n) && (n < 64));
+  return !(x >> n);
+}
+
+// A patchable 32-bit immediate/address is `lis rD,hi; ori rD,rD,lo`
+// (Assembler::as_load32Patchable / WriteLoad32Instructions /
+// ExtractLoad32Value / UpdateLoad32Value).
+static constexpr size_t kLoad32Insns = 2;
+
+// Patchable call/jump to an absolute address: lis/ori r12 + mtctr + bctr[l].
+// Used by toggledCall (disabled: the last two are nops), callWithPatch /
+// patchCall, nopPatchableToCall / patchNopToCall and farJumpWithPatch.
+static constexpr size_t kPatchableCallInsns = kLoad32Insns + 2;
+
+// Bytes of stack a helper reserves below sp for a GPR<->FPR transfer area.
+// Keeps sp 16-byte aligned.
+static constexpr int32_t PPCStackTempSize = 16;
+
+static constexpr Register CallReg = r12;
+
+struct ImmTag : public Imm32 {
+  explicit ImmTag(JSValueTag tag) : Imm32(tag) {}
+};
+
+struct ImmType : public ImmTag {
+  explicit ImmType(JSValueType type) : ImmTag(JSVAL_TYPE_TO_TAG(type)) {}
+};
+
+// On NUNBOX32 the tag already lives in its own register: the scratch tag is
+// simply the ValueOperand's type register.
+class ScratchTagScope {
+  const ValueOperand& v_;
+
+ public:
+  ScratchTagScope(Assembler&, const ValueOperand& v) : v_(v) {}
+  operator Register() { return v_.typeReg(); }
+  void release() {}
+  void reacquire() {}
+};
+
+class ScratchTagScopeRelease {
+ public:
+  explicit ScratchTagScopeRelease(ScratchTagScope*) {}
+};
