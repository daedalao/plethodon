index 152b61c05b..a6d970447c 100644
--- a/js/src/jit/MacroAssembler.cpp
+++ b/js/src/jit/MacroAssembler.cpp
@@ -5120,8 +5120,14 @@ void MacroAssembler::passABIArg(Register64 reg) {
     addMove(MoveOperand(reg.high), MoveOperand(HighWord(addr)));
     addMove(MoveOperand(reg.low), MoveOperand(LowWord(addr)));
   } else if (to.isGeneralRegPair()) {
+#if defined(JS_CODEGEN_PPC)
+    // Big-endian: high word in the first register of the pair.
+    addMove(MoveOperand(reg.high), MoveOperand(to.evenReg()));
+    addMove(MoveOperand(reg.low), MoveOperand(to.oddReg()));
+#else
     addMove(MoveOperand(reg.high), MoveOperand(to.oddReg()));
     addMove(MoveOperand(reg.low), MoveOperand(to.evenReg()));
+#endif
   } else {
     MOZ_CRASH("Unsupported move operand");
   }
