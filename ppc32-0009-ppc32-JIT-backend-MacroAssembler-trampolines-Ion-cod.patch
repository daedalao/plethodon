+
+void MacroAssembler::clampIntToUint8(Register reg) {
+  // Branch-free: negative -> 0, > 255 -> 255.
+  as_srawi(r0, reg, 31);
+  as_andc(reg, reg, r0);
+  as_subfic(r0, reg, 255);
+  as_srawi(r0, r0, 31);
+  as_or_(reg, reg, r0);
+  as_andi_rc(reg, reg, 255);
+}
