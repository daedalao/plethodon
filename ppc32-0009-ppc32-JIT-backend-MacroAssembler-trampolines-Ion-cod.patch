+// ===============================================================
+// Typed array atomics, 8/16/32 bit (lwarx/stwcx. in the MacroAssembler).
+
+void CodeGenerator::visitCompareExchangeTypedArrayElement(
+    LCompareExchangeTypedArrayElement* lir) {
+  Register elements = ToRegister(lir->elements());
+  AnyRegister output = ToAnyRegister(lir->output());
+  Register temp = ToTempRegisterOrInvalid(lir->temp0());
+
+  Register oldval = ToRegister(lir->oldval());
+  Register newval = ToRegister(lir->newval());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.compareExchangeJS(arrayType, Synchronization::Full(), dest, oldval,
+                           newval, temp, output);
+  });
+}
+
+void CodeGenerator::visitAtomicExchangeTypedArrayElement(
+    LAtomicExchangeTypedArrayElement* lir) {
+  Register elements = ToRegister(lir->elements());
+  AnyRegister output = ToAnyRegister(lir->output());
+  Register temp = ToTempRegisterOrInvalid(lir->temp0());
+
+  Register value = ToRegister(lir->value());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  dest.match([&](const auto& dest) {
+    masm.atomicExchangeJS(arrayType, Synchronization::Full(), dest, value, temp,
+                          output);
+  });
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinop(
+    LAtomicTypedArrayElementBinop* lir) {
+  MOZ_ASSERT(!lir->mir()->isForEffect());
+
+  AnyRegister output = ToAnyRegister(lir->output());
+  Register elements = ToRegister(lir->elements());
+  Register flagTemp = ToRegister(lir->temp0());
+  Register outTemp = ToTempRegisterOrInvalid(lir->temp1());
+  Register value = ToRegister(lir->value());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto mem = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  mem.match([&](const auto& mem) {
+    masm.atomicFetchOpJS(arrayType, Synchronization::Full(),
+                         lir->mir()->operation(), value, mem, flagTemp, outTemp,
+                         output);
+  });
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinopForEffect(
+    LAtomicTypedArrayElementBinopForEffect* lir) {
+  MOZ_ASSERT(lir->mir()->isForEffect());
+
+  Register elements = ToRegister(lir->elements());
+  Register flagTemp = ToRegister(lir->temp0());
+  Register value = ToRegister(lir->value());
+  Scalar::Type arrayType = lir->mir()->arrayType();
+
+  auto mem = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+
+  mem.match([&](const auto& mem) {
+    masm.atomicEffectOpJS(arrayType, Synchronization::Full(),
+                          lir->mir()->operation(), value, mem, flagTemp);
+  });
+}
+
+// ===============================================================
+// Typed array atomics, 64 bit.
+//
+// The G4 has no 64-bit atomic instructions (no ldarx/stdcx.), so BigInt64
+// atomics call these helpers, which go through js::jit::AtomicOperations like
+// the interpreter does. All arguments are 32-bit words so that the SysV
+// register assignment is trivial (no aligned int64 register pairs); int64
+// results come back in r3 (high) : r4 (low).
+
+static inline int64_t Ppc32JoinInt64(uint32_t hi, uint32_t lo) {
+  return int64_t((uint64_t(hi) << 32) | uint64_t(lo));
+}
+
+static inline SharedMem<int64_t*> Ppc32AtomicCell64(void* addr) {
+  return SharedMem<int64_t*>::shared(addr);
+}
+
+static int64_t Ppc32AtomicLoad64(void* addr) {
+  return AtomicOperations::loadSeqCst(Ppc32AtomicCell64(addr));
+}
+
+static void Ppc32AtomicStore64(void* addr, uint32_t hi, uint32_t lo) {
+  AtomicOperations::storeSeqCst(Ppc32AtomicCell64(addr),
+                                Ppc32JoinInt64(hi, lo));
+}
+
+static int64_t Ppc32AtomicExchange64(void* addr, uint32_t hi, uint32_t lo) {
+  return AtomicOperations::exchangeSeqCst(Ppc32AtomicCell64(addr),
+                                          Ppc32JoinInt64(hi, lo));
+}
+
+static int64_t Ppc32AtomicCompareExchange64(void* addr, uint32_t oldHi,
+                                            uint32_t oldLo, uint32_t newHi,
+                                            uint32_t newLo) {
+  return AtomicOperations::compareExchangeSeqCst(Ppc32AtomicCell64(addr),
+                                                 Ppc32JoinInt64(oldHi, oldLo),
+                                                 Ppc32JoinInt64(newHi, newLo));
+}
+
+static int64_t Ppc32AtomicFetchAdd64(void* addr, uint32_t hi, uint32_t lo) {
+  return AtomicOperations::fetchAddSeqCst(Ppc32AtomicCell64(addr),
+                                          Ppc32JoinInt64(hi, lo));
+}
+
+static int64_t Ppc32AtomicFetchSub64(void* addr, uint32_t hi, uint32_t lo) {
+  return AtomicOperations::fetchSubSeqCst(Ppc32AtomicCell64(addr),
+                                          Ppc32JoinInt64(hi, lo));
+}
+
+static int64_t Ppc32AtomicFetchAnd64(void* addr, uint32_t hi, uint32_t lo) {
+  return AtomicOperations::fetchAndSeqCst(Ppc32AtomicCell64(addr),
+                                          Ppc32JoinInt64(hi, lo));
+}
+
+static int64_t Ppc32AtomicFetchOr64(void* addr, uint32_t hi, uint32_t lo) {
+  return AtomicOperations::fetchOrSeqCst(Ppc32AtomicCell64(addr),
+                                         Ppc32JoinInt64(hi, lo));
+}
+
+static int64_t Ppc32AtomicFetchXor64(void* addr, uint32_t hi, uint32_t lo) {
+  return AtomicOperations::fetchXorSeqCst(Ppc32AtomicCell64(addr),
+                                          Ppc32JoinInt64(hi, lo));
+}
+
+static void* Ppc32AtomicFetchOp64Helper(AtomicOp op) {
+  switch (op) {
+    case AtomicOp::Add:
+      return JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicFetchAdd64);
+    case AtomicOp::Sub:
+      return JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicFetchSub64);
+    case AtomicOp::And:
+      return JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicFetchAnd64);
+    case AtomicOp::Or:
+      return JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicFetchOr64);
+    case AtomicOp::Xor:
+      return JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicFetchXor64);
+  }
+  MOZ_CRASH("unexpected AtomicOp");
+}
+
+template <typename T>
+void CodeGeneratorPPC::computeAtomic64Address(const T& mem, Register dest) {
+  masm.computeEffectiveAddress(mem, dest);
+}
+
+// |out| receives the int64 result if |hasResult|; otherwise it is a free
+// register pair. out.high serves as the ABI-call scratch register, so it must
+// not be one of |args|.
+void CodeGeneratorPPC::emitAtomic64Call(LInstruction* ins, void* fun,
+                                        std::initializer_list<Register> args,
+                                        Register64 out, bool hasResult) {
+  MOZ_ASSERT(out.high != InvalidReg && out.low != InvalidReg);
+
+  // Not a call instruction for the register allocator: preserve every live
+  // volatile register except the result.
+  LiveRegisterSet volatileRegs = liveVolatileRegs(ins);
+  if (hasResult) {
+    volatileRegs.takeUnchecked(out.high);
+    volatileRegs.takeUnchecked(out.low);
+  }
+  masm.PushRegsInMask(volatileRegs);
+
+  Register abiScratch = out.high;
+#ifdef DEBUG
+  for (Register r : args) {
+    MOZ_ASSERT(r != abiScratch);
+  }
+#endif
+  masm.setupUnalignedABICall(abiScratch);
+  for (Register r : args) {
+    masm.passABIArg(r);
+  }
+  masm.callWithABI(DynFn{fun}, hasResult ? ABIType::Int64 : ABIType::General,
+                   CheckUnsafeCallWithABI::DontCheckOther);
+
+  if (hasResult) {
+    // Move r3 (high) : r4 (low) into |out|, which may overlap them.
+    Register retHi = ReturnReg64.high;
+    Register retLo = ReturnReg64.low;
+    if (out.low == retHi && out.high == retLo) {
+      masm.xs_mr(r0, retHi);
+      masm.xs_mr(retHi, retLo);
+      masm.xs_mr(retLo, r0);
+    } else if (out.low == retHi) {
+      // out.high is neither r3 nor r4: read r3 before overwriting it.
+      masm.xs_mr(out.high, retHi);
+      masm.xs_mr(out.low, retLo);
+    } else {
+      // out.low != r3: writing it cannot clobber the high half.
+      PpcMoveReg(masm, retLo, out.low);
+      PpcMoveReg(masm, retHi, out.high);
+    }
+  }
+
+  masm.PopRegsInMask(volatileRegs);
+}
+
+void CodeGenerator::visitAtomicLoad64(LAtomicLoad64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 out = ToOutRegister64(lir);
+
+  Scalar::Type storageType = lir->mir()->storageType();
+  auto source = ToAddressOrBaseIndex(elements, lir->index(), storageType);
+  source.match(
+      [&](const auto& source) { computeAtomic64Address(source, out.low); });
+
+  emitAtomic64Call(lir, JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicLoad64),
+                   {out.low}, out, true);
+}
+
+void CodeGenerator::visitAtomicStore64(LAtomicStore64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 temp = ToRegister64(lir->temp0());
+
+  Scalar::Type writeType = lir->mir()->writeType();
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), writeType);
+  dest.match([&](const auto& dest) { computeAtomic64Address(dest, temp.low); });
+
+  // No result; temp.high is the ABI scratch register.
+  emitAtomic64Call(lir, JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicStore64),
+                   {temp.low, value.high, value.low}, temp, false);
+}
+
+void CodeGenerator::visitCompareExchangeTypedArrayElement64(
+    LCompareExchangeTypedArrayElement64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 oldval = ToRegister64(lir->oldval());
+  Register64 newval = ToRegister64(lir->newval());
+  Register64 out = ToOutRegister64(lir);
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+  dest.match([&](const auto& dest) { computeAtomic64Address(dest, out.low); });
+
+  emitAtomic64Call(
+      lir, JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicCompareExchange64),
+      {out.low, oldval.high, oldval.low, newval.high, newval.low}, out, true);
+}
+
+void CodeGenerator::visitAtomicExchangeTypedArrayElement64(
+    LAtomicExchangeTypedArrayElement64* lir) {
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 out = ToOutRegister64(lir);
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+  dest.match([&](const auto& dest) { computeAtomic64Address(dest, out.low); });
+
+  emitAtomic64Call(lir, JS_FUNC_TO_DATA_PTR(void*, Ppc32AtomicExchange64),
+                   {out.low, value.high, value.low}, out, true);
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinop64(
+    LAtomicTypedArrayElementBinop64* lir) {
+  MOZ_ASSERT(!lir->mir()->isForEffect());
+
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 out = ToOutRegister64(lir);
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  AtomicOp atomicOp = lir->mir()->operation();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+  dest.match([&](const auto& dest) { computeAtomic64Address(dest, out.low); });
+
+  emitAtomic64Call(lir, Ppc32AtomicFetchOp64Helper(atomicOp),
+                   {out.low, value.high, value.low}, out, true);
+}
+
+void CodeGenerator::visitAtomicTypedArrayElementBinopForEffect64(
+    LAtomicTypedArrayElementBinopForEffect64* lir) {
+  MOZ_ASSERT(lir->mir()->isForEffect());
+
+  Register elements = ToRegister(lir->elements());
+  Register64 value = ToRegister64(lir->value());
+  Register64 temp = ToRegister64(lir->temp0());
+
+  Scalar::Type arrayType = lir->mir()->arrayType();
+  AtomicOp atomicOp = lir->mir()->operation();
+
+  auto dest = ToAddressOrBaseIndex(elements, lir->index(), arrayType);
+  dest.match([&](const auto& dest) { computeAtomic64Address(dest, temp.low); });
+
+  // The fetched value is discarded.
+  emitAtomic64Call(lir, Ppc32AtomicFetchOp64Helper(atomicOp),
+                   {temp.low, value.high, value.low}, temp, false);
+}
