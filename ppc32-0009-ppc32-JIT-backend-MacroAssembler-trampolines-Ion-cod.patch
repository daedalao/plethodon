+// ===============================================================
+// Patchable decrement (sub32FromMemAndBranchIfNegativeWithPatch).
+
+CodeOffset MacroAssembler::sub32FromMemAndBranchIfNegativeWithPatch(
+    Address address, Label* label) {
+  UseScratchRegisterScope temps(*this);
+  Register scratch = temps.Acquire();
+  MOZ_ASSERT(scratch != address.base);
+  load32(address, scratch);
+  // Placeholder addi, patched to subtract the real amount.
+  as_addi(scratch, scratch, 128);
+  CodeOffset patchPoint = CodeOffset(currentOffset());
+  store32(scratch, address);
+  as_cmpwi(scratch, 0);
+  ma_b(LessThan, label);
+  return patchPoint;
+}
+
+void MacroAssembler::patchSub32FromMemAndBranchIfNegative(CodeOffset offset,
+                                                          Imm32 imm) {
+  int32_t val = imm.value;
+  MOZ_RELEASE_ASSERT(val >= 1 && val <= 127);
+  // The addi is the instruction just before |offset|.
+  Instruction* inst = editSrc(BufferOffset(offset.offset() - 4));
+  MOZ_ASSERT(inst->isOpcode(PPC_addi));
+  inst->setData((inst->encode() & 0xffff0000) | uint16_t(-val & 0xffff));
+}
