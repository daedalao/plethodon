+}
+
+void MacroAssembler::rshift64(Imm32 imm, Register64 dest) {
+  MOZ_ASSERT(0 <= imm.value && imm.value < 64);
+  uint32_t n = uint32_t(imm.value);
+  if (n == 0) {
+    return;
+  }
+  if (n < 32) {
+    // low = (low >> n) | (high << (32 - n)); high >>= n.
+    as_rlwinm(dest.low, dest.low, 32 - n, n, 31);
+    as_rlwimi(dest.low, dest.high, 32 - n, 0, n - 1);
+    as_rlwinm(dest.high, dest.high, 32 - n, n, 31);
+    return;
+  }
+  PPC32Srwi(*this, dest.low, dest.high, n - 32);
+  xs_li(dest.high, 0);
+}
+
+void MacroAssembler::rshift64(Register unmaskedShift, Register64 dest) {
+  // Mirror of lshift64(Register):
+  //   low  = (low >> s) | (high << (32 - s)) | (high >> (s - 32))
+  //   high = high >> s
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  Register t = temps.Acquire();
+  as_rlwinm(s, unmaskedShift, 0, 26, 31);
+  as_subfic(t, s, 32);
+  as_srw(dest.low, dest.low, s);
+  as_slw(r0, dest.high, t);
+  as_or_(dest.low, dest.low, r0);
+  as_addi(t, s, -32);
+  as_srw(r0, dest.high, t);
+  as_or_(dest.low, dest.low, r0);
+  as_srw(dest.high, dest.high, s);
+}
