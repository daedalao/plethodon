+  void loadValue(const Address& src, ValueOperand val) {
+    // Load the half that does not overwrite the base register first.
+    Address payload = ToPayload(src);
+    Address type = ToType(src);
+    if (src.base != val.payloadReg()) {
+      load32(payload, val.payloadReg());
+      load32(type, val.typeReg());
+    } else {
+      MOZ_ASSERT(src.base != val.typeReg());
+      load32(type, val.typeReg());
+      load32(payload, val.payloadReg());
