+  // Compare a tag register against a tag and branch. Tags are small
+  // negative numbers (JSVAL_TAG_CLEAR | type), so this is cmpwi + bc.
+  void branchTestTag(Condition cond, Register tagReg, ImmTag tag,
+                     Label* label) {
+    MOZ_ASSERT(cond == Equal || cond == NotEqual);
+    ma_b(ma_cmp(tagReg, tag, cond), label);
+  }
