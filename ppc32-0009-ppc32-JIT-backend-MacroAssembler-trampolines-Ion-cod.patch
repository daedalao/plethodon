+void MacroAssembler::branch8(Condition cond, const Address& lhs, Imm32 rhs,
+                             Label* label) {
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  Imm32 imm = PPC32LoadNarrow(*this, cond, lhs, rhs, s, 1);
+  condBranchToLabel(PPC32CmpReg(*this, cond, s, imm), label);
+}
+
+void MacroAssembler::branch8(Condition cond, const BaseIndex& lhs, Register rhs,
+                             Label* label) {
+  bool isSigned;
+  switch (cond) {
+    case Assembler::Equal:
+    case Assembler::NotEqual:
+    case Assembler::Above:
+    case Assembler::AboveOrEqual:
+    case Assembler::Below:
+    case Assembler::BelowOrEqual:
+      isSigned = false;
+      break;
+    case Assembler::GreaterThan:
+    case Assembler::GreaterThanOrEqual:
+    case Assembler::LessThan:
+    case Assembler::LessThanOrEqual:
+      isSigned = true;
+      break;
+    default:
+      MOZ_CRASH("unexpected condition");
+  }
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  PPC32Access(*this, PPC32Mem::Lbz, s, lhs);
+  if (isSigned) {
+    as_extsb(s, s);
+  }
+  condBranchToLabel(PPC32CmpReg(*this, cond, s, rhs), label);
+}
