diff --git a/js/src/jit/ppc/MacroAssembler-ppc-inl.h b/js/src/jit/ppc/MacroAssembler-ppc-inl.h
new file mode 100644
index 0000000000..cf3eb5c4ad
--- /dev/null
+++ b/js/src/jit/ppc/MacroAssembler-ppc-inl.h
@@ -0,0 +1,3623 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*-
+ * vim: set ts=8 sts=2 et sw=2 tw=80:
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_ppc_MacroAssembler_ppc_inl_h
+#define jit_ppc_MacroAssembler_ppc_inl_h
+
+#include <cmath>
+#include <type_traits>
+#include <utility>
+
+#include "jit/ppc/MacroAssembler-ppc.h"
+
+// 32-bit PowerPC (G4) inline MacroAssembler methods.
+//
+// Conventions used throughout this file:
+//  - Pointers and "Ptr" operations are 32-bit; Register64 is a (high, low)
+//    pair. In memory, int64 and Value halves are big-endian: high word / tag
+//    at offset 0, low word / payload at offset 4 (use HighWord/LowWord and
+//    NUNBOX32_{TYPE,PAYLOAD}_OFFSET, never literal offsets).
+//  - Scratch registers: r11/r12 through UseScratchRegisterScope, plus r0 as a
+//    private computational temp. r0 is never used as the RA operand of a
+//    D-form access or of addi/addis (it reads as zero there), and is never
+//    live across a call into another MacroAssembler helper.
+//  - Compares set CR0. Every helper that returns a Condition returns a plain
+//    CR0 condition (the Unsigned/Zero flags already consumed by the compare).
+//  - The G4 has no isel: conditional moves branch over a short, pool-free
+//    instruction run (PPC32SkipIf); Spectre masks are computed branch-free
+//    from CR0 with mfcr.
+
+namespace js {
+namespace jit {
+
+// ===============================================================
+// Local helpers (not MacroAssembler methods).
+
+static inline bool PPC32IsInt16(int32_t v) { return v >= -32768 && v <= 32767; }
+static inline bool PPC32IsUint16(int32_t v) {
+  return (uint32_t(v) & 0xffff0000u) == 0;
+}
+static inline int16_t PPC32Lo(int32_t v) {
+  return int16_t(uint16_t(uint32_t(v) & 0xffff));
+}
+// High half adjusted for the sign of the low half: (ha << 16) + lo == v.
+static inline int16_t PPC32Ha(int32_t v) {
+  return int16_t(uint16_t((uint32_t(v) + 0x8000u) >> 16));
+}
+
+// Strip the Unsigned/Zero flags: the compare has been emitted, only the CR0
+// bit test remains.
+static inline Assembler::Condition PPC32Base(Assembler::Condition cond) {
+  MOZ_ASSERT(!(uint32_t(cond) & Assembler::ConditionOnlyXER));
+  return Assembler::Condition(uint32_t(cond) & ~(Assembler::ConditionUnsigned |
+                                                 Assembler::ConditionZero));
+}
+
+// Invert a plain CR0 condition (flip the branch-on-set/clear BO bit).
+static inline Assembler::Condition PPC32Invert(Assembler::Condition cond) {
+  return Assembler::Condition(uint32_t(PPC32Base(cond)) ^
+                              Assembler::BranchOptionInvert);
+}
+
+// dest = v, in one or two instructions (li, or lis [+ ori]). dest may be r0.
+static inline void PPC32LoadImm(MacroAssembler& masm, Register dest,
+                                int32_t v) {
+  if (PPC32IsInt16(v)) {
+    masm.xs_li(dest, int16_t(v));
+    return;
+  }
+  masm.xs_lis(dest, int16_t(uint16_t(uint32_t(v) >> 16)));
+  if (v & 0xffff) {
+    masm.as_ori(dest, dest, uint16_t(uint32_t(v) & 0xffff));
+  }
+}
+
+// dest = src + v for any 32-bit v. src must not be r0; dest must not be r0
+// when two instructions are needed.
+static inline void PPC32AddImm(MacroAssembler& masm, Register dest,
+                               Register src, int32_t v) {
+  MOZ_ASSERT(src != r0);
+  if (PPC32IsInt16(v)) {
+    if (v != 0) {
+      masm.as_addi(dest, src, int16_t(v));
+    } else if (dest != src) {
+      masm.xs_mr(dest, src);
+    }
+    return;
+  }
+  masm.as_addis(dest, src, PPC32Ha(v));
+  if (PPC32Lo(v) != 0) {
+    MOZ_ASSERT(dest != r0);
+    masm.as_addi(dest, dest, PPC32Lo(v));
+  }
+}
+
+// Immediate shifts; the rlwinm forms cannot encode a zero shift for srwi.
+static inline void PPC32Slwi(MacroAssembler& masm, Register dest, Register src,
+                             uint32_t n) {
+  MOZ_ASSERT(n < 32);
+  if (n == 0) {
+    if (dest != src) {
+      masm.xs_mr(dest, src);
+    }
+    return;
+  }
+  masm.as_rlwinm(dest, src, n, 0, 31 - n);
+}
+static inline void PPC32Srwi(MacroAssembler& masm, Register dest, Register src,
+                             uint32_t n) {
+  MOZ_ASSERT(n < 32);
+  if (n == 0) {
+    if (dest != src) {
+      masm.xs_mr(dest, src);
+    }
+    return;
+  }
+  masm.as_rlwinm(dest, src, 32 - n, n, 31);
+}
+
+// If |mask| is a single contiguous run of ones (not 0, not ~0), set the
+// big-endian rlwinm MB/ME bounds and return true.
+static inline bool PPC32ContigMask(uint32_t mask, uint32_t* mb, uint32_t* me) {
+  if (mask == 0 || mask == 0xffffffffu) {
+    return false;
+  }
+  uint32_t tz = uint32_t(__builtin_ctz(mask));
+  uint32_t shifted = mask >> tz;
+  if ((shifted & (shifted + 1)) != 0) {
+    return false;
+  }
+  uint32_t width = 32 - uint32_t(__builtin_clz(shifted));
+  *mb = 32 - tz - width;
+  *me = 31 - tz;
+  return true;
+}
+
+// Branch over the next |n| instructions when |cond| holds in CR0. Constant
+// pools are inhibited over the run so the fixed displacement stays valid;
+// the run must consist of raw instructions only.
+class MOZ_RAII PPC32SkipIf {
+  MacroAssembler& masm_;
+  uint32_t start_;
+  uint32_t n_;
+
+ public:
+  PPC32SkipIf(MacroAssembler& masm, Assembler::Condition cond, uint32_t n)
+      : masm_(masm), n_(n) {
+    MOZ_ASSERT(n > 0 && n < 64);
+    masm_.enterNoPool(n + 1);
+    masm_.as_bc(int16_t(4 * (n + 1)), PPC32Base(cond));
+    start_ = masm_.currentOffset();
+  }
+  ~PPC32SkipIf() {
+    MOZ_ASSERT(masm_.oom() || masm_.currentOffset() - start_ == 4 * n_);
+    masm_.leaveNoPool();
+  }
+};
+
+// dest = (CR0 satisfies |cond|) ? 1 : 0, branch-free. dest may be r0.
+static inline void PPC32SetFromCR0(MacroAssembler& masm,
+                                   Assembler::Condition cond, Register dest) {
+  uint32_t c = uint32_t(PPC32Base(cond));
+  uint32_t bit = (c >> 4) & 3;
+  masm.as_mfcr(dest);
+  masm.as_rlwinm(dest, dest, bit + 1, 31, 31);
+  if ((c & Assembler::BranchOptionMask) == Assembler::BranchOnClear) {
+    masm.as_xori(dest, dest, 1);
+  }
+}
+
+// dest = (CR0 satisfies |cond|) ? ~0 : 0, branch-free (Spectre masks).
+static inline void PPC32MaskFromCR0(MacroAssembler& masm,
+                                    Assembler::Condition cond, Register dest) {
+  PPC32SetFromCR0(masm, cond, dest);
+  masm.as_neg(dest, dest);
+}
+
+// ---------------------------------------------------------------
+// Memory access.
+
+enum class PPC32Mem : uint8_t { Lwz, Lbz, Lhz, Lha, Stw, Stb, Sth };
+enum class PPC32FMem : uint8_t { Lfd, Lfs, Stfd, Stfs };
+
+static inline bool PPC32IsLoad(PPC32Mem op) {
+  return op == PPC32Mem::Lwz || op == PPC32Mem::Lbz || op == PPC32Mem::Lhz ||
+         op == PPC32Mem::Lha;
+}
+
+static inline BufferOffset PPC32MemD(MacroAssembler& masm, PPC32Mem op,
+                                     Register rt, Register ra, int16_t d) {
+  MOZ_ASSERT(ra != r0);
+  switch (op) {
+    case PPC32Mem::Lwz:
+      return masm.as_lwz(rt, ra, d);
+    case PPC32Mem::Lbz:
+      return masm.as_lbz(rt, ra, d);
+    case PPC32Mem::Lhz:
+      return masm.as_lhz(rt, ra, d);
+    case PPC32Mem::Lha:
+      return masm.as_lha(rt, ra, d);
+    case PPC32Mem::Stw:
+      return masm.as_stw(rt, ra, d);
+    case PPC32Mem::Stb:
+      return masm.as_stb(rt, ra, d);
+    case PPC32Mem::Sth:
+      return masm.as_sth(rt, ra, d);
+  }
+  MOZ_CRASH("bad PPC32Mem");
+}
+
+static inline BufferOffset PPC32MemX(MacroAssembler& masm, PPC32Mem op,
+                                     Register rt, Register ra, Register rb) {
+  MOZ_ASSERT(ra != r0);
+  switch (op) {
+    case PPC32Mem::Lwz:
+      return masm.as_lwzx(rt, ra, rb);
+    case PPC32Mem::Lbz:
+      return masm.as_lbzx(rt, ra, rb);
+    case PPC32Mem::Lhz:
+      return masm.as_lhzx(rt, ra, rb);
+    case PPC32Mem::Lha:
+      return masm.as_lhax(rt, ra, rb);
+    case PPC32Mem::Stw:
+      return masm.as_stwx(rt, ra, rb);
+    case PPC32Mem::Stb:
+      return masm.as_stbx(rt, ra, rb);
+    case PPC32Mem::Sth:
+      return masm.as_sthx(rt, ra, rb);
+  }
+  MOZ_CRASH("bad PPC32Mem");
+}
+
+static inline BufferOffset PPC32FMemD(MacroAssembler& masm, PPC32FMem op,
+                                      FloatRegister ft, Register ra,
+                                      int16_t d) {
+  MOZ_ASSERT(ra != r0);
+  switch (op) {
+    case PPC32FMem::Lfd:
+      return masm.as_lfd(ft, ra, d);
+    case PPC32FMem::Lfs:
+      return masm.as_lfs(ft, ra, d);
+    case PPC32FMem::Stfd:
+      return masm.as_stfd(ft, ra, d);
+    case PPC32FMem::Stfs:
+      return masm.as_stfs(ft, ra, d);
+  }
+  MOZ_CRASH("bad PPC32FMem");
+}
+
+static inline BufferOffset PPC32FMemX(MacroAssembler& masm, PPC32FMem op,
+                                      FloatRegister ft, Register ra,
+                                      Register rb) {
+  MOZ_ASSERT(ra != r0);
+  switch (op) {
+    case PPC32FMem::Lfd:
+      return masm.as_lfdx(ft, ra, rb);
+    case PPC32FMem::Lfs:
+      return masm.as_lfsx(ft, ra, rb);
+    case PPC32FMem::Stfd:
+      return masm.as_stfdx(ft, ra, rb);
+    case PPC32FMem::Stfs:
+      return masm.as_stfsx(ft, ra, rb);
+  }
+  MOZ_CRASH("bad PPC32FMem");
+}
+
+// Instructions a GPR load from |addr| takes when the loaded register serves
+// as its own address temp (see PPC32Access).
+static inline uint32_t PPC32LoadLength(const Address& addr) {
+  return PPC32IsInt16(addr.offset) ? 1 : 2;
+}
+
+// GPR access through base+offset. Loads use |rt| as the temp for an
+// out-of-range offset (addis rt, base, ha; lwz rt, lo(rt)); stores, and
+// loads into r0, take a scratch register.
+static inline BufferOffset PPC32Access(MacroAssembler& masm, PPC32Mem op,
+                                       Register rt, const Address& addr) {
+  if (PPC32IsInt16(addr.offset)) {
+    return PPC32MemD(masm, op, rt, addr.base, int16_t(addr.offset));
+  }
+  if (PPC32IsLoad(op) && rt != r0) {
+    masm.as_addis(rt, addr.base, PPC32Ha(addr.offset));
+    return PPC32MemD(masm, op, rt, rt, PPC32Lo(addr.offset));
+  }
+  UseScratchRegisterScope temps(masm);
+  Register t = temps.Acquire();
+  masm.as_addis(t, addr.base, PPC32Ha(addr.offset));
+  return PPC32MemD(masm, op, rt, t, PPC32Lo(addr.offset));
+}
+
+// Emit an access at base + (index << scale) + offset using temp |t| (not r0).
+template <typename Emit>
+static inline BufferOffset PPC32IndexedAccess(MacroAssembler& masm,
+                                              const BaseIndex& addr, Register t,
+                                              Emit emit) {
+  MOZ_ASSERT(t != r0);
+  uint32_t shift = Imm32::ShiftOf(addr.scale).value;
+  if (addr.offset == 0) {
+    MOZ_ASSERT(shift != 0);
+    PPC32Slwi(masm, t, addr.index, shift);
+    return emit(addr.base, t, true, 0);
+  }
+  if (shift != 0) {
+    PPC32Slwi(masm, t, addr.index, shift);
+    masm.as_add(t, addr.base, t);
+  } else {
+    masm.as_add(t, addr.base, addr.index);
+  }
+  if (PPC32IsInt16(addr.offset)) {
+    return emit(t, InvalidReg, false, int16_t(addr.offset));
+  }
+  masm.as_addis(t, t, PPC32Ha(addr.offset));
+  return emit(t, InvalidReg, false, PPC32Lo(addr.offset));
+}
+
+static inline BufferOffset PPC32Access(MacroAssembler& masm, PPC32Mem op,
+                                       Register rt, const BaseIndex& addr) {
+  uint32_t shift = Imm32::ShiftOf(addr.scale).value;
+  if (shift == 0 && addr.offset == 0) {
+    return PPC32MemX(masm, op, rt, addr.base, addr.index);
+  }
+  auto emit = [&](Register ra, Register rb, bool indexed, int16_t d) {
+    return indexed ? PPC32MemX(masm, op, rt, ra, rb)
+                   : PPC32MemD(masm, op, rt, ra, d);
+  };
+  if (PPC32IsLoad(op) && rt != r0 && rt != addr.base) {
+    return PPC32IndexedAccess(masm, addr, rt, emit);
+  }
+  UseScratchRegisterScope temps(masm);
+  return PPC32IndexedAccess(masm, addr, temps.Acquire(), emit);
+}
+
+static inline BufferOffset PPC32FAccess(MacroAssembler& masm, PPC32FMem op,
+                                        FloatRegister ft, const Address& addr) {
+  if (PPC32IsInt16(addr.offset)) {
+    return PPC32FMemD(masm, op, ft, addr.base, int16_t(addr.offset));
+  }
+  UseScratchRegisterScope temps(masm);
+  Register t = temps.Acquire();
+  masm.as_addis(t, addr.base, PPC32Ha(addr.offset));
+  return PPC32FMemD(masm, op, ft, t, PPC32Lo(addr.offset));
+}
+
+static inline BufferOffset PPC32FAccess(MacroAssembler& masm, PPC32FMem op,
+                                        FloatRegister ft,
+                                        const BaseIndex& addr) {
+  uint32_t shift = Imm32::ShiftOf(addr.scale).value;
+  if (shift == 0 && addr.offset == 0) {
+    return PPC32FMemX(masm, op, ft, addr.base, addr.index);
+  }
+  auto emit = [&](Register ra, Register rb, bool indexed, int16_t d) {
+    return indexed ? PPC32FMemX(masm, op, ft, ra, rb)
+                   : PPC32FMemD(masm, op, ft, ra, d);
+  };
+  UseScratchRegisterScope temps(masm);
+  return PPC32IndexedAccess(masm, addr, temps.Acquire(), emit);
+}
+
+// 32-bit word loads into |dest| from the supported memory operand kinds.
+static inline void PPC32LoadWord(MacroAssembler& masm, Register dest,
+                                 const Address& addr) {
+  PPC32Access(masm, PPC32Mem::Lwz, dest, addr);
+}
+static inline void PPC32LoadWord(MacroAssembler& masm, Register dest,
+                                 const BaseIndex& addr) {
+  PPC32Access(masm, PPC32Mem::Lwz, dest, addr);
+}
+static inline void PPC32LoadWord(MacroAssembler& masm, Register dest,
+                                 const AbsoluteAddress& addr) {
+  int32_t a = int32_t(uintptr_t(addr.addr));
+  if (dest != r0) {
+    masm.xs_lis(dest, PPC32Ha(a));
+    masm.as_lwz(dest, dest, PPC32Lo(a));
+    return;
+  }
+  UseScratchRegisterScope temps(masm);
+  Register t = temps.Acquire();
+  masm.xs_lis(t, PPC32Ha(a));
+  masm.as_lwz(dest, t, PPC32Lo(a));
+}
+
+// Stores |src| to an absolute address (needs a scratch register).
+static inline void PPC32StoreWord(MacroAssembler& masm, Register src,
+                                  const AbsoluteAddress& addr) {
+  int32_t a = int32_t(uintptr_t(addr.addr));
+  UseScratchRegisterScope temps(masm);
+  Register t = temps.Acquire();
+  masm.xs_lis(t, PPC32Ha(a));
+  masm.as_stw(src, t, PPC32Lo(a));
+}
+
+// ---------------------------------------------------------------
+// FPR <-> GPR transfers. The G4 has no direct moves between the register
+// files and the SysV PPC32 ABI has no red zone, so allocate a 16-byte frame
+// (stwu keeps the back chain valid) and use its 8-byte slot at 8(sp).
+
+static constexpr int16_t PPC32XferSlot = 8;
+
+static inline void PPC32XferBegin(MacroAssembler& masm) {
+  masm.as_stwu(StackPointer, StackPointer, -16);
+}
+static inline void PPC32XferEnd(MacroAssembler& masm) {
+  masm.as_addi(StackPointer, StackPointer, 16);
+}
+
+// dest = trunc(src) saturated to int32 (NaN -> INT32_MIN). Clobbers f0.
+static inline void PPC32TruncToInt32(MacroAssembler& masm, FloatRegister src,
+                                     Register dest) {
+  masm.as_fctiwz(ScratchDoubleReg, src);
+  PPC32XferBegin(masm);
+  masm.as_stfd(ScratchDoubleReg, StackPointer, PPC32XferSlot);
+  // Big-endian: the integer result is the low word of the stored image.
+  masm.as_lwz(dest, StackPointer, PPC32XferSlot + 4);
+  PPC32XferEnd(masm);
+}
+
+// Branch to |fail| when |dest| (a fctiwz result) is INT32_MAX or INT32_MIN,
+// i.e. when the conversion may have saturated or the input was NaN.
+static inline void PPC32BranchIfSaturated(MacroAssembler& masm, Register dest,
+                                          Label* fail) {
+  // (dest ^ 0x80000000) + 1 is 0 for INT32_MAX and 1 for INT32_MIN.
+  masm.as_xoris(r0, dest, 0x8000);
+  masm.as_addic(r0, r0, 1);
+  masm.as_cmplwi(r0, 1);
+  masm.condBranchToLabel(Assembler::LessThanOrEqual, fail);
+}
+
+// ---------------------------------------------------------------
+// Out-of-line libm calls from inline code (the G4 has no fsqrt).
+
+// Correctly rounded square root via the C library. The G4 build never
+// enables -mpowerpc-gpopt, so this compiles to a libm call, not fsqrt.
+inline double PPC32SqrtHelper(double x) { return std::sqrt(x); }
+
+// dest = fn(src) for a C function double(double), preserving every volatile
+// GPR (r3-r12), every volatile FPR except f0 (f1-f13), CR and LR, so it can
+// be used where the caller has not saved live registers. Clobbers r0, CTR,
+// XER and f0 (unless dest is f0, f0 holds nothing afterwards).
+static inline void PPC32CallDoubleFunction(MacroAssembler& masm, void* fn,
+                                           FloatRegister src,
+                                           FloatRegister dest) {
+  constexpr int16_t LrSlot = 8;
+  constexpr int16_t CrSlot = 12;
+  constexpr int16_t GprSlot = 16;  // r3..r12: 40 bytes
+  constexpr int16_t FprSlot = 56;  // f1..f13: 104 bytes, 8-aligned
+  constexpr int16_t FrameSize = 160;
+  static_assert(FprSlot + 13 * 8 <= FrameSize && FrameSize % 16 == 0);
+
+  static constexpr FloatRegister fprs[] = {f1, f2, f3,  f4,  f5,  f6, f7,
+                                           f8, f9, f10, f11, f12, f13};
+
+  // New frame, 16-byte aligned (the JIT stack may only be 4/8-aligned), with
+  // a valid back chain: r0 = align16(sp - FrameSize) - sp; stwux sp, sp, r0.
+  masm.as_addi(r0, StackPointer, -FrameSize);
+  masm.as_rlwinm(r0, r0, 0, 0, 27);
+  masm.as_subf(r0, StackPointer, r0);
+  masm.as_stwux(StackPointer, StackPointer, r0);
+
+  masm.xs_mflr(r0);
+  masm.as_stw(r0, StackPointer, LrSlot);
+  masm.as_mfcr(r0);
+  masm.as_stw(r0, StackPointer, CrSlot);
+  for (uint32_t i = 3; i <= 12; i++) {
+    masm.as_stw(Register::FromCode(i), StackPointer,
+                int16_t(GprSlot + 4 * (i - 3)));
+  }
+  for (uint32_t i = 0; i < 13; i++) {
+    masm.as_stfd(fprs[i], StackPointer, int16_t(FprSlot + 8 * i));
+  }
+
+  if (src.encoding() != f1.encoding()) {
+    masm.as_fmr(f1, src);
+  }
+  int32_t target = int32_t(uintptr_t(fn));
+  masm.xs_lis(r12, int16_t(uint16_t(uint32_t(target) >> 16)));
+  masm.as_ori(r12, r12, uint16_t(uint32_t(target) & 0xffff));
+  masm.xs_mtctr(r12);
+  masm.as_bctr(Assembler::LinkB);
+  masm.as_fmr(ScratchDoubleReg, f1);
+
+  for (uint32_t i = 0; i < 13; i++) {
+    masm.as_lfd(fprs[i], StackPointer, int16_t(FprSlot + 8 * i));
+  }
+  for (uint32_t i = 3; i <= 12; i++) {
+    masm.as_lwz(Register::FromCode(i), StackPointer,
+                int16_t(GprSlot + 4 * (i - 3)));
+  }
+  masm.as_lwz(r0, StackPointer, CrSlot);
+  masm.as_mtcrf(0xff, r0);
+  masm.as_lwz(r0, StackPointer, LrSlot);
+  masm.xs_mtlr(r0);
+  masm.as_lwz(StackPointer, StackPointer, 0);
+
+  if (dest.encoding() != ScratchDoubleReg.encoding()) {
+    masm.as_fmr(dest, ScratchDoubleReg);
+  }
+}
+
+// ---------------------------------------------------------------
+// Integer compares. PPC32Cmp emits a 32-bit compare of lhs with rhs into CR0
+// and returns the plain CR0 condition that represents |cond|.
+//
+// Zero/NonZero compare lhs and rhs for (in)equality; Signed/NotSigned test
+// the sign of lhs - rhs (x86 flag semantics after cmp).
+
+static inline Assembler::Condition PPC32CmpReg(MacroAssembler& masm,
+                                               Assembler::Condition cond,
+                                               Register lhs, Register rhs) {
+  uint32_t c = uint32_t(cond);
+  if (c & Assembler::ConditionZero) {
+    Assembler::Condition base = PPC32Base(cond);
+    if (base == Assembler::Equal || base == Assembler::NotEqual) {
+      masm.as_cmpw(lhs, rhs);
+      return base;
+    }
+    MOZ_ASSERT(base == Assembler::LessThan ||
+               base == Assembler::GreaterThanOrEqual);
+    masm.as_subf(r0, rhs, lhs);
+    masm.as_cmpwi(r0, 0);
+    return base;
+  }
+  if (c & Assembler::ConditionUnsigned) {
+    masm.as_cmplw(lhs, rhs);
+  } else {
+    masm.as_cmpw(lhs, rhs);
+  }
+  return PPC32Base(cond);
+}
+
+static inline Assembler::Condition PPC32CmpReg(MacroAssembler& masm,
+                                               Assembler::Condition cond,
+                                               Register lhs, Imm32 rhs) {
+  uint32_t c = uint32_t(cond);
+  int32_t v = rhs.value;
+  Assembler::Condition base = PPC32Base(cond);
+  if (c & Assembler::ConditionZero) {
+    if (base == Assembler::LessThan || base == Assembler::GreaterThanOrEqual) {
+      if (v == 0) {
+        masm.as_cmpwi(lhs, 0);
+      } else {
+        PPC32LoadImm(masm, r0, v);
+        masm.as_subf(r0, r0, lhs);
+        masm.as_cmpwi(r0, 0);
+      }
+      return base;
+    }
+    // Zero/NonZero: (in)equality.
+    c = 0;
+  }
+  bool isEq = base == Assembler::Equal || base == Assembler::NotEqual;
+  if (c & Assembler::ConditionUnsigned) {
+    if (PPC32IsUint16(v)) {
+      masm.as_cmplwi(lhs, int16_t(uint16_t(v)));
+      return base;
+    }
+  } else if (PPC32IsInt16(v)) {
+    masm.as_cmpwi(lhs, int16_t(v));
+    return base;
+  } else if (isEq && PPC32IsUint16(v)) {
+    masm.as_cmplwi(lhs, int16_t(uint16_t(v)));
+    return base;
+  }
+  PPC32LoadImm(masm, r0, v);
+  if (c & Assembler::ConditionUnsigned) {
+    masm.as_cmplw(lhs, r0);
+  } else {
+    masm.as_cmpw(lhs, r0);
+  }
+  return base;
+}
+
+static inline Assembler::Condition PPC32CmpReg(MacroAssembler& masm,
+                                               Assembler::Condition cond,
+                                               Register lhs, ImmWord rhs) {
+  return PPC32CmpReg(masm, cond, lhs, Imm32(int32_t(uint32_t(rhs.value))));
+}
+static inline Assembler::Condition PPC32CmpReg(MacroAssembler& masm,
+                                               Assembler::Condition cond,
+                                               Register lhs, ImmPtr rhs) {
+  return PPC32CmpReg(masm, cond, lhs,
+                     Imm32(int32_t(uint32_t(uintptr_t(rhs.value)))));
+}
+static inline Assembler::Condition PPC32CmpReg(MacroAssembler& masm,
+                                               Assembler::Condition cond,
+                                               Register lhs, ImmGCPtr rhs) {
+  // GC pointers need the relocated, patchable load.
+  UseScratchRegisterScope temps(masm);
+  Register s = temps.Acquire();
+  masm.movePtr(rhs, s);
+  return PPC32CmpReg(masm, cond, lhs, s);
+}
+template <typename Mem>
+static inline Assembler::Condition PPC32CmpReg(MacroAssembler& masm,
+                                               Assembler::Condition cond,
+                                               Register lhs, const Mem& rhs) {
+  if constexpr (std::is_convertible_v<const Mem&, Register>) {
+    // Register wrappers (e.g. wasm's RegI32).
+    return PPC32CmpReg(masm, cond, lhs, Register(rhs));
+  } else {
+    static_assert(std::is_same_v<Mem, Address> ||
+                  std::is_same_v<Mem, BaseIndex> ||
+                  std::is_same_v<Mem, AbsoluteAddress>);
+    UseScratchRegisterScope temps(masm);
+    Register s = temps.Acquire();
+    PPC32LoadWord(masm, s, rhs);
+    return PPC32CmpReg(masm, cond, lhs, s);
+  }
+}
+
+template <typename L, typename R>
+static inline Assembler::Condition PPC32Cmp(MacroAssembler& masm,
+                                            Assembler::Condition cond,
+                                            const L& lhs, const R& rhs) {
+  if constexpr (std::is_convertible_v<const L&, Register>) {
+    return PPC32CmpReg(masm, cond, Register(lhs), rhs);
+  } else {
+    UseScratchRegisterScope temps(masm);
+    Register s = temps.Acquire();
+    PPC32LoadWord(masm, s, lhs);
+    return PPC32CmpReg(masm, cond, s, rhs);
+  }
+}
+
+// CR0 = compare(lhs & mask, 0) for Zero/NonZero/Signed/NotSigned tests.
+static inline void PPC32TestImm(MacroAssembler& masm, Register lhs,
+                                Imm32 mask) {
+  uint32_t m = uint32_t(mask.value);
+  uint32_t mb, me;
+  if (PPC32IsUint16(int32_t(m))) {
+    masm.as_andi_rc(r0, lhs, uint16_t(m));
+  } else if ((m & 0xffff) == 0) {
+    masm.as_andis_rc(r0, lhs, uint16_t(m >> 16));
+  } else if (PPC32ContigMask(m, &mb, &me)) {
+    masm.as_rlwinm_rc(r0, lhs, 0, mb, me);
+  } else {
+    PPC32LoadImm(masm, r0, int32_t(m));
+    masm.as_and__rc(r0, lhs, r0);
+  }
+}
+
+// ---------------------------------------------------------------
+// Value tags (NUNBOX32, big-endian: the tag word is at offset 0).
+
+static_assert(NUNBOX32_TYPE_OFFSET == 0 && NUNBOX32_PAYLOAD_OFFSET == 4);
+static_assert(int32_t(JSVAL_TAG_CLEAR) == -128,
+              "NUNBOX32 tags must fit a signed 16-bit compare immediate");
+
+static inline Address PPC32TypeOf(const Address& a) {
+  return Address(a.base, a.offset + NUNBOX32_TYPE_OFFSET);
+}
+static inline BaseIndex PPC32TypeOf(const BaseIndex& a) {
+  return BaseIndex(a.base, a.index, a.scale, a.offset + NUNBOX32_TYPE_OFFSET);
+}
+static inline Address PPC32PayloadOf(const Address& a) {
+  return Address(a.base, a.offset + NUNBOX32_PAYLOAD_OFFSET);
+}
+static inline BaseIndex PPC32PayloadOf(const BaseIndex& a) {
+  return BaseIndex(a.base, a.index, a.scale,
+                   a.offset + NUNBOX32_PAYLOAD_OFFSET);
+}
+
+template <typename T>
+static constexpr bool PPC32IsMem =
+    std::is_same_v<T, Address> || std::is_same_v<T, BaseIndex>;
+
+// Tag register of a Value operand, loading it into |s| for memory operands.
+static inline Register PPC32Tag(MacroAssembler&, Register tag, Register) {
+  return tag;
+}
+static inline Register PPC32Tag(MacroAssembler&, const ValueOperand& v,
+                                Register) {
+  return v.typeReg();
+}
+static inline Register PPC32Tag(MacroAssembler& masm, const Address& a,
+                                Register s) {
+  PPC32LoadWord(masm, s, PPC32TypeOf(a));
+  return s;
+}
+static inline Register PPC32Tag(MacroAssembler& masm, const BaseIndex& a,
+                                Register s) {
+  PPC32LoadWord(masm, s, PPC32TypeOf(a));
+  return s;
+}
+
+// Compare the tag of |t| against |tag| for (in)equality.
+template <typename T>
+static inline Assembler::Condition PPC32TestTag(MacroAssembler& masm,
+                                                Assembler::Condition cond,
+                                                const T& t, JSValueTag tag) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  UseScratchRegisterScope temps(masm);
+  Register s = PPC32IsMem<T> ? temps.Acquire() : InvalidReg;
+  Register r = PPC32Tag(masm, t, s);
+  masm.as_cmpwi(r, int16_t(int32_t(tag)));
+  return cond;
+}
+
+// Unsigned range test of the tag of |t| against |bound|: returns |ifEqual|
+// when cond is Equal and |ifNotEqual| otherwise (both plain CR0 conditions
+// after cmplw).
+template <typename T>
+static inline Assembler::Condition PPC32TestTagRange(
+    MacroAssembler& masm, Assembler::Condition cond, const T& t,
+    JSValueTag bound, Assembler::Condition ifEqual,
+    Assembler::Condition ifNotEqual) {
+  MOZ_ASSERT(cond == Assembler::Equal || cond == Assembler::NotEqual);
+  UseScratchRegisterScope temps(masm);
+  Register s = PPC32IsMem<T> ? temps.Acquire() : InvalidReg;
+  Register r = PPC32Tag(masm, t, s);
+  masm.xs_li(r0, int16_t(int32_t(bound)));
+  masm.as_cmplw(r, r0);
+  return cond == Assembler::Equal ? PPC32Base(ifEqual) : PPC32Base(ifNotEqual);
+}
+
+template <typename T>
+static inline Assembler::Condition PPC32TestDouble(MacroAssembler& masm,
+                                                   Assembler::Condition cond,
+                                                   const T& t) {
+  // Doubles are exactly the values whose high word is below JSVAL_TAG_CLEAR.
+  return PPC32TestTagRange(masm, cond, t, JSVAL_TAG_CLEAR, Assembler::Below,
+                           Assembler::AboveOrEqual);
+}
+template <typename T>
+static inline Assembler::Condition PPC32TestNumber(MacroAssembler& masm,
+                                                   Assembler::Condition cond,
+                                                   const T& t) {
+  return PPC32TestTagRange(masm, cond, t, JS::detail::ValueUpperInclNumberTag,
+                           Assembler::BelowOrEqual, Assembler::Above);
+}
+template <typename T>
+static inline Assembler::Condition PPC32TestPrimitive(MacroAssembler& masm,
+                                                      Assembler::Condition cond,
+                                                      const T& t) {
+  return PPC32TestTagRange(masm, cond, t,
+                           JS::detail::ValueUpperExclPrimitiveTag,
+                           Assembler::Below, Assembler::AboveOrEqual);
+}
+template <typename T>
+static inline Assembler::Condition PPC32TestGCThing(MacroAssembler& masm,
+                                                    Assembler::Condition cond,
+                                                    const T& t) {
+  return PPC32TestTagRange(masm, cond, t, JS::detail::ValueLowerInclGCThingTag,
+                           Assembler::AboveOrEqual, Assembler::Below);
+}
+
+// ---------------------------------------------------------------
+// Operand materialization for templated arithmetic.
+
+static inline Register PPC32OperandReg(MacroAssembler&, Register r, Register) {
+  return r;
+}
+static inline Register PPC32OperandReg(MacroAssembler& masm, Imm32 imm,
+                                       Register t) {
+  PPC32LoadImm(masm, t, imm.value);
+  return t;
+}
+static inline Register PPC32OperandReg(MacroAssembler& masm,
+                                       const Address& addr, Register t) {
+  PPC32LoadWord(masm, t, addr);
+  return t;
+}
+
+// ---------------------------------------------------------------
+// int64 (register pair) helpers.
+
+// Rotate the 64-bit value (h:l) left by the constant |n| into |out|. Any of
+// the registers may alias.
+static inline void PPC32Rotl64Imm(MacroAssembler& masm, uint32_t n,
+                                  Register64 in, Register64 out) {
+  n &= 63;
+  Register h = in.high;
+  Register l = in.low;
+  if (n >= 32) {
+    std::swap(h, l);
+    n -= 32;
+  }
+  UseScratchRegisterScope temps(masm);
+  Register sh = temps.Acquire();
+  Register sl = temps.Acquire();
+  if (n == 0) {
+    masm.xs_mr(sh, h);
+    masm.xs_mr(sl, l);
+  } else {
+    // sh = (h << n) | (l >> (32 - n)); sl = (l << n) | (h >> (32 - n)).
+    masm.as_rlwinm(sh, h, n, 0, 31 - n);
+    masm.as_rlwimi(sh, l, n, 32 - n, 31);
+    masm.as_rlwinm(sl, l, n, 0, 31 - n);
+    masm.as_rlwimi(sl, h, n, 32 - n, 31);
+  }
+  masm.xs_mr(out.high, sh);
+  masm.xs_mr(out.low, sl);
+}
+
+// Rotate |dest| (in place) left by the register amount |count| (mod 64), or
+// right when |right|. |temp| must be distinct from everything else.
+static inline void PPC32Rotl64Reg(MacroAssembler& masm, Register count,
+                                  Register64 dest, Register temp, bool right) {
+  MOZ_ASSERT(temp != InvalidReg);
+  MOZ_ASSERT(temp != dest.high && temp != dest.low && temp != count);
+  MOZ_ASSERT(count != dest.high && count != dest.low);
+  UseScratchRegisterScope temps(masm);
+  Register c = temps.Acquire();
+  Register c32 = temps.Acquire();
+  if (right) {
+    masm.as_neg(c, count);
+    masm.as_rlwinm(c, c, 0, 26, 31);
+  } else {
+    masm.as_rlwinm(c, count, 0, 26, 31);
+  }
+  // Rotating by 32 or more first swaps the halves.
+  masm.as_rlwinm_rc(r0, c, 0, 26, 26);
+  {
+    PPC32SkipIf skip(masm, Assembler::Equal, 3);
+    masm.xs_mr(temp, dest.high);
+    masm.xs_mr(dest.high, dest.low);
+    masm.xs_mr(dest.low, temp);
+  }
+  masm.as_rlwinm(c, c, 0, 27, 31);
+  // A shift by 32 (c == 0) produces zero with srw, as required.
+  masm.as_subfic(c32, c, 32);
+  masm.xs_mr(temp, dest.high);
+  masm.as_slw(dest.high, dest.high, c);
+  masm.as_srw(r0, dest.low, c32);
+  masm.as_or_(dest.high, dest.high, r0);
+  masm.as_slw(dest.low, dest.low, c);
+  masm.as_srw(r0, temp, c32);
+  masm.as_or_(dest.low, dest.low, r0);
+}
+
+// dest.low = number of trailing zeros of |x| (32 when x == 0), via
+// 32 - clz((x - 1) & ~x).
+static inline void PPC32Ctz32(MacroAssembler& masm, Register x, Register dest,
+                              Register tmp) {
+  MOZ_ASSERT(x != r0);
+  masm.as_addi(tmp, x, -1);
+  masm.as_andc(tmp, tmp, x);
+  masm.as_cntlzw(tmp, tmp);
+  masm.as_subfic(dest, tmp, 32);
+}
+
+// output = popcount(input) (SWAR). |tmp| receives intermediate values and
+// |konst| the mask constants; both must differ from input and output.
+static inline void PPC32Popcnt32(MacroAssembler& masm, Register input,
+                                 Register output, Register tmp,
+                                 Register konst) {
+  // x - ((x >> 1) & 0x55555555)
+  PPC32Srwi(masm, tmp, input, 1);
+  PPC32LoadImm(masm, konst, 0x55555555);
+  masm.as_and_(tmp, tmp, konst);
+  masm.as_subf(output, tmp, input);
+  // (x & 0x33333333) + ((x >> 2) & 0x33333333)
+  PPC32Srwi(masm, tmp, output, 2);
+  PPC32LoadImm(masm, konst, 0x33333333);
+  masm.as_and_(tmp, tmp, konst);
+  masm.as_and_(output, output, konst);
+  masm.as_add(output, output, tmp);
+  // (x + (x >> 4)) & 0x0f0f0f0f
+  PPC32Srwi(masm, tmp, output, 4);
+  masm.as_add(output, output, tmp);
+  PPC32LoadImm(masm, konst, 0x0f0f0f0f);
+  masm.as_and_(output, output, konst);
+  // (x * 0x01010101) >> 24
+  PPC32LoadImm(masm, konst, 0x01010101);
+  masm.as_mullw(output, output, konst);
+  PPC32Srwi(masm, output, output, 24);
+}
+
+// Branch on a 64-bit comparison; see ARM's branch64Impl for the scheme.
+static inline auto PPC32Words(Register64 r) {
+  return std::pair{r.high, r.low};
+}
+static inline auto PPC32Words(Imm64 imm) {
+  return std::pair{imm.hi(), imm.low()};
+}
+static inline auto PPC32Words(const Address& a) {
+  return std::pair{HighWord(a), LowWord(a)};
+}
+
+// dest = (lhs cond rhs) ? 1 : 0 for 64-bit operands, via branch64. When
+// |aliased|, dest overlaps an input and is only written after the compare.
+template <typename T1, typename T2>
+static inline void PPC32Cmp64Set(MacroAssembler& masm,
+                                 Assembler::Condition cond, T1 lhs, T2 rhs,
+                                 Register dest, bool aliased) {
+  Label done;
+  if (aliased) {
+    Label success;
+    masm.branch64(cond, lhs, rhs, &success);
+    masm.xs_li(dest, 0);
+    masm.branchToLabel(&done);
+    masm.bind(&success);
+    masm.xs_li(dest, 1);
+  } else {
+    masm.xs_li(dest, 1);
+    masm.branch64(cond, lhs, rhs, &done);
+    masm.xs_li(dest, 0);
+  }
+  masm.bind(&done);
+}
