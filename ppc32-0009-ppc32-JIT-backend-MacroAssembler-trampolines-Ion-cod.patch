+void MacroAssembler::inc64(AbsoluteAddress dest) {
+  UseScratchRegisterScope temps(*this);
+  Register addr = temps.Acquire();
+  Register v = temps.Acquire();
+  PPC32LoadImm(*this, addr, int32_t(uintptr_t(dest.addr)));
+  as_lwz(v, addr, int16_t(INT64LOW_OFFSET));
+  as_addic(v, v, 1);
+  as_stw(v, addr, int16_t(INT64LOW_OFFSET));
+  as_lwz(v, addr, int16_t(INT64HIGH_OFFSET));
+  as_addze(v, v);
+  as_stw(v, addr, int16_t(INT64HIGH_OFFSET));
+}
