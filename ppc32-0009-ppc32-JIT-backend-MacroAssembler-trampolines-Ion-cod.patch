+// ===============================================================
+// Condition functions
+
+// Load an 8/16-bit operand with the extension the condition needs and
+// narrow the immediate to match (unsigned/equality: zero-extend).
+static inline Imm32 PPC32LoadNarrow(MacroAssembler& masm,
+                                    Assembler::Condition cond,
+                                    const Address& lhs, Imm32 rhs,
+                                    Register dest, uint32_t bytes) {
+  bool isSigned;
+  switch (cond) {
+    case Assembler::Equal:
+    case Assembler::NotEqual:
+    case Assembler::Above:
+    case Assembler::AboveOrEqual:
+    case Assembler::Below:
+    case Assembler::BelowOrEqual:
+      isSigned = false;
+      break;
+    case Assembler::GreaterThan:
+    case Assembler::GreaterThanOrEqual:
+    case Assembler::LessThan:
+    case Assembler::LessThanOrEqual:
+      isSigned = true;
+      break;
+    default:
+      MOZ_CRASH("unexpected condition");
+  }
+  if (bytes == 1) {
+    PPC32Access(masm, PPC32Mem::Lbz, dest, lhs);
+    if (isSigned) {
+      masm.as_extsb(dest, dest);
+      return Imm32(int8_t(rhs.value));
+    }
+    return Imm32(uint8_t(rhs.value));
+  }
+  PPC32Access(masm, isSigned ? PPC32Mem::Lha : PPC32Mem::Lhz, dest, lhs);
+  return isSigned ? Imm32(int16_t(rhs.value)) : Imm32(uint16_t(rhs.value));
+}
