+      UseScratchRegisterScope temps(*this);
+      Register scratch = temps.Acquire();
+      movePtr(ImmGCPtr(val.toGCThing()), scratch);
+      store32(scratch, ToPayload(dest));
+    } else {
+      move32(Imm32(val.toNunboxPayload()), r0);
+      store32(r0, ToPayload(dest));
+    }
+  }
+  void storeValue(const Value& val, BaseIndex dest) {
+    UseScratchRegisterScope temps(*this);
+    Register scratch = temps.Acquire();
+    computeEffectiveAddress(dest, scratch);
+    Address addr(scratch, 0);
+    move32(Imm32(val.toNunboxTag()), r0);
+    store32(r0, ToType(addr));
+    if (val.isGCThing()) {
+      Register scratch2 = temps.Acquire();
+      movePtr(ImmGCPtr(val.toGCThing()), scratch2);
+      store32(scratch2, ToPayload(addr));
+    } else {
+      move32(Imm32(val.toNunboxPayload()), r0);
+      store32(r0, ToPayload(addr));
+    }
+  }
