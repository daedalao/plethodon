+// ===============================================================
+// Conversion functions
+//
+// int32 -> double without fcfid: build the double 0x43300000_(x ^ 0x80000000)
+// = 2^52 + 2^31 + x in memory and subtract 0x43300000_80000000 = 2^52 + 2^31.
+// uint32 uses 0x43300000_x - 0x43300000_00000000. Both results are exact.
+
+static void EmitInt32ToDouble(MacroAssemblerPPCCompat& masm, Register src,
+                              FloatRegister dest, bool isUnsigned) {
+  // Temp area: [0..7] converted value, [8..15] magic, [16..23] saved FPR.
+  static constexpr int32_t Size = 32;
+  FloatRegister destD = dest.asDouble();
+  FloatRegister tmp =
+      destD.encoding() != ScratchDoubleReg.encoding() ? ScratchDoubleReg : f1;
+  bool saveTmp = tmp != ScratchDoubleReg;
+
+  masm.as_addi(StackPointer, StackPointer, -Size);
+  if (isUnsigned) {
+    masm.as_stw(src, StackPointer, 4);
+    masm.xs_li(r0, 0);
+  } else {
+    masm.as_xoris(r0, src, 0x8000);
+    masm.as_stw(r0, StackPointer, 4);
+    masm.xs_lis(r0, int16_t(0x8000));
+  }
+  masm.as_stw(r0, StackPointer, 12);
+  masm.xs_lis(r0, 0x4330);
+  masm.as_stw(r0, StackPointer, 0);
+  masm.as_stw(r0, StackPointer, 8);
+  if (saveTmp) {
+    masm.as_stfd(tmp, StackPointer, 16);
+  }
+  masm.as_lfd(destD, StackPointer, 0);
+  masm.as_lfd(tmp, StackPointer, 8);
+  masm.as_fsub(destD, destD, tmp);
+  if (saveTmp) {
+    masm.as_lfd(tmp, StackPointer, 16);
+  }
+  masm.as_addi(StackPointer, StackPointer, Size);
+}
+
+void MacroAssemblerPPCCompat::convertInt32ToDouble(Register src,
+                                                   FloatRegister dest) {
+  EmitInt32ToDouble(*this, src, dest, /* isUnsigned = */ false);
+}
