+  // Conditional branch to label on CR0 (as_bc/condBranchToLabel handle the
+  // XER conditions and the unordered folding of DoubleConditions). Assumes
+  // the compare has been emitted.
+  void ma_b(Condition cond, Label* label) { condBranchToLabel(cond, label); }
+  void ma_b(DoubleCondition cond, Label* label) {
+    condBranchToLabel(cond, label);
+  }
+  void ma_b(Label* label) { branchToLabel(label); }
+
+  // dest = (CR0 satisfies cond) ? 1 : 0.
+  void ma_cmp_set(Register dest, Condition cond) {
+    uint32_t c = uint32_t(cond) & ~uint32_t(ConditionUnsigned | ConditionZero);
+    if (cond == Always) {
+      xs_li(dest, 1);
+      return;
+    }
+    if (!(c & ConditionOnlyXER) && ((c & BranchOptionMask) == BranchOnSet ||
+                                    (c & BranchOptionMask) == BranchOnClear)) {
+      // Branch-free: extract the CR0 bit with mfcr + rlwinm.
+      uint32_t bit = (c >> 4) & 0x3;
+      as_mfcr(dest);
+      as_rlwinm(dest, dest, uint8_t(bit + 1), 31, 31);
+      if ((c & BranchOptionMask) == BranchOnClear) {
+        as_xori(dest, dest, 1);
+      }
+      return;
+    }
+    // li dest,1; b<cond> +8; li dest,0. The displacement is relative to the
+    // bc itself, after any set-up instruction as_bc emits.
+    xs_li(dest, 1);
+    as_bc(int16_t(2 * sizeof(uint32_t)), cond);
+    xs_li(dest, 0);
+  }
+
+  void ma_cmp_set_dbl(Register dest, DoubleCondition cond) {
+    // as_bc folds the unordered bit as needed; branch over the clear.
+    xs_li(dest, 1);
+    as_bc(int16_t(2 * sizeof(uint32_t)), cond);
+    xs_li(dest, 0);
+  }
+
+  // Conditional move: if CR0 satisfies cond, dest = src. (No isel.)
+  void ma_cmp_move(Register dest, Register src, Condition cond) {
+    as_bc(int16_t(2 * sizeof(uint32_t)), InvertCondition(cond));
+    xs_mr(dest, src);
+  }
+
+  // If cond == 0, move src to dst; otherwise dst is unchanged.
+  void moveIfZero(Register dst, Register src, Register cond) {
+    as_cmpwi(cond, 0);
+    as_bc(int16_t(2 * sizeof(uint32_t)), NotEqual);
+    xs_mr(dst, src);
+  }
+
+  void ma_add32TestCarry(Condition cond, Register rd, Register rs, Imm32 imm,
+                         Label* overflow);
+  void ma_addPtrTestCarry(Condition cond, Register rd, Register rs, ImmWord imm,
+                          Label* overflow) {
+    ma_add32TestCarry(cond, rd, rs, Imm32(int32_t(imm.value)), overflow);
+  }
+
+  // Issue the correct 32-bit compare for |cond| into CR0 and return the
+  // condition to hand to ma_b / ma_cmp_set (unsigned conditions use
+  // cmplw[i]; ConditionZero conditions compare lhs against 0). The
+  // |is32bit| argument is accepted for ppc64 source compatibility; every
+  // compare is 32-bit here.
+  Condition ma_cmp(Register lhs, Register rhs, Condition cond,
+                   bool is32bit = true) {
+    Condition base =
+        static_cast<Condition>(cond & ~(ConditionUnsigned | ConditionZero));
+    if ((cond & ConditionZero) != 0) {
+      as_cmpwi(lhs, 0);
+      return base;
+    }
+    if ((cond & ConditionUnsigned) != 0) {
+      as_cmplw(lhs, rhs);
+    } else {
+      as_cmpw(lhs, rhs);
+    }
+    return base;
+  }
+
+  Condition ma_cmp(Register lhs, Imm32 rhs, Condition cond,
+                   bool is32bit = true) {
+    Condition base =
+        static_cast<Condition>(cond & ~(ConditionUnsigned | ConditionZero));
+    if ((cond & ConditionZero) != 0) {
+      as_cmpwi(lhs, 0);
+      return base;
+    }
+    if ((cond & ConditionUnsigned) != 0) {
+      if (is_uintN(uint32_t(rhs.value), 16)) {
+        as_cmplwi(lhs, int16_t(uint16_t(rhs.value)));
+        return base;
+      }
+    } else if (is_intN(rhs.value, 16)) {
+      as_cmpwi(lhs, int16_t(rhs.value));
+      return base;
+    }
+    // Materialize the immediate in r0 (or a pool scratch if lhs is r0).
+    if (lhs != r0) {
+      move32(rhs, r0);
+      return ma_cmp(lhs, r0, cond);
+    }
+    UseScratchRegisterScope temps(*this);
+    Register scratch = temps.Acquire();
+    move32(rhs, scratch);
+    return ma_cmp(lhs, scratch, cond);
+  }
+
+  Condition ma_cmp(Register lhs, ImmWord rhs, Condition cond,
+                   bool is32bit = true) {
+    return ma_cmp(lhs, Imm32(int32_t(uint32_t(rhs.value))), cond);
+  }
+  Condition ma_cmp(Register lhs, ImmPtr rhs, Condition cond,
+                   bool is32bit = true) {
+    return ma_cmp(lhs, ImmWord(uintptr_t(rhs.value)), cond);
+  }
+  Condition ma_cmp(Register lhs, ImmGCPtr rhs, Condition cond,
+                   bool is32bit = true) {
+    UseScratchRegisterScope temps(*this);
+    Register scratch = temps.Acquire();
+    movePtr(rhs, scratch);
+    return ma_cmp(lhs, scratch, cond);
+  }
+  Condition ma_cmp(Register lhs, ImmTag rhs, Condition cond,
+                   bool is32bit = true) {
+    return ma_cmp(lhs, Imm32(rhs.value), cond);
+  }
