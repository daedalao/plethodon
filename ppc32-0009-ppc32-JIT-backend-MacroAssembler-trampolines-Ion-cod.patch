+class MacroAssemblerPPC : public Assembler {
+ protected:
+  MacroAssembler& asMasm();
+  const MacroAssembler& asMasm() const;
+
+ public:
+  // Big-endian NUNBOX32 halves.
+  static Address ToPayload(const Address& base) {
+    return Address(base.base, base.offset + NUNBOX32_PAYLOAD_OFFSET);
+  }
+  static BaseIndex ToPayload(const BaseIndex& base) {
+    return BaseIndex(base.base, base.index, base.scale,
+                     base.offset + NUNBOX32_PAYLOAD_OFFSET);
+  }
+  static Address ToType(const Address& base) {
+    return Address(base.base, base.offset + NUNBOX32_TYPE_OFFSET);
+  }
+  static BaseIndex ToType(const BaseIndex& base) {
+    return BaseIndex(base.base, base.index, base.scale,
+                     base.offset + NUNBOX32_TYPE_OFFSET);
+  }
+};
+
+class MacroAssemblerPPCCompat : public MacroAssemblerPPC {
+ public:
+  using MacroAssemblerPPC::MacroAssemblerPPC;
+
+  MacroAssemblerPPCCompat() {}
+
+  bool buildOOLFakeExitFrame(void* fakeReturnAddr);
+
+  // Old ppc64 name for ToPayload: the int32/boolean/pointer payload word of
+  // a Value in memory.
+  static Address valuePayload(const Address& a) { return ToPayload(a); }
+  static BaseIndex valuePayload(const BaseIndex& a) { return ToPayload(a); }
+
+  // ===============================================================
+  // Large-offset address formation.
+  //
+  // D-form instructions take a signed 16-bit displacement. For larger
+  // offsets, `addis temp, base, ha(offset)` makes the displacement fit.
+  // Returns the (base, disp) pair to use. |temp| must not be r0.
+
+  static int16_t LowDisp(int32_t offset) { return int16_t(offset & 0xffff); }
+  static int16_t HighAdjusted(int32_t offset) {
+    return int16_t((uint32_t(offset) + 0x8000) >> 16);
+  }
+  Register ma_dformBase(Register base, int32_t offset, Register temp) {
+    if (is_intN(offset, 16)) {
+      return base;
+    }
+    MOZ_ASSERT(temp != r0);
+    as_addis(temp, base, HighAdjusted(offset));
+    return temp;
+  }
+  static int16_t ma_dformDisp(int32_t offset) {
+    return is_intN(offset, 16) ? int16_t(offset) : LowDisp(offset);
+  }
+
+  // dest = base + imm (any 32-bit imm). dest may alias base; neither may be
+  // r0 when a 2-instruction sequence is needed.
+  void ma_addImm(Register dest, Register base, int32_t imm) {
+    if (is_intN(imm, 16)) {
+      if (imm == 0) {
+        if (dest != base) {
+          xs_mr(dest, base);
+        }
+        return;
+      }
+      as_addi(dest, base, int16_t(imm));
+      return;
+    }
+    as_addis(dest, base, HighAdjusted(imm));
+    if (LowDisp(imm) != 0) {
+      as_addi(dest, dest, LowDisp(imm));
+    }
+  }
+
+  // ===============================================================
+  // Conversion functions
+
+  void convertBoolToInt32(Register src, Register dest) {
+    as_rlwinm(dest, src, 0, 31, 31);
+  }
+  // int32/uint32 -> double via the 0x43300000 magic-double trick through a
+  // stack temp (see MacroAssembler-ppc.cpp). |src| may be r0.
+  void convertInt32ToDouble(Register src, FloatRegister dest);
+  void convertInt32ToDouble(const Address& src, FloatRegister dest);
+  void convertInt32ToDouble(const BaseIndex& src, FloatRegister dest);
+  void convertUInt32ToDouble(Register src, FloatRegister dest);
+  void convertUInt32ToFloat32(Register src, FloatRegister dest);
+  void convertInt32ToFloat32(Register src, FloatRegister dest);
+  void convertInt32ToFloat32(const Address& src, FloatRegister dest);
+  void convertDoubleToFloat32(FloatRegister src, FloatRegister dest) {
+    as_frsp(dest, src);
+  }
+  void convertFloat32ToDouble(FloatRegister src, FloatRegister dest) {
+    // FPRs hold singles in double format; frsp is the identity on a
+    // single-representable value but quiets an sNaN.
+    as_frsp(dest, src);
+  }
+  void convertDoubleToInt32(FloatRegister src, Register dest, Label* fail,
+                            bool negativeZeroCheck = true);
+  void convertDoubleToPtr(FloatRegister src, Register dest, Label* fail,
+                          bool negativeZeroCheck = true) {
+    convertDoubleToInt32(src, dest, fail, negativeZeroCheck);
+  }
+  void convertFloat32ToInt32(FloatRegister src, Register dest, Label* fail,
+                             bool negativeZeroCheck = true) {
+    // A single in an FPR is an exact double.
+    convertDoubleToInt32(src, dest, fail, negativeZeroCheck);
+  }
+
+  // No FP16 hardware: MacroAssembler::SupportsFloat{32,64}To16() is false,
+  // so these are never reached.
+  void convertDoubleToFloat16(FloatRegister, FloatRegister) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+  void convertFloat16ToDouble(FloatRegister, FloatRegister) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+  void convertFloat32ToFloat16(FloatRegister, FloatRegister) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+  void convertFloat16ToFloat32(FloatRegister, FloatRegister) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+  void convertInt32ToFloat16(Register, FloatRegister) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+  FaultingCodeOffset loadFloat16(const Address&, FloatRegister, Register) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+  FaultingCodeOffset loadFloat16(const BaseIndex&, FloatRegister, Register) {
+    MOZ_CRASH("ppc32: no FP16 hardware");
+  }
+
+  // ===============================================================
+  // GPR <-> FPR transfers (through a stack temp; the G4 has no direct
+  // move between the register files).
+
+  // Reserve / release the PPCStackTempSize-byte transfer area below sp.
+  void reserveStackTemp() { as_addi(StackPointer, StackPointer, -PPCStackTempSize); }
+  void releaseStackTemp() { as_addi(StackPointer, StackPointer, PPCStackTempSize); }
+
+  // dest = raw bits of a double: hi = sign/exponent word, lo = low word.
+  void moveDoubleToGPRPair(FloatRegister src, Register hi, Register lo);
+  void moveGPRPairToDouble(Register hi, Register lo, FloatRegister dest);
+  // Raw single-precision bits (stfs rounds the FPR to single format).
+  void moveFloat32ToGPRBits(FloatRegister src, Register dest);
+  void moveGPRBitsToFloat32(Register src, FloatRegister dest);
+  // dest = high (sign/exponent) word of a double.
+  void moveDoubleHighWordToGPR(FloatRegister src, Register dest);
+  // fctiwz + transfer: dest = trunc(src) saturated to int32 (NaN ->
+  // INT32_MIN). No range/exactness check.
+  void truncDoubleToInt32Raw(FloatRegister src, Register dest);
+  // fctiw + transfer: dest = round-per-FPSCR(src) saturated to int32.
+  void roundDoubleToInt32Raw(FloatRegister src, Register dest);
+
+  // ===============================================================
+  // Effective address computation
+
+  void computeScaledAddress(const BaseIndex& address, Register dest) {
+    MOZ_ASSERT(dest != r0 || address.scale == TimesOne);
+    if (address.scale == TimesOne) {
+      as_add(dest, address.base, address.index);
+    } else if (dest != address.base) {
+      x_slwi(dest, address.index, address.scale);
+      as_add(dest, address.base, dest);
+    } else {
+      // dest == base: shift into r0 (computational use only).
+      x_slwi(r0, address.index, address.scale);
+      as_add(dest, address.base, r0);
+    }
+  }
+
+  void computeEffectiveAddress(const Address& address, Register dest) {
+    ma_addImm(dest, address.base, address.offset);
+  }
+  void computeEffectiveAddress(const BaseIndex& address, Register dest) {
+    computeScaledAddress(address, dest);
+    if (address.offset) {
+      ma_addImm(dest, dest, address.offset);
+    }
+  }
+
+  // ===============================================================
+  // Move instructions
+
+  void mov(Register src, Register dest) { movePtr(src, dest); }
+  void mov(ImmWord imm, Register dest) { movePtr(imm, dest); }
+  void mov(ImmPtr imm, Register dest) {
+    mov(ImmWord(uintptr_t(imm.value)), dest);
+  }
+
+  // Emit a patchable `lis dest,hi; ori dest,dest,lo` (always 2
+  // instructions). Returns the offset of the lis. |dest| must not be r0.
+  BufferOffset emitLoad32Stanza(Register dest, uint32_t value) {
+    return as_load32Patchable(dest, value);
+  }
+
+  void mov(CodeLabel* label, Register dest) {
+    BufferOffset bo = emitLoad32Stanza(dest, LabelBase::INVALID_OFFSET);
+    label->patchAt()->bind(bo.getOffset());
+    label->setLinkMode(CodeLabel::MoveImmediate);
+  }
+  void mov(Register src, Address dest) { storePtr(src, dest); }
+  void mov(Address src, Register dest) { loadPtr(src, dest); }
+
+  void move32(Imm32 imm, Register dest) {
+    if (is_intN(imm.value, 16)) {
+      xs_li(dest, (int16_t)imm.value);
+    } else {
+      xs_lis(dest, (int16_t)((uint32_t)imm.value >> 16));
+      if (imm.value & 0xffff) {
+        as_ori(dest, dest, (uint16_t)imm.value);
+      }
+    }
+  }
+  void move32(Register src, Register dest) {
+    if (src != dest) {
+      xs_mr(dest, src);
+    }
+  }
+
+  void movePtr(Register src, Register dest) {
+    if (src != dest) {
+      xs_mr(dest, src);
+    }
+  }
+  void movePtr(ImmWord imm, Register dest) {
+    move32(Imm32(int32_t(uint32_t(imm.value))), dest);
+  }
+  void movePtr(ImmPtr imm, Register dest) {
+    movePtr(ImmWord(uintptr_t(imm.value)), dest);
+  }
+  void movePtr(wasm::SymbolicAddress imm, Register dest) {
+    BufferOffset bo = emitLoad32Stanza(dest, uint32_t(-1));
+    append(wasm::SymbolicAccess(CodeOffset(bo.getOffset()), imm));
+  }
+  void movePtr(ImmGCPtr imm, Register dest) {
+    // Always the patchable 2-instruction form: the GC updates the pointer
+    // through the data relocation recorded here.
+    BufferOffset bo = emitLoad32Stanza(dest, uint32_t(uintptr_t(imm.value)));
+    writeDataRelocation(bo, imm);
+  }
+  // Absolute runtime address (not patchable).
+  void ma_loadAbsAddr(Register dest, const void* addr) {
+    movePtr(ImmWord(uintptr_t(addr)), dest);
+  }
+
+  void moveFloat32(FloatRegister src, FloatRegister dest) {
+    if (src != dest) {
+      as_fmr(dest, src);
+    }
+  }
+  void moveDouble(FloatRegister src, FloatRegister dest) {
+    if (src != dest) {
+      as_fmr(dest, src);
+    }
+  }
+
+  // ===============================================================
+  // Branch functions
+  //
+  // Label branches use Assembler::branchToLabel / condBranchToLabel: within
+  // one buffer a b/bl always reaches, so there are no long label jumps.
+
+  void branch(JitCode* c) {
+    BufferOffset bo =
+        emitLoad32Stanza(SecondScratchReg, uint32_t(uintptr_t(c->raw())));
+    addPendingJump(bo, ImmPtr(c->raw()), RelocationKind::JITCODE);
+    xs_mtctr(SecondScratchReg);
+    as_bctr();
+  }
+  void branch(const Register reg) {
+    xs_mtctr(reg);
+    as_bctr();
+  }
+
+  void jump(Label* label) { branchToLabel(label); }
+  void jump(Register reg) {
+    xs_mtctr(reg);
+    as_bctr();
+  }
+  void jump(const Address& address) {
+    UseScratchRegisterScope temps(*this);
+    Register scratch = temps.Acquire();
+    loadPtr(address, scratch);
+    xs_mtctr(scratch);
+    as_bctr();
+  }
+  void jump(JitCode* code) { branch(code); }
+  void jump(ImmPtr ptr) {
+    BufferOffset bo =
+        emitLoad32Stanza(SecondScratchReg, uint32_t(uintptr_t(ptr.value)));
+    addPendingJump(bo, ptr, RelocationKind::HARDCODED);
+    xs_mtctr(SecondScratchReg);
+    as_bctr();
+  }
