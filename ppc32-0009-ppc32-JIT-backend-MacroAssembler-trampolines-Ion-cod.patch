+void MacroAssembler::rshift64Arithmetic(Imm32 imm, Register64 dest) {
+  MOZ_ASSERT(0 <= imm.value && imm.value < 64);
+  uint32_t n = uint32_t(imm.value);
+  if (n == 0) {
+    return;
+  }
+  if (n < 32) {
+    // low = (low >> n) | (high << (32 - n)); high >>= n (arithmetic).
+    as_rlwinm(dest.low, dest.low, 32 - n, n, 31);
+    as_rlwimi(dest.low, dest.high, 32 - n, 0, n - 1);
+    as_srawi(dest.high, dest.high, uint8_t(n));
+    return;
+  }
+  as_srawi(dest.low, dest.high, uint8_t(n - 32));
+  as_srawi(dest.high, dest.high, 31);
+}
+
+void MacroAssembler::rshift64Arithmetic(Register unmaskedShift,
+                                        Register64 dest) {
+  // With s = shift & 63:
+  //   low  = (low >> s) | (high << (32 - s)), replaced by high >>a (s - 32)
+  //          when s > 32 (sraw of an amount >= 32 is all sign bits, not 0);
+  //   high = high >>a s.
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  Register t = temps.Acquire();
+  as_rlwinm(s, unmaskedShift, 0, 26, 31);
+  as_subfic(t, s, 32);
+  as_srw(dest.low, dest.low, s);
+  as_slw(r0, dest.high, t);
+  as_or_(dest.low, dest.low, r0);
+  as_addic_rc(t, s, -32);  // CR0: GT iff s > 32
+  as_sraw(r0, dest.high, t);
+  as_sraw(dest.high, dest.high, s);
+  PPC32SkipIf skip(*this, Assembler::LessThanOrEqual, 1);
+  xs_mr(dest.low, r0);
+}
+
+void MacroAssembler::rshift32Arithmetic(Register src, Register dest) {
+  as_rlwinm(r0, src, 0, 27, 31);
+  as_sraw(dest, dest, r0);
+}
