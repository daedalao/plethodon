+// ===============================================================
+
+template <typename T>
+void MacroAssemblerPPCCompat::fallibleUnboxPtrImpl(const T& src, Register dest,
+                                                   JSValueType type,
+                                                   Label* fail) {
+  MacroAssembler& masm = asMasm();
+  JSValueTag tag;
+  switch (type) {
+    case JSVAL_TYPE_OBJECT:
+      tag = JSVAL_TAG_OBJECT;
+      break;
+    case JSVAL_TYPE_STRING:
+      tag = JSVAL_TAG_STRING;
+      break;
+    case JSVAL_TYPE_SYMBOL:
+      tag = JSVAL_TAG_SYMBOL;
+      break;
+    case JSVAL_TYPE_BIGINT:
+      tag = JSVAL_TAG_BIGINT;
+      break;
+    default:
+      MOZ_CRASH("Unexpected type");
+  }
+  masm.condBranchToLabel(
+      PPC32TestTag(masm, Assembler::NotEqual, src, tag), fail);
+  if constexpr (std::is_same_v<T, ValueOperand>) {
+    masm.movePtr(src.payloadReg(), dest);
+  } else {
+    PPC32LoadWord(masm, dest, PPC32PayloadOf(src));
+  }
+}
+
+void MacroAssemblerPPCCompat::incrementInt32Value(const Address& addr) {
+  asMasm().add32(Imm32(1), PPC32PayloadOf(addr));
+}
+
+void MacroAssemblerPPCCompat::retn(Imm32 n) {
+  // The return address is on top of the stack; |n| includes its slot.
+  MacroAssembler& masm = asMasm();
+  as_lwz(r0, StackPointer, 0);
+  PPC32AddImm(masm, StackPointer, StackPointer, n.value);
+  xs_mtlr(r0);
+  as_blr();
+}
