+void MacroAssembler::or32(Imm32 imm, Register src, Register dest) {
+  uint32_t v = uint32_t(imm.value);
+  uint16_t lo = uint16_t(v & 0xffff);
+  uint16_t hi = uint16_t(v >> 16);
+  if (v == 0) {
+    movePtr(src, dest);
+    return;
