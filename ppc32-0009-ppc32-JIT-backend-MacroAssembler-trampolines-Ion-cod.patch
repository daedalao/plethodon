+// ===============================================================
+// int64 / intptr -> floating point.
+//
+// hi * 2^32 and (uint32)lo are both exact doubles, so their sum is
+// correctly rounded.
+
+static void EmitInt64ToDouble(MacroAssembler& masm, Register64 src,
+                              FloatRegister dest, bool isUnsigned) {
+  MOZ_ASSERT(dest.encoding() != ScratchDoubleReg.encoding());
+  if (isUnsigned) {
+    masm.convertUInt32ToDouble(src.high, dest);
+  } else {
+    masm.convertInt32ToDouble(src.high, dest);
+  }
+  masm.loadConstantDouble(4294967296.0, ScratchDoubleReg);
+  masm.as_fmul(dest, dest, ScratchDoubleReg);
+  masm.convertUInt32ToDouble(src.low, ScratchDoubleReg);
+  masm.as_fadd(dest, dest, ScratchDoubleReg);
+}
+
+void MacroAssembler::convertInt64ToDouble(Register64 src, FloatRegister dest) {
+  EmitInt64ToDouble(*this, src, dest, /* isUnsigned = */ false);
+}
+
+bool MacroAssembler::convertUInt64ToDoubleNeedsTemp() { return false; }
+
+void MacroAssembler::convertUInt64ToDouble(Register64 src, FloatRegister dest,
+                                           Register temp) {
+  MOZ_ASSERT(temp == Register::Invalid());
+  EmitInt64ToDouble(*this, src, dest, /* isUnsigned = */ true);
+}
+
+void MacroAssembler::convertIntPtrToDouble(Register src, FloatRegister dest) {
+  convertInt32ToDouble(src, dest);
+}
