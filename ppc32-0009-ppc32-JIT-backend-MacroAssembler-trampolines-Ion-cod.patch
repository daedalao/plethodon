+// ========================================================================
+// Memory access primitives.
+
+template <typename T>
+void MacroAssembler::storeUnboxedValue(const ConstantOrRegister& value,
+                                       MIRType valueType, const T& dest) {
+  MOZ_ASSERT(valueType < MIRType::Value);
+
+  if (valueType == MIRType::Double) {
+    storeDouble(value.reg().typedReg().fpu(), dest);
+    return;
+  }
+
+  storeTypeTag(ImmType(ValueTypeFromMIRType(valueType)), dest);
+
+  if (value.constant()) {
+    storePayload(value.value(), dest);
+  } else {
+    storePayload(value.reg().typedReg().gpr(), dest);
+  }
+}
+
+template void MacroAssembler::storeUnboxedValue(const ConstantOrRegister& value,
+                                                MIRType valueType,
+                                                const Address& dest);
+template void MacroAssembler::storeUnboxedValue(
+    const ConstantOrRegister& value, MIRType valueType,
+    const BaseObjectElementIndex& dest);
+
+// ===============================================================
+// Arithmetic helpers.
+//
+// divw/divwu results are undefined for x/0 and INT32_MIN/-1; callers
+// guarantee a non-zero divisor, and INT32_MIN/-1 is special-cased
+// (quotient INT32_MIN, remainder 0).
+
+static void BranchIfNotMinOverMinusOne(MacroAssembler& masm, Register lhs,
+                                       Register rhs, Label* notMinOverflow) {
+  masm.ma_b(masm.ma_cmp(lhs, Imm32(INT32_MIN), Assembler::NotEqual),
+            notMinOverflow);
+  masm.as_cmpwi(rhs, -1);
+  masm.ma_b(Assembler::NotEqual, notMinOverflow);
+}
+
+void MacroAssembler::flexibleDivMod32(Register lhs, Register rhs,
+                                      Register divOutput, Register remOutput,
+                                      bool isUnsigned, const LiveRegisterSet&) {
+  MOZ_ASSERT(lhs != divOutput && lhs != remOutput, "lhs is preserved");
+  MOZ_ASSERT(rhs != divOutput && rhs != remOutput, "rhs is preserved");
+
+  Label done;
+  if (!isUnsigned) {
+    Label notMinOverflow;
+    BranchIfNotMinOverMinusOne(*this, lhs, rhs, &notMinOverflow);
+    move32(Imm32(INT32_MIN), divOutput);
+    move32(Imm32(0), remOutput);
+    jump(&done);
+    bind(&notMinOverflow);
+  }
+  if (isUnsigned) {
+    as_divwu(divOutput, lhs, rhs);
+  } else {
+    as_divw(divOutput, lhs, rhs);
+  }
+  as_mullw(remOutput, divOutput, rhs);
+  as_subf(remOutput, remOutput, lhs);
+  bind(&done);
+}
+
+void MacroAssembler::flexibleQuotient32(Register lhs, Register rhs,
+                                        Register dest, bool isUnsigned,
+                                        const LiveRegisterSet&) {
+  Label done;
+  if (!isUnsigned) {
+    Label notMinOverflow;
+    BranchIfNotMinOverMinusOne(*this, lhs, rhs, &notMinOverflow);
+    move32(Imm32(INT32_MIN), dest);
+    jump(&done);
+    bind(&notMinOverflow);
+  }
+  if (isUnsigned) {
+    as_divwu(dest, lhs, rhs);
+  } else {
+    as_divw(dest, lhs, rhs);
+  }
+  bind(&done);
+}
+
+void MacroAssembler::flexibleRemainder32(Register lhs, Register rhs,
+                                         Register dest, bool isUnsigned,
+                                         const LiveRegisterSet&) {
+  Label done;
+  if (!isUnsigned) {
+    Label notMinOverflow;
+    BranchIfNotMinOverMinusOne(*this, lhs, rhs, &notMinOverflow);
+    move32(Imm32(0), dest);
+    jump(&done);
+    bind(&notMinOverflow);
+  }
+  // r0 = lhs / rhs; dest = lhs - r0 * rhs. (dest may alias lhs or rhs.)
+  if (isUnsigned) {
+    as_divwu(r0, lhs, rhs);
+  } else {
+    as_divw(r0, lhs, rhs);
+  }
+  as_mullw(r0, r0, rhs);
+  as_subf(dest, r0, lhs);
+  bind(&done);
+}
+
+void MacroAssembler::flexibleQuotientPtr(
+    Register lhs, Register rhs, Register dest, bool isUnsigned,
+    const LiveRegisterSet& volatileLiveRegs) {
+  flexibleQuotient32(lhs, rhs, dest, isUnsigned, volatileLiveRegs);
+}
+
+void MacroAssembler::flexibleRemainderPtr(
+    Register lhs, Register rhs, Register dest, bool isUnsigned,
+    const LiveRegisterSet& volatileLiveRegs) {
+  flexibleRemainder32(lhs, rhs, dest, isUnsigned, volatileLiveRegs);
+}
+
+void MacroAssembler::shiftIndex32AndAdd(Register indexTemp32, int shift,
+                                        Register pointer) {
+  if (IsShiftInScaleRange(shift)) {
+    computeEffectiveAddress(
+        BaseIndex(pointer, indexTemp32, ShiftToScale(shift)), pointer);
+    return;
+  }
+  lshift32(Imm32(shift), indexTemp32);
+  addPtr(indexTemp32, pointer);
+}
+
+// ===============================================================
+// Rounding to int32.
+//
+// The G4 has no fri*/fctid. fctiw converts using the FPSCR rounding mode,
+// so floor/ceil temporarily switch FPSCR[RN] (mtfsfi 7,u: RN=3 toward -inf,
+// RN=2 toward +inf, 0 = the default round-to-nearest-even; XE/NI stay 0).
+// fctiw/fctiwz saturate to INT32_MIN/INT32_MAX (NaN -> INT32_MIN), so, like
+// ARM, results equal to INT32_MIN or INT32_MAX are treated as failures.
+
+enum class FPRound : uint8_t { Nearest = 0, TowardZero = 1, Up = 2, Down = 3 };
+
+static void EmitRoundedToInt32(MacroAssembler& masm, FloatRegister src,
+                               Register dest, FPRound mode) {
+  if (mode == FPRound::TowardZero) {
+    masm.truncDoubleToInt32Raw(src, dest);
+    return;
+  }
+  if (mode != FPRound::Nearest) {
+    masm.as_mtfsfi(7, uint8_t(mode));
+  }
+  masm.roundDoubleToInt32Raw(src, dest);
+  if (mode != FPRound::Nearest) {
+    masm.as_mtfsfi(7, 0);
+  }
+}
+
+static void FailIfSaturated(MacroAssembler& masm, Register dest, Label* fail) {
+  masm.ma_b(masm.ma_cmp(dest, Imm32(INT32_MAX), Assembler::Equal), fail);
+  masm.ma_b(masm.ma_cmp(dest, Imm32(INT32_MIN), Assembler::Equal), fail);
+}
+
+// If dest == 0, fail when |src| has its sign bit set (the result would be -0
+// or, for NaN with sign, is invalid).
+static void FailIfZeroAndNegative(MacroAssembler& masm, FloatRegister src,
+                                  Register dest, Label* fail) {
+  Label notZero;
+  masm.as_cmpwi(dest, 0);
+  masm.ma_b(Assembler::NotEqual, &notZero);
+  masm.moveDoubleHighWordToGPR(src, r0);
+  masm.as_cmpwi(r0, 0);
+  masm.ma_b(Assembler::LessThan, fail);
+  masm.bind(&notZero);
+}
+
+void MacroAssembler::floorDoubleToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  EmitRoundedToInt32(*this, src, dest, FPRound::Down);
+  FailIfSaturated(*this, dest, fail);
+  // floor(x) == 0 only for x in [0, 1) and -0.
+  FailIfZeroAndNegative(*this, src, dest, fail);
+}
+
+void MacroAssembler::floorFloat32ToInt32(FloatRegister src, Register dest,
+                                         Label* fail) {
+  floorDoubleToInt32(src.asDouble(), dest, fail);
+}
+
+void MacroAssembler::ceilDoubleToInt32(FloatRegister src, Register dest,
+                                       Label* fail) {
+  EmitRoundedToInt32(*this, src, dest, FPRound::Up);
+  FailIfSaturated(*this, dest, fail);
+  // ceil(x) == 0 for x in (-1, 0]: negative inputs give -0.
+  FailIfZeroAndNegative(*this, src, dest, fail);
+}
+
+void MacroAssembler::ceilFloat32ToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  ceilDoubleToInt32(src.asDouble(), dest, fail);
+}
+
+void MacroAssembler::truncDoubleToInt32(FloatRegister src, Register dest,
+                                        Label* fail) {
+  EmitRoundedToInt32(*this, src, dest, FPRound::TowardZero);
+  FailIfSaturated(*this, dest, fail);
+  // trunc(x) == 0 for x in (-1, 1): negative inputs give -0.
+  FailIfZeroAndNegative(*this, src, dest, fail);
+}
+
+void MacroAssembler::truncFloat32ToInt32(FloatRegister src, Register dest,
+                                         Label* fail) {
+  truncDoubleToInt32(src.asDouble(), dest, fail);
+}
+
+// Math.round: floor(x + 0.5) with -0 for x in [-0.5, -0]. x + (0.5 - 1ulp)
+// avoids the double rounding of x + 0.5 for x = 0.49999999999999994 while
+// still rounding ties up (the add itself rounds to nearest-even).
+void MacroAssembler::roundDoubleToInt32(FloatRegister src, Register dest,
+                                        FloatRegister temp, Label* fail) {
+  Label performRound;
+
+  // Non-negative inputs (and +-0) round directly.
+  loadConstantDouble(0.0, temp);
+  branchDouble(Assembler::DoubleGreaterThanOrEqual, src, temp, &performRound);
+
+  // Negative inputs in [-0.5, 0) round to -0; NaN also fails here.
+  loadConstantDouble(-0.5, temp);
+  branchDouble(Assembler::DoubleGreaterThanOrEqualOrUnordered, src, temp,
+               fail);
+
+  bind(&performRound);
+  loadConstantDouble(GetBiggestNumberLessThan(0.5), temp);
+  as_fadd(temp, src, temp);
+  EmitRoundedToInt32(*this, temp, dest, FPRound::Down);
+  FailIfSaturated(*this, dest, fail);
+  FailIfZeroAndNegative(*this, src, dest, fail);
+}
+
+void MacroAssembler::roundFloat32ToInt32(FloatRegister src, Register dest,
+                                         FloatRegister temp, Label* fail) {
+  Label performRound;
+
+  loadConstantFloat32(0.0f, temp);
+  branchFloat(Assembler::DoubleGreaterThanOrEqual, src, temp, &performRound);
+
+  loadConstantFloat32(-0.5f, temp);
+  branchFloat(Assembler::DoubleGreaterThanOrEqualOrUnordered, src, temp, fail);
+
+  bind(&performRound);
+  loadConstantFloat32(GetBiggestNumberLessThan(0.5f), temp);
+  as_fadds(temp, src, temp);
+  EmitRoundedToInt32(*this, temp, dest, FPRound::Down);
+  FailIfSaturated(*this, dest, fail);
+  FailIfZeroAndNegative(*this, src, dest, fail);
+}
