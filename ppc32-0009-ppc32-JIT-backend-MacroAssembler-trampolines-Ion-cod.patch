+#ifndef jit_ppc_CodeGenerator_ppc_h
+#define jit_ppc_CodeGenerator_ppc_h
+
+#include <initializer_list>
+
+#include "jit/ppc/Assembler-ppc.h"
+#include "jit/shared/CodeGenerator-shared.h"
+#include "js/ScalarType.h"  // js::Scalar::Type
+
+namespace js {
+namespace jit {
+
+class CodeGeneratorPPC;
+class OutOfLineTableSwitch;
+
+using OutOfLineWasmTruncateCheck =
+    OutOfLineWasmTruncateCheckBase<CodeGeneratorPPC>;
+
+class CodeGeneratorPPC : public CodeGeneratorShared {
+  friend class MoveResolverPPC;
+
+ protected:
+  CodeGeneratorPPC(MIRGenerator* gen, LIRGraph* graph, MacroAssembler* masm,
+                   const wasm::CodeMetadata* wasmCodeMeta);
+
+  NonAssertingLabel deoptLabel_;
+
+  MoveOperand toMoveOperand(LAllocation a) const;
+
+  // Bail out if the given condition holds in CR0 (set by a preceding
+  // compare or recording instruction).
+  void bailoutIfCR0(Assembler::Condition cond, LSnapshot* snapshot);
+  void bailoutFrom(Label* label, LSnapshot* snapshot);
+  void bailout(LSnapshot* snapshot);
+
+  template <typename T1, typename T2>
+  void bailoutCmpPtr(Assembler::Condition c, T1 lhs, T2 rhs,
+                     LSnapshot* snapshot) {
+    Label bail;
+    masm.branchPtr(c, lhs, rhs, &bail);
+    bailoutFrom(&bail, snapshot);
+  }
+  template <typename T1, typename T2>
+  void bailoutCmp32(Assembler::Condition c, T1 lhs, T2 rhs,
+                    LSnapshot* snapshot) {
+    Label bail;
+    masm.branch32(c, lhs, rhs, &bail);
+    bailoutFrom(&bail, snapshot);
+  }
+  template <typename T1, typename T2>
+  void bailoutTest32(Assembler::Condition c, T1 lhs, T2 rhs,
+                     LSnapshot* snapshot) {
+    Label bail;
+    masm.branchTest32(c, lhs, rhs, &bail);
+    bailoutFrom(&bail, snapshot);
+  }
+  void bailoutIfFalseBool(Register reg, LSnapshot* snapshot) {
+    Label bail;
+    masm.branchTest32(Assembler::Zero, reg, Imm32(0xFF), &bail);
+    bailoutFrom(&bail, snapshot);
+  }
+
+  template <class T>
+  void generateUDivModZeroCheck(Register rhs, Register output, Label* done,
+                                LSnapshot* snapshot, T* mir);
+
+  bool generateOutOfLineCode();
+
+  // Compare lhs and rhs (double or float) and branch to |ifTrue| if |cond|
+  // holds, to |ifFalse| otherwise.
+  void emitBranchDouble(Assembler::DoubleCondition cond, FloatRegister lhs,
+                        FloatRegister rhs, MBasicBlock* ifTrue,
+                        MBasicBlock* ifFalse);
+
+  void emitTableSwitchDispatch(MTableSwitch* mir, Register index,
+                               Register base);
+
+  void emitBigIntPtrDiv(LBigIntPtrDiv* ins, Register dividend, Register divisor,
+                        Register output);
+  void emitBigIntPtrMod(LBigIntPtrMod* ins, Register dividend, Register divisor,
+                        Register output);
+
+  void divICommon(MDiv* mir, Register lhs, Register rhs, Register output,
+                  LSnapshot* snapshot, Label& done);
+  void modICommon(MMod* mir, Register lhs, Register rhs, Register output,
+                  LSnapshot* snapshot, Label& done);
+
+  void generateInvalidateEpilogue();
+
+  // Calls one of the BigInt64 atomic helpers: saves the live volatile
+  // registers (except |out| if |hasResult|), passes |args| (32-bit words)
+  // and moves the int64 result into |out| if |hasResult|.
+  void emitAtomic64Call(LInstruction* ins, void* fun,
+                        std::initializer_list<Register> args, Register64 out,
+                        bool hasResult);
+  template <typename T>
+  void computeAtomic64Address(const T& mem, Register dest);
+
+ public:
+  void visitOutOfLineTableSwitch(OutOfLineTableSwitch* ool);
+  void visitOutOfLineWasmTruncateCheck(OutOfLineWasmTruncateCheck* ool);
+};
+
+using CodeGeneratorSpecific = CodeGeneratorPPC;
+
+}  // namespace jit
+}  // namespace js
+
+#endif /* jit_ppc_CodeGenerator_ppc_h */
