+static inline void PPC32MinMax32(MacroAssembler& masm, Register lhs,
+                                 Register rhs, Register dest, bool isMax,
+                                 bool isUnsignedCmp = false) {
+  if (isUnsignedCmp) {
+    masm.as_cmplw(lhs, rhs);
+  } else {
+    masm.as_cmpw(lhs, rhs);
+  }
+  Assembler::Condition lhsWins =
+      isMax ? Assembler::GreaterThan : Assembler::LessThan;
+  if (dest == rhs) {
+    PPC32SkipIf skip(masm, PPC32Invert(lhsWins), 1);
+    masm.xs_mr(dest, lhs);
+  } else {
+    if (dest != lhs) {
+      masm.xs_mr(dest, lhs);
+    }
+    PPC32SkipIf skip(masm, lhsWins, 1);
+    masm.xs_mr(dest, rhs);
+  }
+}
