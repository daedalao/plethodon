+// Spectre mitigations: data-dependent (branch-free) selects on CR0.
+
+void MacroAssembler::spectreMovePtr(Condition cond, Register src,
+                                    Register dest) {
+  // dest = cond ? src : dest == dest ^ ((dest ^ src) & mask).
+  UseScratchRegisterScope temps(*this);
+  Register t = temps.Acquire();
+  PPC32MaskFromCR0(*this, cond, r0);
+  as_xor_(t, dest, src);
+  as_and_(t, t, r0);
+  as_xor_(dest, dest, t);
+}
+
+void MacroAssembler::spectreZeroRegister(Condition cond, Register,
+                                         Register dest) {
+  // dest = cond ? 0 : dest.
+  PPC32MaskFromCR0(*this, PPC32Invert(cond), r0);
+  as_and_(dest, dest, r0);
+}
+
+static inline void PPC32SpectreBoundsCheck(MacroAssembler& masm,
+                                           Register index, Register length,
+                                           Label* failure) {
+  masm.as_cmplw(index, length);
+  masm.condBranchToLabel(Assembler::GreaterThanOrEqual, failure);
+  if (JitOptions.spectreIndexMasking) {
+    // CR0 still holds the compare on the fall-through path:
+    // index = (index < length) ? index : 0.
+    PPC32MaskFromCR0(masm, Assembler::LessThan, r0);
+    masm.as_and_(index, index, r0);
+  }
+}
+
+void MacroAssembler::spectreBoundsCheck32(Register index, Register length,
+                                          Register maybeScratch,
+                                          Label* failure) {
+  MOZ_ASSERT(length != maybeScratch);
+  MOZ_ASSERT(index != maybeScratch);
+  PPC32SpectreBoundsCheck(*this, index, length, failure);
+}
+
+void MacroAssembler::spectreBoundsCheck32(Register index, const Address& length,
+                                          Register maybeScratch,
+                                          Label* failure) {
+  MOZ_ASSERT(index != length.base);
+  MOZ_ASSERT(length.base != maybeScratch);
+  MOZ_ASSERT(index != maybeScratch);
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  PPC32LoadWord(*this, s, length);
+  PPC32SpectreBoundsCheck(*this, index, s, failure);
+}
+
+void MacroAssembler::spectreBoundsCheckPtr(Register index, Register length,
+                                           Register maybeScratch,
+                                           Label* failure) {
+  spectreBoundsCheck32(index, length, maybeScratch, failure);
+}
