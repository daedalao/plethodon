+// ===============================================================
+// Shift functions
+//
+// slw/srw/sraw use six bits of the shift register (amounts 32-63 give 0 or
+// the sign fill); JS semantics want the count mod 32, so register counts are
+// masked to five bits first.
+
+void MacroAssembler::lshiftPtr(Imm32 imm, Register dest) {
+  lshiftPtr(imm, dest, dest);
+}
+
+void MacroAssembler::lshiftPtr(Imm32 imm, Register src, Register dest) {
+  MOZ_ASSERT(0 <= imm.value && imm.value < 32);
+  PPC32Slwi(*this, dest, src, uint32_t(imm.value));
+}
+
+void MacroAssembler::lshiftPtr(Register src, Register dest) {
+  as_rlwinm(r0, src, 0, 27, 31);
+  as_slw(dest, dest, r0);
+}
+
+void MacroAssembler::flexibleLshiftPtr(Register shift, Register srcDest) {
+  lshiftPtr(shift, srcDest);
+}
+
+void MacroAssembler::lshift64(Imm32 imm, Register64 dest) {
+  MOZ_ASSERT(0 <= imm.value && imm.value < 64);
+  uint32_t n = uint32_t(imm.value);
+  if (n == 0) {
+    return;
+  }
+  if (n < 32) {
+    // high = (high << n) | (low >> (32 - n)); low <<= n.
+    as_rlwinm(dest.high, dest.high, n, 0, 31 - n);
+    as_rlwimi(dest.high, dest.low, n, 32 - n, 31);
+    as_rlwinm(dest.low, dest.low, n, 0, 31 - n);
+    return;
+  }
+  PPC32Slwi(*this, dest.high, dest.low, n - 32);
+  xs_li(dest.low, 0);
+}
+
+void MacroAssembler::lshift64(Register unmaskedShift, Register64 dest) {
+  // With s = shift & 63 and six-bit slw/srw amounts (>= 32 gives zero):
+  //   high = (high << s) | (low >> (32 - s)) | (low << (s - 32))
+  //   low  = low << s
+  // For s == 32 both low terms equal low, which is still correct.
+  UseScratchRegisterScope temps(*this);
+  Register s = temps.Acquire();
+  Register t = temps.Acquire();
+  as_rlwinm(s, unmaskedShift, 0, 26, 31);
+  as_subfic(t, s, 32);
+  as_slw(dest.high, dest.high, s);
+  as_srw(r0, dest.low, t);
+  as_or_(dest.high, dest.high, r0);
+  as_addi(t, s, -32);
+  as_slw(r0, dest.low, t);
+  as_or_(dest.high, dest.high, r0);
+  as_slw(dest.low, dest.low, s);
+}
+
+void MacroAssembler::lshift32(Register src, Register dest) {
+  as_rlwinm(r0, src, 0, 27, 31);
+  as_slw(dest, dest, r0);
+}
