+  void push(Imm32 imm) {
+    move32(imm, r0);
+    push(r0);
+  }
+  void push(ImmWord imm) { push(Imm32(int32_t(uint32_t(imm.value)))); }
+  void push(ImmPtr imm) { push(ImmWord(uintptr_t(imm.value))); }
+  void push(ImmGCPtr imm) {
+    UseScratchRegisterScope temps(*this);
