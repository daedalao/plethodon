+// ===============================================================
+// Bit counting functions
+
+void MacroAssembler::clz32(Register src, Register dest, bool knownNotZero) {
+  // cntlzw(0) == 32.
+  as_cntlzw(dest, src);
+}
+
+void MacroAssembler::clz64(Register64 src, Register64 dest) {
+  // clz(high) if high != 0, else 32 + clz(low); branch-free:
+  // r = ch + (cl & -(ch >> 5)).
+  UseScratchRegisterScope temps(*this);
+  Register ch = temps.Acquire();
+  Register cl = temps.Acquire();
+  as_cntlzw(ch, src.high);
+  as_cntlzw(cl, src.low);
+  as_rlwinm(r0, ch, 27, 31, 31);
+  as_neg(r0, r0);
+  as_and_(cl, cl, r0);
+  as_add(dest.low, ch, cl);
+  xs_li(dest.high, 0);
+}
+
+void MacroAssembler::ctz32(Register src, Register dest, bool knownNotZero) {
+  PPC32Ctz32(*this, src, dest, r0);
+}
+
+void MacroAssembler::ctz64(Register64 src, Register64 dest) {
+  // ctz(low) if low != 0, else 32 + ctz(high); branch-free as in clz64.
+  UseScratchRegisterScope temps(*this);
+  Register tl = temps.Acquire();
+  Register th = temps.Acquire();
+  PPC32Ctz32(*this, src.low, tl, r0);
+  PPC32Ctz32(*this, src.high, th, r0);
+  as_rlwinm(r0, tl, 27, 31, 31);
+  as_neg(r0, r0);
+  as_and_(th, th, r0);
+  as_add(dest.low, tl, th);
+  xs_li(dest.high, 0);
+}
+
+void MacroAssembler::popcnt32(Register input, Register output, Register tmp) {
+  UseScratchRegisterScope temps(*this);
+  Register konst = temps.Acquire();
+  if (tmp == InvalidReg) {
+    tmp = r0;
+  }
+  MOZ_ASSERT(tmp != input && tmp != output);
+  PPC32Popcnt32(*this, input, output, tmp, konst);
+}
+
+void MacroAssembler::popcnt64(Register64 src, Register64 dest, Register tmp) {
+  MOZ_ASSERT(dest.low != tmp);
+  MOZ_ASSERT(dest.high != tmp);
+  MOZ_ASSERT(dest.low != dest.high);
+  // The source and destination can overlap: don't clobber src.high before
+  // it has been counted.
+  if (dest.low != src.high) {
+    popcnt32(src.low, dest.low, tmp);
+    popcnt32(src.high, dest.high, tmp);
+  } else {
+    MOZ_ASSERT(dest.high != src.high);
+    popcnt32(src.low, dest.high, tmp);
+    popcnt32(src.high, dest.low, tmp);
+  }
+  as_add(dest.low, dest.low, dest.high);
+  xs_li(dest.high, 0);
+}
