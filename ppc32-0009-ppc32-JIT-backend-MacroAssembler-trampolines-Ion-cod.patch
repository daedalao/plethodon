+  Label done;
+  masm.as_fcmpu(cr0, lhs, rhs);
+  masm.xs_li(dest, 1);
+  PpcBranchCR0(masm, cond, &done);
+  masm.xs_li(dest, 0);
+  masm.bind(&done);
+}
