+// Conditional loads: the load itself is skipped (it must not fault or
+// clobber |dest| when the condition fails).
+static inline void PPC32CondLoad32(MacroAssembler& masm,
+                                   Assembler::Condition c, const Address& src,
+                                   Register dest) {
+  MOZ_ASSERT(dest != r0);
+  PPC32SkipIf skip(masm, PPC32Invert(c), PPC32LoadLength(src));
+  PPC32Access(masm, PPC32Mem::Lwz, dest, src);
+}
