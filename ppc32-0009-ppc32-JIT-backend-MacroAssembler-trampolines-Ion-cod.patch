+// Signed overflow of a 32-bit add/sub: CR0.LT is set iff it overflowed.
+// |dest| receives the wrapped result.
+template <typename T>
+static inline void PPC32AddOverflow(MacroAssembler& masm, T src,
+                                    Register dest) {
+  UseScratchRegisterScope temps(masm);
+  Register res = temps.Acquire();
+  if constexpr (std::is_same_v<T, Imm32>) {
+    PPC32AddImm(masm, res, dest, src.value);
+    // A constant operand's sign is known: overflow iff the result's sign
+    // differs from dest's in the direction of the constant.
+    if (src.value >= 0) {
+      masm.as_andc(r0, res, dest);
+    } else {
+      masm.as_andc(r0, dest, res);
+    }
+    masm.as_cmpwi(r0, 0);
+  } else {
+    Register b = PPC32OperandReg(masm, src, temps.Acquire());
+    masm.as_add(res, dest, b);
+    // ((res ^ a) & (res ^ b)) < 0.
+    masm.as_xor_(r0, res, dest);
+    masm.as_xor_(dest, res, b);
+    masm.as_and__rc(r0, r0, dest);
+  }
+  masm.xs_mr(dest, res);
+}
+
+template <typename T>
+static inline void PPC32SubOverflow(MacroAssembler& masm, T src,
+                                    Register dest) {
+  UseScratchRegisterScope temps(masm);
+  Register res = temps.Acquire();
+  if constexpr (std::is_same_v<T, Imm32>) {
+    PPC32AddImm(masm, res, dest, int32_t(0u - uint32_t(src.value)));
+    if (src.value >= 0) {
+      // Overflow iff dest < 0 and res >= 0.
+      masm.as_andc(r0, dest, res);
+    } else {
+      // Overflow iff dest >= 0 and res < 0.
+      masm.as_andc(r0, res, dest);
+    }
+    masm.as_cmpwi(r0, 0);
+  } else {
+    Register b = PPC32OperandReg(masm, src, temps.Acquire());
+    masm.as_subf(res, b, dest);
+    // ((a ^ b) & (a ^ res)) < 0.
+    masm.as_xor_(r0, dest, b);
+    masm.as_xor_(dest, dest, res);
+    masm.as_and__rc(r0, r0, dest);
+  }
+  masm.xs_mr(dest, res);
+}
+
+template <typename T>
+void MacroAssembler::branchAdd32(Condition cond, T src, Register dest,
+                                 Label* label) {
+  switch (cond) {
+    case Overflow:
+      PPC32AddOverflow(*this, src, dest);
+      condBranchToLabel(Assembler::LessThan, label);
+      break;
+    case CarrySet:
+    case CarryClear: {
+      // Unsigned carry out iff the wrapped sum is below the original dest.
+      UseScratchRegisterScope temps(*this);
+      Register res = temps.Acquire();
+      if constexpr (std::is_same_v<T, Imm32>) {
+        PPC32AddImm(*this, res, dest, src.value);
+      } else {
+        Register b = PPC32OperandReg(*this, src, temps.Acquire());
+        as_add(res, dest, b);
+      }
+      as_cmplw(res, dest);
+      xs_mr(dest, res);
+      condBranchToLabel(cond == CarrySet ? Assembler::LessThan
+                                         : Assembler::GreaterThanOrEqual,
+                        label);
+      break;
+    }
+    case Zero:
+    case NonZero:
+    case Signed:
+    case NotSigned:
+      add32(src, dest);
+      as_cmpwi(dest, 0);
+      condBranchToLabel(PPC32Base(cond), label);
+      break;
+    default:
+      MOZ_CRASH("ppc32: unsupported branchAdd32 condition");
+  }
+}
+
+template <typename T>
+void MacroAssembler::branchSub32(Condition cond, T src, Register dest,
+                                 Label* label) {
+  switch (cond) {
+    case Overflow:
+      PPC32SubOverflow(*this, src, dest);
+      condBranchToLabel(Assembler::LessThan, label);
+      break;
+    case Zero:
+    case NonZero:
+    case Signed:
+    case NotSigned:
+      sub32(src, dest);
+      as_cmpwi(dest, 0);
+      condBranchToLabel(PPC32Base(cond), label);
+      break;
+    default:
+      MOZ_CRASH("ppc32: unsupported branchSub32 condition");
+  }
+}
+
+template <typename T>
+void MacroAssembler::branchMul32(Condition cond, T src, Register dest,
+                                 Label* label) {
+  MOZ_ASSERT(cond == Assembler::Overflow);
+  // The 64-bit product fits in int32 iff its high word is the sign
+  // extension of its low word.
+  UseScratchRegisterScope temps(*this);
+  Register lo = temps.Acquire();
+  Register b = PPC32OperandReg(*this, src, temps.Acquire());
+  as_mullw(lo, dest, b);
+  as_mulhw(r0, dest, b);
+  as_srawi(dest, lo, 31);
+  as_cmpw(r0, dest);
+  xs_mr(dest, lo);
+  condBranchToLabel(Assembler::NotEqual, label);
+}
+
+template <typename T>
+void MacroAssembler::branchRshift32(Condition cond, T src, Register dest,
+                                    Label* label) {
+  MOZ_ASSERT(cond == Zero || cond == NonZero);
+  rshift32(src, dest);
+  branch32(cond == Zero ? Equal : NotEqual, dest, Imm32(0), label);
+}
+
+void MacroAssembler::branchNeg32(Condition cond, Register reg, Label* label) {
+  MOZ_ASSERT(cond == Overflow);
+  // Negation overflows only for INT32_MIN, which it leaves unchanged.
+  as_neg(reg, reg);
+  xs_lis(r0, int16_t(-32768));
+  as_cmpw(reg, r0);
+  condBranchToLabel(Assembler::Equal, label);
+}
+
+void MacroAssembler::branchAdd64(Condition cond, Imm64 imm, Register64 dest,
+                                 Label* label) {
+  int32_t hi = imm.hi().value;
+  switch (cond) {
+    case Overflow: {
+      // Signed overflow is decided by the high-word add (with carry in), as
+      // in PPC32AddOverflow for a constant operand.
+      UseScratchRegisterScope temps(*this);
+      Register oldHigh = temps.Acquire();
+      xs_mr(oldHigh, dest.high);
+      add64(imm, dest);
+      if (hi >= 0) {
+        as_andc(r0, dest.high, oldHigh);
+      } else {
+        as_andc(r0, oldHigh, dest.high);
+      }
+      as_cmpwi(r0, 0);
+      condBranchToLabel(Assembler::LessThan, label);
+      break;
+    }
+    case CarrySet:
+    case CarryClear: {
+      // XER[CA] after the adde/addze/addme of add64 is the 64-bit carry out.
+      add64(imm, dest);
+      xs_li(r0, 0);
+      as_addze(r0, r0);
+      as_cmpwi(r0, 0);
+      condBranchToLabel(
+          cond == CarrySet ? Assembler::NotEqual : Assembler::Equal, label);
+      break;
+    }
+    case Signed:
+    case NotSigned:
+      add64(imm, dest);
+      as_cmpwi(dest.high, 0);
+      condBranchToLabel(PPC32Base(cond), label);
+      break;
+    case Zero:
+    case NonZero:
+      add64(imm, dest);
+      as_or_(r0, dest.low, dest.high);
+      as_cmpwi(r0, 0);
+      condBranchToLabel(PPC32Base(cond), label);
+      break;
+    default:
+      MOZ_CRASH("ppc32: unsupported branchAdd64 condition");
+  }
+}
