+    loadPtr(address, r0);
+    push(r0);
+  }
+  void push(Register reg) { as_stwu(reg, StackPointer, -4); }
+  void push(FloatRegister reg) {
+    // FPR pushes always use an 8-byte double slot.
+    as_stfdu(reg.asDouble(), StackPointer, -8);
+  }
+  void pop(Register reg) {
+    as_lwz(reg, StackPointer, 0);
+    as_addi(StackPointer, StackPointer, 4);
+  }
+  void pop(FloatRegister reg) {
+    as_lfd(reg.asDouble(), StackPointer, 0);
+    as_addi(StackPointer, StackPointer, 8);
+  }
