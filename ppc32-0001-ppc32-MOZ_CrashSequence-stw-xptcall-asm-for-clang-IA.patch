+#[cfg(target_os = "aix")]
+#[cfg(not(portable_atomic_pre_llvm_20))] // SIGTRAP on LLVM 19
+#[cfg(any(test, portable_atomic_outline_atomics))] // TODO(aix): currently disabled by default
+#[path = "../detect/powerpc64_aix.rs"]
+mod detect;
