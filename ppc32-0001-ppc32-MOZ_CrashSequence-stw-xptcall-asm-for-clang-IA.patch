index 4acc16afde..2a48259e0e 100644
--- a/build/rust/portable-atomic/Cargo.toml
+++ b/build/rust/portable-atomic/Cargo.toml
@@ -1,11 +1,25 @@
+# Real portable-atomic 1.15.0 (was an empty stub): ppc32 has no 64-bit
+# atomics, and wgpu-core/wgpu-hal use portable_atomic::AtomicU64 there.
+# Version kept at 1.999.0 so the Cargo.lock patch entry still matches.
 [package]
 name = "portable-atomic"
 version = "1.999.0"
 edition = "2018"
-license = "MPL-2.0"
+license = "Apache-2.0 OR MIT"
+build = "build.rs"
 
 [lib]
-path = "lib.rs"
+path = "src/lib.rs"
 
 [features]
+default = ["fallback"]
+disable-fiq = []
+fallback = []
+float = []
+force-amo = []
+require-cas = []
+s-mode = []
+std = []
+unsafe-assume-privileged = []
+unsafe-assume-single-core = []
 critical-section = []
