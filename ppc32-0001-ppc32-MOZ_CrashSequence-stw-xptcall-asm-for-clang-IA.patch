+            any(target_feature = "cmpxchg16b", portable_atomic_target_feature = "cmpxchg16b"),
+        ),
+        all(
+            target_arch = "riscv64",
+            any(target_feature = "zacas", portable_atomic_target_feature = "zacas"),
+        ),
+        all(
