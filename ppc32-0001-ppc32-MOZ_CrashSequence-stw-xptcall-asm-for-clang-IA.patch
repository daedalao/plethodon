+                                concat!("st", $release, "xp {r:w}, {new_lo}, {new_hi}, [{dst}]"), // atomic { if EXCLUSIVE == dst { *dst = new_lo:new_hi; r = 0 } else { r = 1 }; EXCLUSIVE = None }
