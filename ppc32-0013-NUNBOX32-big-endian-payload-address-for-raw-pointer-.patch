diff --git a/js/src/jit/shared/Assembler-shared.h b/js/src/jit/shared/Assembler-shared.h
index fef8fdf804..a0ca8b6f86 100644
--- a/js/src/jit/shared/Assembler-shared.h
+++ b/js/src/jit/shared/Assembler-shared.h
@@ -319,6 +319,18 @@ struct Address {
 
 #if JS_BITS_PER_WORD == 32
 
+// The address of the word holding the payload of a Value slot: a raw
+// pointer or int32 stored as a PrivateValue/Int32Value. On NUNBOX32 the
+// payload is at NUNBOX32_PAYLOAD_OFFSET (4 on big-endian), on PUNBOX64 the
+// private pointer is the whole word.
+static inline Address ValuePayloadAddress(const Address& address) {
+#ifdef JS_NUNBOX32
+  return Address(address.base, address.offset + NUNBOX32_PAYLOAD_OFFSET);
+#else
+  return address;
+#endif
+}
+
 static inline Address LowWord(const Address& address) {
   using mozilla::CheckedInt;
 
diff --git a/js/src/jit/shared/AtomicOperations-feeling-lucky-gcc.h b/js/src/jit/shared/AtomicOperations-feeling-lucky-gcc.h
index d886cba2c7..cc242e52c8 100644
--- a/js/src/jit/shared/AtomicOperations-feeling-lucky-gcc.h
+++ b/js/src/jit/shared/AtomicOperations-feeling-lucky-gcc.h
@@ -59,6 +59,12 @@
 #  define HAS_64BIT_ATOMICS
 #endif
 
+// 32-bit PowerPC has no 64-bit atomic instructions; the __atomic builtins go
+// through libatomic (not lock-free, but correct within the process).
+#if defined(__powerpc__) && !defined(__powerpc64__)
+#  define HAS_64BIT_ATOMICS
+#endif
+
 #if defined(__ppc64__) || defined(__PPC64__) || defined(__ppc64le__) || \
     defined(__PPC64LE__)
 #  define HAS_64BIT_ATOMICS
