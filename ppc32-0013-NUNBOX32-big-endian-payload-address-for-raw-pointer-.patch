 js/src/jit/ProcessExecutableMemory.cpp        |  6 ++++++
 js/src/jit/shared/Assembler-shared.h          | 12 ++++++++++++
 .../AtomicOperations-feeling-lucky-gcc.h      |  6 ++++++
 7 files changed, 54 insertions(+), 13 deletions(-)

diff --git a/js/src/jit/BaselineCacheIRCompiler.cpp b/js/src/jit/BaselineCacheIRCompiler.cpp
index 09705c61f8..5d6de015e5 100644
--- a/js/src/jit/BaselineCacheIRCompiler.cpp
+++ b/js/src/jit/BaselineCacheIRCompiler.cpp
@@ -3006,7 +3006,8 @@ bool BaselineCacheIRCompiler::emitCallNativeShared(
       } else {
         // This depends on the native function pointer being stored unchanged as
         // a PrivateValue.
-        masm.callWithABI(Address(calleeReg, JSFunction::offsetOfNativeOrEnv()));
+        masm.callWithABI(ValuePayloadAddress(
+            Address(calleeReg, JSFunction::offsetOfNativeOrEnv())));
       }
 #endif
     } break;
