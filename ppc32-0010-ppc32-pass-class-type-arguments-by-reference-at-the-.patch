From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: daedalao <daedalao@hotmail.com>
Date: Sat, 26 Sep 2026 17:54:56 -0700
Subject: [PATCH 10/19] ppc32: pass class-type arguments by reference at the
 JIT->C++ boundary (VM wrapper cells, raw-arg ABI thunks, DOM handle cells);
 compile-time check

---
 js/src/jit/ABIFunctionList-inl.h  | 42 +++++++++++++++
 js/src/jit/CacheIRCompiler.cpp    | 27 +++++++++-
 js/src/jit/CodeGenerator.cpp      | 50 +++++++++++++++++-
 js/src/jit/IonCacheIRCompiler.cpp |  7 +++
 js/src/jit/JitFrames.h            |  3 +-
 js/src/jit/MacroAssembler-inl.h   |  2 +
 js/src/jit/VMFunctions.cpp        | 50 +++++++++++++++++-
 js/src/jit/VMFunctions.h          | 22 ++++++++
 js/src/jit/ppc/Trampoline-ppc.cpp | 85 +++++++++++++++++++++++++++++--
 9 files changed, 280 insertions(+), 8 deletions(-)

diff --git a/js/src/jit/ABIFunctionList-inl.h b/js/src/jit/ABIFunctionList-inl.h
index 0bcd7bb001..174fdb1b3f 100644
--- a/js/src/jit/ABIFunctionList-inl.h
+++ b/js/src/jit/ABIFunctionList-inl.h
@@ -170,6 +170,12 @@ namespace jit {
   _(js::jit::LazyLinkTopActivation)                                            \
   _(js::jit::LinearizeForCharAccessPure)                                       \
   _(js::jit::ObjectHasGetterSetterPure)                                        \
+  _(js::jit::ObjectHasGetterSetterPureRawId)                                   \
+  _(js::jit::GetNativeDataPropertyPureRawId)                                   \
+  _(js::jit::GetNativeDataPropertyPureWithCacheLookupRawId)                    \
+  _(js::jit::TypeOfEqObjectRaw)                                                \
+  _(js::jit::AssertPropertyLookupRawId)                                        \
+  _(js::jit::ProxyGetPropertyRaw)                                              \
   _(js::jit::ObjectIsCallable)                                                 \
   _(js::jit::ObjectIsConstructor)                                              \
   _(js::jit::PostGlobalWriteBarrier)                                           \
@@ -254,6 +260,42 @@ namespace jit {
 #  pragma GCC diagnostic ignored "-Wignored-attributes"
 #endif
 
+#ifdef JS_CODEGEN_PPC
+// The SysV PPC32 ABI passes and returns every class type by reference (even
+// one-pointer classes like JS::Handle), while JIT code passes such values in
+// registers like on other platforms. List the signatures that need care.
+template <typename Sig>
+struct PPC32ClassFreeSignature {
+  static constexpr bool value = true;
+};
+template <typename R, typename... Args>
+struct PPC32ClassFreeSignature<R (*)(Args...)> {
+  static constexpr bool value =
+      !std::is_class_v<R> && !(std::is_class_v<Args> || ...);
+};
+// The DOM ops take JS::Handle and JSJit*CallArgs by value; their JIT call
+// sites (CodeGenerator visit{Get,Set}DOMProperty, visitCallDOMNative) pass
+// the addresses of stack cells holding them instead.
+template <>
+struct PPC32ClassFreeSignature<JSJitGetterOp> {
+  static constexpr bool value = true;
+};
+template <>
+struct PPC32ClassFreeSignature<JSJitSetterOp> {
+  static constexpr bool value = true;
+};
+template <>
+struct PPC32ClassFreeSignature<JSJitMethodOp> {
+  static constexpr bool value = true;
+};
+#  define PPC32_CHECK_SIG(...)                                  \
+    static_assert(PPC32ClassFreeSignature<__VA_ARGS__>::value, \
+                  "ppc32: ABI call with a class-type argument/result "  \
+                  "(passed by reference in SysV); use a raw variant");
+#else
+#  define PPC32_CHECK_SIG(...)
+#endif
+
 #define DEF_TEMPLATE(fp)                      \
   template <>                                 \
   struct ABIFunctionData<decltype(&fp), fp> { \
