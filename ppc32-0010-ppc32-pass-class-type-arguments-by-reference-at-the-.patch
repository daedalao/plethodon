   if (ins->mir()->isInfallible()) {
     masm.loadValue(Address(masm.getStackPointer(),
@@ -20399,6 +20429,15 @@ void CodeGenerator::visitSetDOMProperty(LSetDOMProperty* ins) {
 
   markSafepointAt(safepointOffset, ins);
 
+#ifdef JS_CODEGEN_PPC
