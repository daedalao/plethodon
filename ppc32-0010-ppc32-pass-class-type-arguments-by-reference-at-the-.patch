@@ -9989,7 +10003,13 @@ bool CacheIRCompiler::emitGuardHasGetterSetter(ObjOperandId objId,
   emitLoadStubField(id, scratch2);
   masm.passABIArg(scratch2);
   masm.passABIArg(scratch3.get().scratchReg());
+#ifdef JS_CODEGEN_PPC
+  using FnRaw = bool (*)(JSContext* cx, JSObject* obj, uintptr_t id,
+                         GetterSetter* getterSetter);
+  masm.callWithABI<FnRaw, ObjectHasGetterSetterPureRawId>();
+#else
   masm.callWithABI<Fn, ObjectHasGetterSetterPure>();
+#endif
   masm.storeCallPointerResult(scratch1);
   masm.PopRegsInMask(volatileRegs);
 
@@ -12058,8 +12078,13 @@ bool CacheIRCompiler::emitAssertPropertyLookup(ObjOperandId objId,
   masm.passABIArg(obj);
   masm.passABIArg(id);
   masm.passABIArg(slot);
+#ifdef JS_CODEGEN_PPC
+  using Fn = void (*)(NativeObject*, uintptr_t, uint32_t);
+  masm.callWithABI<Fn, js::jit::AssertPropertyLookupRawId>();
+#else
   using Fn = void (*)(NativeObject*, PropertyKey, uint32_t);
   masm.callWithABI<Fn, js::jit::AssertPropertyLookup>();
