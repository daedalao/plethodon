diff --git a/js/src/jit/ppc/Trampoline-ppc.cpp b/js/src/jit/ppc/Trampoline-ppc.cpp
index 91b32f6324..04a80b0e68 100644
--- a/js/src/jit/ppc/Trampoline-ppc.cpp
+++ b/js/src/jit/ppc/Trampoline-ppc.cpp
@@ -393,13 +393,91 @@ bool JitRuntime::generateVMWrapper(JSContext* cx, MacroAssembler& masm,
   // Reserve space for the outparameter.
   masm.reserveVMFunctionOutParamSpace(f);
 
+  const int32_t outParamOffset =
+      -int32_t(ExitFooterFrame::Size()) - f.sizeOfOutParamStackSlot();
+
+  // The SysV PPC32 ABI passes class-type arguments by reference. A handle
+  // (JS::Handle, JS::MutableHandle) is a class holding the address of the
+  // rooted slot, so give each one a stack cell holding that address and pass
+  // the cell's address. Class-type arguments passed by value (PropertyKey,
+  // ...) already sit in their slot: pass the slot's address.
+  auto needsCell = [&f](uint32_t explicitArg) {
+    VMFunctionData::ArgProperties props = f.argProperties(explicitArg);
+    return f.argPassedAsClass(explicitArg) &&
+           (props == VMFunctionData::WordByRef ||
+            props == VMFunctionData::DoubleByRef);
+  };
+  uint32_t numCells = f.outParam == Type_Handle ? 1 : 0;
+  for (uint32_t explicitArg = 0; explicitArg < f.explicitArgs; explicitArg++) {
+    if (needsCell(explicitArg)) {
+      numCells++;
+    }
+  }
+  const uint32_t cellBytes =
+      AlignBytes(numCells * sizeof(void*), ABIStackAlignment);
+  const int32_t cellsBase = outParamOffset - int32_t(cellBytes);
+  if (numCells) {
+    masm.reserveStack(cellBytes);
+    Register scratch = regs.getAny();
+    uint32_t cell = 0;
+    size_t disp = ExitFrameLayout::Size();
+    for (uint32_t explicitArg = 0; explicitArg < f.explicitArgs;
+         explicitArg++) {
+      VMFunctionData::ArgProperties props = f.argProperties(explicitArg);
+      if (needsCell(explicitArg)) {
+        masm.computeEffectiveAddress(Address(FramePointer, disp), scratch);
+        masm.storePtr(scratch,
+                      Address(FramePointer, cellsBase + cell * sizeof(void*)));
+        cell++;
+      }
+      disp += (props == VMFunctionData::WordByValue ||
+               props == VMFunctionData::WordByRef)
+                  ? sizeof(void*)
+                  : props == VMFunctionData::DoubleByValue ? sizeof(double)
+                                                           : 2 * sizeof(void*);
+    }
+    if (f.outParam == Type_Handle) {
+      masm.computeEffectiveAddress(Address(FramePointer, outParamOffset),
+                                   scratch);
+      masm.storePtr(scratch,
+                    Address(FramePointer, cellsBase + cell * sizeof(void*)));
+      cell++;
+    }
+    MOZ_ASSERT(cell == numCells);
+  }
+
   masm.setupUnalignedABICallDontSaveRestoreSP();
   masm.passABIArg(cxreg);
 
   size_t argDisp = ExitFrameLayout::Size();
+  uint32_t nextCell = 0;
+  auto passCell = [&]() {
+    masm.passABIArg(
+        MoveOperand(FramePointer, cellsBase + nextCell * sizeof(void*),
+                    MoveOperand::Kind::EffectiveAddress),
+        ABIType::General);
+    nextCell++;
+  };
 
   // Copy any arguments.
   for (uint32_t explicitArg = 0; explicitArg < f.explicitArgs; explicitArg++) {
+    if (needsCell(explicitArg)) {
+      passCell();
+      argDisp += f.argProperties(explicitArg) == VMFunctionData::WordByRef
+                     ? sizeof(void*)
+                     : 2 * sizeof(void*);
+      continue;
+    }
+    if (f.argPassedAsClass(explicitArg)) {
+      // A class passed by value: its bytes are in the slot.
