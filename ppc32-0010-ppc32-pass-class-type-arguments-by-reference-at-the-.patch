@@ -22274,7 +22316,13 @@ void CodeGenerator::visitGuardHasGetterSetter(LGuardHasGetterSetter* lir) {
   masm.passABIArg(object);
   masm.passABIArg(temp1);
   masm.passABIArg(temp2);
+#ifdef JS_CODEGEN_PPC
