-#ifdef JS_CODEGEN_X86
+#if defined(JS_CODEGEN_PPC)
+  {
+    using FnRaw = bool (*)(JSContext* cx, JSObject* obj, uintptr_t id,
+                           MegamorphicCacheEntry* cacheEntry, Value* vp);
+    masm.callWithABI<FnRaw, GetNativeDataPropertyPureRawId>();
+  }
+#elif defined(JS_CODEGEN_X86)
   masm.callWithABI<Fn, GetNativeDataPropertyPureWithCacheLookup>();
 #else
