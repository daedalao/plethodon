@@ -149,6 +149,11 @@ struct TypeToPassInFloatReg<double> {
 };
 
 // Convert argument types to root types used by the gc, see TraceJitExitFrame.
+template <class T>
+struct TypeToPassAsClass {
+  static const uint32_t result = std::is_class_v<T> ? 1 : 0;
+};
+
 template <class T>
