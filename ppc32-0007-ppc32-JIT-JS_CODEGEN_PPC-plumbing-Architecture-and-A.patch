+// --- Branches to labels ---
+//
+// Unbound-label chain encoding in the LI field of b/bl (bits 2..25):
+//   bits 2..24: previous use offset + 4 (0 = end of chain)
+//   bit 25:     this `b` is the second half of a `bc !cond, +8; b` pair
+static const uint32_t kChainCondPair = 0x02000000;
+static const uint32_t kChainOffsetMask = 0x01FFFFFC;
+
+static uint32_t ChainField(const Label* label) {
+  if (!label->used()) {
+    return 0;
+  }
+  uint32_t prev = uint32_t(label->offset()) + 4;
+  MOZ_RELEASE_ASSERT((prev & ~kChainOffsetMask) == 0);
+  return prev;
+}
+
+void Assembler::branchToLabel(Label* label, LinkBit lb) {
+  if (label->bound()) {
+    int32_t offset = label->offset() - currentOffset();
+    MOZ_RELEASE_ASSERT(JOffImm26::IsInRange(offset));
+    as_b(offset, RelativeBranch, lb);
+    return;
+  }
+  spew("b%s\t<label>", lb ? "l" : "");
+  BufferOffset bo = writeInst(PPC_b | ChainField(label) | lb);
+  if (!oom()) {
+    label->use(bo.getOffset());
+  }
+}
+
+template <typename CondT>
+static void CondBranchToLabel(Assembler& masm, CondT cond, Label* label,
+                              CRegisterID cr) {
+  if (label->bound()) {
+    // Any CR preparation (cror/mcrxr) comes before the bc; the displacement
+    // is relative to the bc itself.
+    masm.enterNoPool(4);
+    uint16_t bobi = masm.computeConditionCode(cond, cr);
+    int32_t offset = label->offset() - int32_t(masm.currentOffset());
+    if (BOffImm16::IsInRange(offset)) {
+      masm.as_bc(int16_t(offset), bobi);
+    } else {
+      // Inverted short bc over an unconditional b.
+      masm.as_bc(int16_t(8), bobi ^ Assembler::BranchOptionInvert);
+      offset = label->offset() - int32_t(masm.currentOffset());
+      MOZ_RELEASE_ASSERT(JOffImm26::IsInRange(offset));
+      masm.as_b(offset);
+    }
+    masm.leaveNoPool();
+    return;
+  }
+  masm.enterNoPool(4);
+  uint16_t bobi = masm.computeConditionCode(cond, cr);
+  masm.as_bc(int16_t(8), bobi ^ Assembler::BranchOptionInvert);
+  masm.spew("b\t<label> (cond pair)");
+  BufferOffset bo =
+      masm.writeInst(PPC_b | ChainField(label) | kChainCondPair);
+  masm.leaveNoPool();
+  if (!masm.oom()) {
+    label->use(bo.getOffset());
+  }
+}
+
+void Assembler::condBranchToLabel(Condition cond, Label* label,
+                                  CRegisterID cr) {
+  if (cond == Always) {
+    branchToLabel(label);
+    return;
+  }
+  CondBranchToLabel(*this, cond, label, cr);
+}
+
+void Assembler::condBranchToLabel(DoubleCondition cond, Label* label,
+                                  CRegisterID cr) {
+  CondBranchToLabel(*this, cond, label, cr);
+}
+
+// `b` is the second instruction of `bc !cond, +8; b label`. Collapse the
+// pair to `bc cond, target; nop` if the target is within bc range.
+void Assembler::bindCondPair(Instruction* b, intptr_t branch, intptr_t target) {
+  Instruction* bc = b - 1;
+  MOZ_ASSERT(bc->isOpcode(PPC_bc));
+  MOZ_ASSERT((bc->encode() & 0xFFFC) == 8);
+  intptr_t bcOffset = target - (branch - 4);
+  if (BOffImm16::IsInRange(int32_t(bcOffset))) {
+    bc->setData(((bc->encode() ^ (uint32_t(BranchOptionInvert) << 21)) &
+                 0xFFFF0003) |
+                BOffImm16(int32_t(bcOffset)).encode());
+    b->makeNop();
+    return;
+  }
+  b->setData(PPC_b | JOffImm26(int32_t(target - branch)).encode());
+}
+
+// --- FP constants ---
+
+void Assembler::loadFPConstant(uint64_t bits, bool isFloat32,
+                               FloatRegister dest) {
+  uint32_t index = fpConstants_.length();
+  for (uint32_t i = 0; i < fpConstants_.length(); i++) {
+    if (fpConstants_[i].bits == bits &&
+        fpConstants_[i].isFloat32 == isFloat32) {
+      index = i;
+      break;
+    }
+  }
+  if (index == fpConstants_.length()) {
+    enoughMemory_ &= fpConstants_.append(FPConstant{bits, isFloat32, {}});
+  }
+  m_buffer.enterNoPool(2);
+  // Placeholders; the real address is patched in processCodeLabels().
+  BufferOffset bo = as_addis(SecondScratchReg, r0, 0, true);
+  if (isFloat32) {
+    as_lfs(dest, SecondScratchReg, 0);
+  } else {
+    as_lfd(dest, SecondScratchReg, 0);
+  }
+  m_buffer.leaveNoPool();
+  enoughMemory_ &= fpConstantUses_.append(FPConstantUse{bo, index});
+}
+
+void Assembler::loadConstantDouble(double d, FloatRegister dest) {
+  loadFPConstant(mozilla::BitwiseCast<uint64_t>(d), false, dest);
+}
+
+void Assembler::loadConstantFloat32(float f, FloatRegister dest) {
+  loadFPConstant(mozilla::BitwiseCast<uint32_t>(f), true, dest);
+}
