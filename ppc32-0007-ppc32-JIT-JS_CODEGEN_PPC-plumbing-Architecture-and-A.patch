+BOffImm16::BOffImm16(InstImm inst) : data(inst.extractImm16Value() & 0xFFFC) {
+  // Sign-extend the 16-bit field.
+  if (data & 0x8000) {
+    data |= ~0xFFFF;
+  }
+}
