+
+BufferOffset Assembler::xs_trap_tagged(TrapTag tag) {
+  uint32_t tv = PPC_trap | ((uint8_t)tag << 16) | ((uint8_t)tag << 11);
+  spew("trap @ %08x ; MARK %d %08x", currentOffset(), (uint8_t)tag, tv);
+  return writeInst(tv);
+}
