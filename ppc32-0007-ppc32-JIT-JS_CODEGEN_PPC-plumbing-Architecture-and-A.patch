+// --- Patchable 32-bit immediates ---
+
+BufferOffset Assembler::as_load32Patchable(Register rd, uint32_t value) {
+  MOZ_ASSERT(rd != r0);
+  m_buffer.enterNoPool(2);
+  spew("lis\t%s,0x%x ; ori (patchable 0x%08x)", rd.name(), value >> 16, value);
+  BufferOffset bo = writeInst(PPC_addis | uint32_t(rd.code()) << 21 |
+                              (value >> 16));
+  writeInst(PPC_ori | uint32_t(rd.code()) << 21 | uint32_t(rd.code()) << 16 |
+            (value & 0xffff));
+  m_buffer.leaveNoPool();
+  return bo;
+}
+
+/* static */
+void Assembler::WriteLoad32Instructions(Instruction* inst0, Register reg,
+                                        uint32_t value) {
+  MOZ_ASSERT(reg != r0);
+  inst0[0].setData(PPC_addis | uint32_t(reg.code()) << 21 | (value >> 16));
+  inst0[1].setData(PPC_ori | uint32_t(reg.code()) << 21 |
+                   uint32_t(reg.code()) << 16 | (value & 0xffff));
+}
+
+/* static */
+uint32_t Assembler::ExtractLoad32Value(Instruction* inst0) {
+  MOZ_ASSERT(inst0[0].isOpcode(PPC_addis));
+  MOZ_ASSERT(inst0[1].isOpcode(PPC_ori));
+  return (inst0[0].encode() & 0xffff) << 16 | (inst0[1].encode() & 0xffff);
+}
+
+/* static */
+void Assembler::UpdateLoad32Value(Instruction* inst0, uint32_t value) {
+  MOZ_ASSERT(inst0[0].isOpcode(PPC_addis));
+  MOZ_ASSERT(inst0[1].isOpcode(PPC_ori));
+  inst0[0].setData((inst0[0].encode() & 0xffff0000) | (value >> 16));
+  inst0[1].setData((inst0[1].encode() & 0xffff0000) | (value & 0xffff));
+}
