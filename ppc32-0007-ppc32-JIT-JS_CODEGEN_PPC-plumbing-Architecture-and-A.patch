+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef jit_ppc_Architecture_ppc_h
+#define jit_ppc_Architecture_ppc_h
+
+#include <algorithm>
+#include <bit>
+
+#include "jit/shared/Architecture-shared.h"
+
+#include "js/Utility.h"
