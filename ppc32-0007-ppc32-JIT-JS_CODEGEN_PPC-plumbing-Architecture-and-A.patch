+// Buffer management.
+bool Assembler::oom() const {
+  return AssemblerShared::oom() || m_buffer.oom() || jumpRelocations_.oom() ||
+         dataRelocations_.oom();
+}
+
+void Assembler::finish() {
+  MOZ_ASSERT(!isFinished);
+  m_buffer.flushPool();
+  if (!fpConstants_.empty()) {
+    // 8-byte align, then the constants (big-endian words).
+    while (currentOffset() & 7) {
+      writeInst(0);
+    }
+    for (FPConstant& c : fpConstants_) {
+      if (c.isFloat32) {
+        c.data = writeInst(uint32_t(c.bits));
+        writeInst(0);
+      } else {
+        c.data = writeInst(uint32_t(c.bits >> 32));
+        writeInst(uint32_t(c.bits));
+      }
+    }
+  }
+  isFinished = true;
+}
