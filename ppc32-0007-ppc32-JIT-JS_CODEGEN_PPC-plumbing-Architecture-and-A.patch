+  // Which absolute bit number does a CR + Condition pair refer to?
+  static uint8_t crBit(CRegisterID cr, Condition cond) {
+    return (cr << 2) + ((cond & 0xf0) >> 4);
+  }
+  static uint8_t crBit(CRegisterID cr, DoubleCondition cond) {
