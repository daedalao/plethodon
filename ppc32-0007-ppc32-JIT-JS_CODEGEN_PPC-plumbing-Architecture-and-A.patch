+// InstImm helper.
+uint8_t InstImm::traptag() {
+  uint8_t r = ((data & 0x001f0000) >> 16);
+  MOZ_ASSERT(isOpcode(PPC_tw));
+  MOZ_ASSERT(r == ((data & 0x0000f800) >> 11));
+  return r & 0xfe;
+}
